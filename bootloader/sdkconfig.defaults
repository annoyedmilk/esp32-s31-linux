CONFIG_IDF_TARGET="esp32s31"
CONFIG_FREERTOS_UNICORE=y
CONFIG_ESP_SYSTEM_SINGLE_CORE_MODE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MEMMAP=y
# The test writes all 16 MiB and takes 330 ms of each boot.
# CONFIG_SPIRAM_MEMTEST is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# NVS is off, so the PHY calibration data cannot be kept.  Request a full
# calibration at each boot, and do not fail the NVS lookup.
# CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE is not set
# GPIO33/34 are LCD data pins and also the USB Serial/JTAG D-/D+ pins.  The
# loader does not start the display when a secondary console uses them.
# This selects the display.  For JTAG and no display, set
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y.
# Flash and the Linux console use the CP2102N bridge in the two cases.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# The ESP-Hosted firmware runs the radio for Linux (components/esp_hosted).
# Its frames are the frames of the USB transport, but they go through shared
# memory.  Only Wi-Fi: no Bluetooth and no IEEE 802.15.4.
CONFIG_ESP_USB_HOST_INTERFACE=y
# CONFIG_BT_ENABLED is not set
# CONFIG_ESP_HOSTED_RCP is not set
# The supplicant runs on Linux.  Nothing writes the flash after Linux starts.
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_SAE_PK is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_SOFTAP is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
