CONFIG_IDF_TARGET="esp32s31"
CONFIG_FREERTOS_UNICORE=y
CONFIG_ESP_SYSTEM_SINGLE_CORE_MODE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MEMMAP=y
# The test writes all 16 MiB and takes 330 ms of each boot.
# CONFIG_SPIRAM_MEMTEST is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# NVS is off, so the PHY calibration data cannot be kept.  Request a full
# calibration at each boot, and do not fail the NVS lookup.
# CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE is not set
# The ESP-Hosted firmware runs the radios for Linux (components/esp_hosted):
# Wi-Fi and a dual-mode Bluetooth controller with HCI in RAM.  Its frames are
# the frames of the USB transport, but they go through shared memory.  The
# software coexistence arbiter shares the RF.
CONFIG_ESP_USB_HOST_INTERFACE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CTRL_HCI_INTERFACE_USE_RAM=y
# The buffer pools of the S31 config of ESP-Hosted, smaller than the
# ESP-IDF defaults.
CONFIG_BT_LE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_LE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_LE_ACL_BUF_COUNT=8
CONFIG_BT_LE_HCI_EVT_HI_BUF_COUNT=16
CONFIG_BT_LE_HCI_EVT_LO_BUF_COUNT=4
# The ESP-Hosted default for the ESP32-S31 adds the IEEE 802.15.4 RCP.
# CONFIG_ESP_HOSTED_RCP is not set
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# The supplicant runs on Linux, so Wi-Fi keeps nothing in NVS.
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_SAE_PK is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_SOFTAP is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# 32 dynamic buffers in each direction, as before Bluetooth and the RCP.
# With the RCP, the heap fell to 15 KiB during iperf3 with 32 buffers.  The
# RCP took 23 KiB of code and 26 KiB of heap.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
# The cache stays on during a program or erase, and Linux runs on from
# PSRAM (shm_flash.c needs it).  The flash of the module (XMC, 0x46) has
# suspend and resume.
CONFIG_SPI_FLASH_AUTO_SUSPEND=y
