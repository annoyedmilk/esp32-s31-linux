From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Michael.B" <xiaoxufeng@espressif.com>
Date: Wed, 21 Oct 2026 22:29:16 +0800
Subject: [PATCH] fix(esp32s31): temporarily disable MSPI TX underflow
 interrupt

The PSRAM MSPI TX_TRANS_UDF interrupt may be reported falsely on
ESP32-S31 and abort the system. Leave it out of the enabled event
mask until the hardware behavior is confirmed.

Upstream: ec8ce190c17 (master)
---
 .../esp_hal_mspi/esp32s31/include/hal/psram_ctrlr_ll.h       | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/components/esp_hal_mspi/esp32s31/include/hal/psram_ctrlr_ll.h b/components/esp_hal_mspi/esp32s31/include/hal/psram_ctrlr_ll.h
index 0602272852a..cf8391b0f80 100644
--- a/components/esp_hal_mspi/esp32s31/include/hal/psram_ctrlr_ll.h
+++ b/components/esp_hal_mspi/esp32s31/include/hal/psram_ctrlr_ll.h
@@ -52,9 +52,10 @@ extern "C" {
 #define PSRAM_CTRLR_LL_EVENT_AXI_WADDR_ERR       (1<<9)
 #define PSRAM_CTRLR_LL_EVENT_RX_TRANS_OVF        (1<<26)
 #define PSRAM_CTRLR_LL_EVENT_TX_TRANS_UDF        (1<<27)
+// TX underflow (TX_TRANS_UDF) may currently be a false alarm on ESP32-S31.
+// Keep this interrupt disabled until the hardware behavior is confirmed.
 #define PSRAM_CTRLR_LL_EVENT_MASK                (PSRAM_CTRLR_LL_EVENT_ECC_ERR | PSRAM_CTRLR_LL_EVENT_PMS_REJECT | PSRAM_CTRLR_LL_EVENT_AXI_RADDR_ERR | \
-                                                 PSRAM_CTRLR_LL_EVENT_AXI_WR_FLASH_ERR | PSRAM_CTRLR_LL_EVENT_AXI_WADDR_ERR | PSRAM_CTRLR_LL_EVENT_RX_TRANS_OVF | \
-                                                 PSRAM_CTRLR_LL_EVENT_TX_TRANS_UDF)
+                                                 PSRAM_CTRLR_LL_EVENT_AXI_WR_FLASH_ERR | PSRAM_CTRLR_LL_EVENT_AXI_WADDR_ERR | PSRAM_CTRLR_LL_EVENT_RX_TRANS_OVF)
 
 #define PSRAM_CTRLR_LL_INTR_EVENT_SUPPORTED      1
 #define PSRAM_CTRLR_LL_DEDICATED_LDO             1
