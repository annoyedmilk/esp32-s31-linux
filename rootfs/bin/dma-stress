#!/bin/sh
# Stress the ESP32-S31 non-coherent DMA path: the dw_mmc IDMAC ring and the
# cache controller's sync engine underneath it.  Every phase either compares a
# hash across a cache drop or re-reads a known-good file, because a missed
# invalidate returns stale data rather than an error.  The dwc2 DMA path has no
# block device to exercise while USB mass storage stays disabled.
#
# Writes and then removes /mnt/sd/dma-stress.tmp; nothing else on the card is
# touched.  Run with no argument for four rounds, or pass a literal round list,
# e.g. "dma-stress 1 2 3 4 5 6 7 8" (this BusyBox has no seq and no $((..))).

rounds="$*"
test -n "$rounds" || rounds="1 2 3 4"
fails=""

fail() {
	echo "  FAIL $1"
	fails="$fails."
}

drop_caches() {
	sync
	echo 3 > /proc/sys/vm/drop_caches
}

# First word of a sha256sum line, without needing cut.
hash_of() {
	set -- $(sha256sum "$1")
	echo "$1"
}

hash_of_stdin() {
	set -- $(sha256sum)
	echo "$1"
}

# A stale cache line shows up as a hash that changes once the page cache is
# emptied and the block has to come off the card again.
hash_twice() {
	first=$(hash_of "$1")
	drop_caches
	second=$(hash_of "$1")
	if [ "$first" != "$second" ]; then
		fail "$2: $1 changed across drop_caches ($first != $second)"
	else
		echo "  ok   $2: $first"
	fi
}

echo "=== boot-time DMA configuration ==="
dmesg | grep -E "esp32s31-cache|internal DMA|slave mode|coherent area"
if dmesg | grep -q "DMA alignment 64"; then
	echo "  ok   kmalloc keeps 64-byte DMA alignment"
else
	fail "kmalloc DMA alignment is below the 64-byte cache line"
fi

echo
echo "=== phase 1: SD reference file, read path only ==="
if [ -f /mnt/sd/s31-pattern.txt ]; then
	for round in $rounds; do
		hash_twice /mnt/sd/s31-pattern.txt "sd-read round $round"
	done
else
	echo "  skip /mnt/sd/s31-pattern.txt not present"
fi

echo
echo "=== phase 2: SD write/read cycles, 1 MiB per round ==="
if mountpoint -q /mnt/sd; then
	for round in $rounds; do
		if dd if=/dev/urandom of=/mnt/sd/dma-stress.tmp bs=64k count=16 2>/dev/null; then
			hash_twice /mnt/sd/dma-stress.tmp "sd-write round $round"
		else
			fail "sd-write round $round: dd failed"
		fi
	done
	rm -f /mnt/sd/dma-stress.tmp
	sync
else
	echo "  skip /mnt/sd is not mounted"
fi

echo
echo "=== phase 3: unaligned and odd transfer sizes ==="
# Odd block sizes walk buffers that are neither cache-line sized nor aligned,
# and the raw device skips the filesystem read-ahead that would hide a stale
# line behind an already-correct neighbour.
if [ -b /dev/mmcblk0 ]; then
	for bs in 97 512 1023 4093; do
		drop_caches
		a=$(dd if=/dev/mmcblk0 bs=$bs count=64 2>/dev/null | hash_of_stdin)
		drop_caches
		b=$(dd if=/dev/mmcblk0 bs=$bs count=64 2>/dev/null | hash_of_stdin)
		if [ "$a" != "$b" ]; then
			fail "raw-read bs=$bs: $a != $b"
		else
			echo "  ok   raw-read bs=$bs: $a"
		fi
	done
else
	echo "  skip /dev/mmcblk0 not present"
fi

echo
echo "=== phase 4: mount/umount cycles ==="
# Remounting re-runs the SCR, CMD6 and FSINFO reads.  Those use short kmalloc'd
# buffers, the ones that would share a cache line without the alignment fix.
if mountpoint -q /mnt/sd; then
	set -- $(grep " /mnt/sd " /proc/mounts)
	sd_dev="$1"
	for round in $rounds; do
		umount /mnt/sd || fail "umount round $round"
		drop_caches
		if mount "$sd_dev" /mnt/sd; then
			echo "  ok   remount round $round ($sd_dev)"
		else
			fail "mount round $round ($sd_dev)"
		fi
	done
	if dmesg | grep -q "Invalid FSINFO signature"; then
		fail "FAT read a stale FSINFO block"
	fi
else
	echo "  skip /mnt/sd is not mounted"
fi

echo
echo "=== driver errors reported since boot ==="
dmesg | grep -iE "sync timeout|error|fail|stale|timed out" || echo "  none"

echo
echo "=== interrupts ==="
cat /proc/interrupts
free

echo
if [ -z "$fails" ]; then
	echo "dma-stress: PASS"
else
	echo "dma-stress: FAILED, ${#fails} check(s)"
fi
