#!/bin/sh

mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /proc /run /sys /tmp
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true

sd=""
for _ in 1 2 3; do
	if [ -b /dev/mmcblk0p1 ]; then
		sd=/dev/mmcblk0p1
		break
	fi
	if [ -b /dev/mmcblk0 ]; then
		sd=/dev/mmcblk0
		break
	fi
	sleep 1
done
if [ -n "$sd" ]; then
	mkdir -p /mnt/sd
	if mount "$sd" /mnt/sd 2>/dev/null; then
		echo "SD: mounted $sd on /mnt/sd"
	else
		echo "SD: $sd present but mount failed"
	fi
fi

# A second shell on the frame-buffer console, so a USB keyboard drives the
# panel.  The kernel's VT layer already feeds key events from every input
# device to the foreground VT; userspace does not route /dev/input at all.
# cttyhack must not be used here: it ignores the redirection below and reopens
# whatever /sys/class/tty/console/active names last, which is the serial port,
# leaving nothing reading the panel.  setsid -c takes tty1 as the controlling
# terminal instead, which is what makes Ctrl-C work there.
if [ -c /dev/tty1 ]; then
	(
		while true; do
			/bin/setsid -c /bin/sh -i \
				</dev/tty1 >/dev/tty1 2>&1
			sleep 1
		done
	) &
	echo "VT: shell on /dev/tty1 (frame buffer console)"
fi

echo
echo "=== ESP32-S31 Linux / BusyBox ==="
echo "Console: ttyS0"
echo "Wi-Fi:   wifi <ssid> [passphrase]   then: ping 8.8.8.8"

# PID 1 must never exit: reset-time line glitches can feed the shell a stray
# ^D (EOF), and an exiting init panics the kernel.  Respawn the shell instead.
# Each shell needs its own session so cttyhack can make ttyS0 its controlling
# terminal; the child of this PID 1 supervisor is not a session leader.
while true; do
	/bin/setsid /bin/cttyhack /bin/sh -i
	rc=$?
	echo "init: shell exited rc=$rc, respawning"
	sleep 1
done
