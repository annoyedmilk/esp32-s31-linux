# Buildroot does not build on macOS.  arm64 Debian runs natively on Apple
# silicon, so there is no emulation.  The slim image has the essential
# tools: bash, sed, tar, gzip, diffutils, findutils, which.
FROM debian:trixie-slim

# The other Buildroot host packages, dosfstools and mtools for genimage, and
# python3 for post-image.sh.  The recommended packages and the apt lists
# only cost space.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive \
    apt-get install -y --no-install-recommends \
        bc build-essential bzip2 ca-certificates cpio dosfstools file git \
        libncurses-dev mtools patch perl python3 rsync unzip wget xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV LC_ALL=C LANG=C
