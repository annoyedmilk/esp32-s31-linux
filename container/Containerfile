# Buildroot cannot build on macOS.  arm64 Debian runs natively here, so
# nothing in this path is emulated.
FROM debian:bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        bc binutils build-essential bzip2 ca-certificates cpio diffutils \
        dosfstools file findutils git gzip libncurses-dev locales make \
        mtools patch perl python3 rsync sed tar unzip wget which xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV LC_ALL=C LANG=C
