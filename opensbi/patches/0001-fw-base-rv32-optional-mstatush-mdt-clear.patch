From: Marco Müller <hello@annoyedmilk.ch>
Subject: [PATCH] fw_base: make the mstatush MDT clear optional

The ESP32-S31 has no mstatush.  FW_NO_MSTATUSH removes the write.
---
diff --git a/firmware/fw_base.S b/firmware/fw_base.S
--- a/firmware/fw_base.S
+++ b/firmware/fw_base.S
@@ -33,8 +33,10 @@
 
 .macro CLEAR_MDT tmp
 #if __riscv_xlen == 32
+#ifndef FW_NO_MSTATUSH
 	li 	\tmp, MSTATUSH_MDT
 	csrc	CSR_MSTATUSH, \tmp
+#endif
 #else
 	li 	\tmp, MSTATUS_MDT
 	csrc	CSR_MSTATUS, \tmp
