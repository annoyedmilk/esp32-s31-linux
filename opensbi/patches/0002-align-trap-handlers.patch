From: Marco Müller <hello@annoyedmilk.ch>
Subject: [PATCH] firmware: align the trap handlers to 64 bytes

In CLIC mode, the mtvec BASE field is 64-byte aligned.  This also holds
for _start_hang, the mtvec of the early boot.

Upstream: not sent
---
diff --git a/firmware/fw_base.S b/firmware/fw_base.S
--- a/firmware/fw_base.S
+++ b/firmware/fw_base.S
@@ -422,7 +422,7 @@
 	ret
 
 	.section .entry, "ax", %progbits
-	.align 3
+	.align 6
 	.globl _start_hang
 _start_hang:
 	wfi
@@ -735,7 +735,7 @@
 .endm
 
 	.section .entry, "ax", %progbits
-	.align 3
+	.align 6
 	.globl _trap_handler
 _trap_handler:
 	TRAP_SAVE_AND_SETUP_SP_T0
@@ -757,7 +757,7 @@
 	mret
 
 	.section .entry, "ax", %progbits
-	.align 3
+	.align 6
 	.globl _trap_handler_hyp
 _trap_handler_hyp:
 	TRAP_SAVE_AND_SETUP_SP_T0
diff --git a/lib/sbi/sbi_expected_trap.S b/lib/sbi/sbi_expected_trap.S
--- a/lib/sbi/sbi_expected_trap.S
+++ b/lib/sbi/sbi_expected_trap.S
@@ -19,7 +19,7 @@
 	 * A4 <- temporary
 	 */
 
-	.align 3
+	.align 6
 	.global __sbi_expected_trap
 __sbi_expected_trap:
 	/* Without H-extension so, MTVAL2 and MTINST CSRs and GVA not available */
@@ -37,7 +37,7 @@ __sbi_expected_trap:
 	csrw	CSR_MEPC, a4
 	mret
 
-	.align 3
+	.align 6
 	.global __sbi_expected_trap_hext
 __sbi_expected_trap_hext:
 	/* With H-extension so, MTVAL2 and MTINST CSRs and GVA available */
