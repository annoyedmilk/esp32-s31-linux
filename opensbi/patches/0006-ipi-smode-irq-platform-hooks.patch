diff --git a/include/sbi/sbi_ipi.h b/include/sbi/sbi_ipi.h
--- a/include/sbi/sbi_ipi.h
+++ b/include/sbi/sbi_ipi.h
@@ -80,6 +80,16 @@ int sbi_ipi_event_create(const struct sbi_ipi_event_ops *ops);
 
 void sbi_ipi_event_destroy(u32 event);
 
+/**
+ * Platform hook to assert the S-mode software interrupt on the current HART.
+ * The default (weak) implementation sets MIP.SSIP; CLIC-only platforms can
+ * override it with their supervisor software-interrupt pending bit.
+ */
+void sbi_ipi_plat_sirq_set(void);
+
+/** Platform hook to clear the S-mode software interrupt (default MIP.SSIP). */
+void sbi_ipi_plat_sirq_clear(void);
+
 int sbi_ipi_send_smode(ulong hmask, ulong hbase);
 
 void sbi_ipi_clear_smode(void);
diff --git a/lib/sbi/sbi_ipi.c b/lib/sbi/sbi_ipi.c
--- a/lib/sbi/sbi_ipi.c
+++ b/lib/sbi/sbi_ipi.c
@@ -199,9 +199,19 @@ void sbi_ipi_event_destroy(u32 event)
 	ipi_ops_array[event] = NULL;
 }
 
+void __attribute__((weak)) sbi_ipi_plat_sirq_set(void)
+{
+	csr_set(CSR_MIP, MIP_SSIP);
+}
+
+void __attribute__((weak)) sbi_ipi_plat_sirq_clear(void)
+{
+	csr_clear(CSR_MIP, MIP_SSIP);
+}
+
 static void sbi_ipi_process_smode(struct sbi_scratch *scratch)
 {
-	csr_set(CSR_MIP, MIP_SSIP);
+	sbi_ipi_plat_sirq_set();
 }
 
 static struct sbi_ipi_event_ops ipi_smode_ops = {
@@ -215,7 +225,7 @@ int sbi_ipi_send_smode(ulong hmask, ulong hbase)
 
 void sbi_ipi_clear_smode(void)
 {
-	csr_clear(CSR_MIP, MIP_SSIP);
+	sbi_ipi_plat_sirq_clear();
 }
 
 static int sbi_ipi_update_halt(struct sbi_scratch *scratch,
