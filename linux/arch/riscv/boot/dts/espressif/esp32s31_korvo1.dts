// SPDX-License-Identifier: GPL-2.0+
/*
 * ESP32-S31-Korvo-1: 800x480 RGB panel, microSD slot, USB 2.0 host port
 * and a WS2812 RGB LED.
 * Author: Marco Müller <hello@annoyedmilk.ch>
 */
/dts-v1/;
#include "esp32s31.dtsi"

/ {
	model = "Espressif ESP32-S31-Korvo-1";
	compatible = "esp,esp32s31-korvo-1", "esp,esp32s31";

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * The loader DMA reads this buffer also after the handoff.
		 * OpenSBI makes this range uncached with two PMA entries, so
		 * it goes to the end of PSRAM.
		 */
		fb_region: framebuffer@50f40000 {
			reg = <0x50f40000 0xc0000>;
			no-map;
		};
	};

	chosen {
		linux,initrd-start = <0x50800000>;
		linux,initrd-end = <0x50C00000>;
		stdout-path = "serial0:115200n8";

		/*
		 * The loader starts the 800x480 RGB panel of the Korvo-1.  The
		 * LCD_CAM DMA then reads an RGB565 buffer at the top of PSRAM,
		 * so Linux only describes it.  fb_region reserves the memory.
		 * of_platform makes this device for a simple-framebuffer under
		 * /chosen.  If the loader gives GPIO33/34 to USB Serial/JTAG,
		 * it does not start the display: fb0 exists but shows nothing.
		 */
		framebuffer {
			compatible = "simple-framebuffer";
			width = <800>;
			height = <480>;
			stride = <(800 * 2)>;
			format = "r5g6b5";
			memory-region = <&fb_region>;
		};
	};
};

&sdmmc0 { status = "okay"; };

/* The Type-A port: host only, with a TPS2051C switch for VBUS. */
&usb_phy { status = "okay"; };

&usb0 {
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

/* WS2812 RGB LED on GPIO37. */
&rgb_led { status = "okay"; };
