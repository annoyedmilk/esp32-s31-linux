// SPDX-License-Identifier: GPL-2.0+
/*
 * Espressif ESP32-S31 minimal Device Tree Source.
 * Author: Marco Müller <hello@annoyedmilk.ch>
 */

#include <dt-bindings/interrupt-controller/irq.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "espressif,esp32s31";

	memory@50000000 {
		device_type = "memory";
		/* 16MB RAM */
		reg = <0x50000000 0x01000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * The loader's LCD frame buffer, which its DMA keeps scanning
		 * out after the handoff.  800 * 480 * 2 = 0xbb800 bytes,
		 * rounded up to a page so the whole buffer is covered.
		 */
		fb_region: framebuffer@50f40000 {
			reg = <0x50f40000 0xbc000>;
			no-map;
		};

		/* M-mode firmware; Linux must never map or allocate it. */
		opensbi_region: opensbi@50e00000 {
			reg = <0x50e00000 0x40000>;
			no-map;
		};

		/*
		 * Coherent allocations cannot be served from PSRAM: it is
		 * cached, the SoC publishes no uncached alias of it, and Sv32
		 * page tables carry no cacheability attribute to remap it
		 * with.  Internal SRAM is reached without the data cache, so
		 * a pool there is coherent by construction.  It sits below
		 * the loader's LCD descriptor ring at 0x2f079000.
		 */
		dma_pool: dma-pool@2f040000 {
			compatible = "shared-dma-pool";
			reg = <0x2f040000 0x10000>;
			linux,dma-default;
			no-map;
		};
	};

	aliases {
		serial0 = &uart0;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <320000000>;

		/*
		 * Hart 0 stays in M-mode running the resident ESP-IDF
		 * firmware that owns the WLAN modem; Linux is given hart 1.
		 */
		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "espressif,esp32s31", "riscv";
			reg = <1>;
			riscv,isa = "rv32imabcn_zba_zbb";
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i", "m", "a", "zba", "zbb", "c",
					       "zicntr", "zicsr", "zifencei";
			mmu-type = "riscv,sv32";
			cpu1_intc: interrupt-controller {
				#interrupt-cells = <1>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
			};
		};
	};

	xtal: oscillator {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <40000000>;
	};

	/* The PHY driver gates the generated 12 MHz USB reference clock. */
	usb_ref_clk: usb-ref-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <12000000>;
	};

	sdmmc_clk: sdmmc-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;
		/*
		 * No bus master on this SoC is coherent with the data cache,
		 * and the hart implements no Zicbom, so every DMA-capable
		 * device below relies on the cache controller's sync engine.
		 */
		dma-noncoherent;

		cache: cache-controller@2c000000 {
			compatible = "espressif,esp32s31-cache";
			reg = <0x2c000000 0x1000>;
			cache-line-size = <64>;
			cache-level = <1>;
		};

		clic: interrupt-controller@10a00000 {
			#interrupt-cells = <3>;
			#address-cells = <0>;
			compatible = "espressif,esp32s31-clic";
			reg = <0x10a00000 0x20000>;
			interrupt-controller;
		};

		sdmmc0: mmc@20342000 {
			compatible = "espressif,esp32s31-dw-mshc", "snps,dw-mshc";
			reg = <0x20342000 0x1000>;
			interrupt-parent = <&clic>;
			interrupts = <34 3 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&sdmmc_clk>, <&sdmmc_clk>;
			clock-names = "biu", "ciu";
			clock-frequency = <50000000>;
			fifo-depth = <512>;
			bus-width = <4>;
			cap-sd-highspeed;
			no-1-8-v;
			disable-wp;
			status = "disabled";
		};

		uart0: serial@2038a000 {
			compatible = "esp,esp32s3-uart";
			reg = <0x2038a000 0x1000>;
			interrupt-parent = <&clic>;
			interrupts = <32 9 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&xtal>;
		};

		trng: rng@20814000 {
			compatible = "espressif,esp32s31-trng";
			reg = <0x20814000 0x100>, <0x2071003c 0x4>;
			reg-names = "trng", "clkrst";
		};

		/*
		 * The rings live in internal SRAM and the doorbells are the
		 * cross-core interrupt registers: FROM_CPU_0 is raised by the
		 * firmware and acknowledged here, FROM_CPU_1 is raised here.
		 */
		wifi: wifi@2f050000 {
			compatible = "espressif,esp32s31-wifi";
			reg = <0x2f050000 0x10000>, <0x20586010 0x8>;
			reg-names = "ipc", "doorbell";
			interrupt-parent = <&clic>;
			interrupts = <35 65 IRQ_TYPE_LEVEL_HIGH>;
		};

		usb_phy: phy@205870ac {
			compatible = "espressif,esp32s31-usb-phy";
			reg = <0x205870ac 0x4>, <0x20359030 0x4>,
			      <0x20589024 0x4>, <0x205890b0 0x4>,
			      <0x20380018 0x4>;
			reg-names = "clkrst", "cnnt", "usb-ctrl", "otghs-ctrl",
				    "utmi-fc06";
			#phy-cells = <0>;
		};

		usb0: usb@20300000 {
			compatible = "espressif,esp32s31-usb", "snps,dwc2";
			/*
			 * The named DWC2 registers end at 0xe04, but PIO
			 * transfers reach the per-channel FIFO windows at
			 * 0x1000 * (channel + 1).  Map the whole aperture the
			 * SoC reserves for the controller, which ends where
			 * the PAU block starts at 0x20341000.
			 */
			reg = <0x20300000 0x40000>;
			interrupt-parent = <&clic>;
			interrupts = <33 99 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&usb_ref_clk>;
			clock-names = "otg";
			phys = <&usb_phy>;
			phy-names = "usb2-phy";
			dr_mode = "host";
			disable-over-current;
		};

	};
};
