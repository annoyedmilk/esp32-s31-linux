// SPDX-License-Identifier: GPL-2.0+
/*
 * Espressif ESP32-S31 minimal Device Tree Source.
 * Author: Marco Müller <hello@annoyedmilk.ch>
 */

#include <dt-bindings/interrupt-controller/irq.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "espressif,esp32s31";

	memory@50000000 {
		device_type = "memory";
		/* 16MB RAM */
		reg = <0x50000000 0x01000000>;
	};

	aliases {
		serial0 = &uart0;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <320000000>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "espressif,esp32s31", "riscv";
			reg = <0>;
			riscv,isa = "rv32imabcn_zba_zbb";
			riscv,isa-base = "rv32i";
			riscv,isa-extensions = "i", "m", "a", "zba", "zbb", "c",
					       "zicntr", "zicsr", "zifencei";
			mmu-type = "riscv,sv32";
			cpu0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
			};
		};
	};

	xtal: oscillator {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <40000000>;
	};

	/* The PHY driver gates the generated 12 MHz USB reference clock. */
	usb_ref_clk: usb-ref-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <12000000>;
	};

	sdmmc_clk: sdmmc-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;
		/*
		 * No bus master on this SoC is coherent with the data cache,
		 * and the hart implements no Zicbom, so every DMA-capable
		 * device below relies on the cache controller's sync engine.
		 */
		dma-noncoherent;

		cache: cache-controller@2c000000 {
			compatible = "espressif,esp32s31-cache";
			reg = <0x2c000000 0x1000>;
			cache-line-size = <64>;
			cache-level = <1>;
		};

		clic: interrupt-controller@10a00000 {
			#interrupt-cells = <3>;
			#address-cells = <0>;
			compatible = "espressif,esp32s31-clic";
			reg = <0x10a00000 0x20000>;
			interrupt-controller;
		};

		sdmmc0: mmc@20342000 {
			compatible = "espressif,esp32s31-dw-mshc", "snps,dw-mshc";
			reg = <0x20342000 0x1000>;
			interrupt-parent = <&clic>;
			interrupts = <34 3 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&sdmmc_clk>, <&sdmmc_clk>;
			clock-names = "biu", "ciu";
			clock-frequency = <50000000>;
			fifo-depth = <512>;
			bus-width = <4>;
			cap-sd-highspeed;
			no-1-8-v;
			disable-wp;
			status = "disabled";
		};

		uart0: serial@2038a000 {
			compatible = "esp,esp32s3-uart";
			reg = <0x2038a000 0x1000>;
			interrupt-parent = <&clic>;
			interrupts = <32 9 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&xtal>;
		};

		usb_phy: phy@205870ac {
			compatible = "espressif,esp32s31-usb-phy";
			reg = <0x205870ac 0x4>, <0x20359030 0x4>,
			      <0x20589024 0x4>, <0x205890b0 0x4>,
			      <0x20380018 0x4>;
			reg-names = "clkrst", "cnnt", "usb-ctrl", "otghs-ctrl",
				    "utmi-fc06";
			#phy-cells = <0>;
		};

		usb0: usb@20300000 {
			compatible = "espressif,esp32s31-usb", "snps,dwc2";
			/*
			 * The named DWC2 registers end at 0xe04, but PIO
			 * transfers reach the per-channel FIFO windows at
			 * 0x1000 * (channel + 1).  Map the whole aperture the
			 * SoC reserves for the controller, which ends where
			 * the PAU block starts at 0x20341000.
			 */
			reg = <0x20300000 0x40000>;
			interrupt-parent = <&clic>;
			interrupts = <33 99 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&usb_ref_clk>;
			clock-names = "otg";
			phys = <&usb_phy>;
			phy-names = "usb2-phy";
			dr_mode = "host";
			disable-over-current;
		};

	};
};
