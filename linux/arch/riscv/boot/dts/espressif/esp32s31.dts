/*
 * The ESP32-S31-WROOM-3-N16R16V module alone (16 MB flash, 16 MB PSRAM):
 * UART0, Wi-Fi and Bluetooth.  The root is in the flash window of the
 * firmware.
 */
/dts-v1/;
#include "esp32s31.dtsi"

/ {
	model = "Espressif ESP32-S31-WROOM-3-N16R16V";
	compatible = "esp,esp32s31-wroom-3", "esp,esp32s31";

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

/* The "rootfs" and "data" partitions of partitions-esp32s31.csv. */
&wifi {
	flash {
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "rootfs";
				reg = <0x0 0x800000>;
				read-only;
			};

			partition@800000 {
				label = "data";
				reg = <0x800000 0x1f0000>;
			};
		};
	};
};
