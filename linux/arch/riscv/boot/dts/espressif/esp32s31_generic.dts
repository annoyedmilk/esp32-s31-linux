/*
 * ESP32-S31 Device Tree Source
 * Author: Marco Müller <hello@annoyedmilk.ch>
 */
/dts-v1/;
#include "esp32s31.dtsi"

/ {
	model = "Espressif ESP32-S31 S-mode (generic)";
	compatible = "espressif,esp32s31";

	chosen {
		linux,initrd-start = <0x50800000>;
		linux,initrd-end = <0x50A00000>;
		stdout-path = "serial0:115200n8";

		/*
		 * The loader brings up the Korvo-1's 800x480 RGB panel and
		 * leaves the LCD_CAM DMA scanning out an RGB565 buffer at the
		 * top of PSRAM, so Linux only has to describe it; the memory
		 * itself is reserved as fb_region.  of_platform creates this
		 * device explicitly for a simple-framebuffer under /chosen.
		 * A build whose loader leaves GPIO33/34 to USB Serial/JTAG
		 * skips display init, and then fb0 exists but drives nothing.
		 */
		framebuffer: framebuffer@50f40000 {
			compatible = "simple-framebuffer";
			reg = <0x50f40000 (800 * 480 * 2)>;
			width = <800>;
			height = <480>;
			stride = <(800 * 2)>;
			format = "r5g6b5";
			memory-region = <&fb_region>;
		};
	};
};

&sdmmc0 { status = "okay"; };
