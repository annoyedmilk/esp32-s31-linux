# ESP32-S31 MMU (Sv32) S-mode minimal defconfig, non-XIP.
# The kernel Image is copied through the S31's cacheable PSRAM aperture at
# 0x50000000 and entered there by OpenSBI fw_jump. It runs in
# Supervisor mode behind OpenSBI; the built-in DTB describes the SoC.
CONFIG_MMU=y
# CONFIG_RISCV_M_MODE is not set
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x50000000
CONFIG_NONPORTABLE=y
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
# CONFIG_CLINT_TIMER is not set

# CONFIG_CPU_ISOLATION is not set
CONFIG_LOG_BUF_SHIFT=14
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Disable heavyweight syscalls / features
# CONFIG_SYSFS_SYSCALL is not set
# CONFIG_FHANDLE is not set
# CONFIG_BASE_FULL is not set
# CONFIG_FUTEX is not set
# CONFIG_EPOLL is not set
# CONFIG_SIGNALFD is not set
# CONFIG_TIMERFD is not set
# CONFIG_EVENTFD is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_ADVISE_SYSCALLS is not set
# CONFIG_KALLSYMS is not set
# CONFIG_VM_EVENT_COUNTERS is not set
# CONFIG_COMPAT_BRK is not set

CONFIG_SLUB_TINY=y

# RISC-V 32-bit
CONFIG_ARCH_RV32I=y
CONFIG_SOC_ESP32S31=y

# CONFIG_SMP is not set
CONFIG_THREAD_SIZE_ORDER=2
CONFIG_RISCV_SLOW_UNALIGNED_ACCESS=y
# CONFIG_FPU is not set

# Linux and userspace use UART0 through the external USB-to-UART bridge, and
# the kernel log is mirrored onto the LCD through tty0.  OpenSBI retains its
# UART console for firmware diagnostics.
CONFIG_CMDLINE="earlycon=sbi console=tty0 console=ttyS0,115200 rdinit=/init"
CONFIG_CMDLINE_FORCE=y

# Reduce the timer/OpenSBI round-trip rate and suppress periodic idle ticks.
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_100=y

# Built-in DTB (no external loader needed)
CONFIG_BUILTIN_DTB=y
CONFIG_BUILTIN_DTB_NAME="espressif/esp32s31_generic"

# Security (minimal)
# CONFIG_SECCOMP is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_GCC_PLUGINS is not set
CONFIG_LSM="[]"

# Block layer
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y
# CONFIG_BLK_DEV_BSG is not set

# Executable format
CONFIG_BINFMT_ELF=y
# CONFIG_COREDUMP is not set

# Devtmpfs (so /dev nodes appear automatically)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Networking, for the esp-hosted Wi-Fi interface. The device is full-MAC and
# talks cfg80211 directly, so mac80211 stays out. PACKET and UNIX are what
# wpa_supplicant needs; INET carries the actual traffic.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_CFG80211=y
# There is no firmware loader here, so "regulatory.db" can never be read and
# cfg80211 falls back to the built-in world domain; the device applies its own
# regulatory rules. Requiring a signed regdb would only drag in PKCS#7, X.509
# and the trusted keyring, and make the build depend on host OpenSSL headers.
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS is not set

# Core dumps off. CONFIG_FW_LOADER cannot be turned off any more: CFG80211
# selects it. Nothing supplies a regulatory.db, so the load fails at boot and
# cfg80211 falls back to its built-in world regulatory domain.
# CONFIG_ALLOW_DEV_COREDUMP is not set

# USB HID input devices
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
CONFIG_HID=y
CONFIG_HID_GENERIC=y

# I2C / SPI -- off (re-enable when needed)
# CONFIG_I2C is not set
# CONFIG_SPI is not set

# SCSI stays off, and with it USB mass storage: selecting CONFIG_SCSI,
# CONFIG_BLK_DEV_SD and CONFIG_USB_STORAGE together hangs the boot between
# parse_args() and setup_log_buf(), long before any of their initcalls run.
# The hang moves with kernel layout -- adding printks to start_kernel() makes
# the same configuration boot -- and is not an image-size threshold, since
# padding an otherwise identical kernel past the failing size boots fine.
# Bisected 2026-08-03; see README. Root cause still unknown.
# CONFIG_SCSI is not set

# USB host: HID only
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_USB_HID=y
CONFIG_PHY_ESP32S31_USB=y

# Cache maintenance for DMA. The hart implements no Zicbom, so the ISA
# support is dropped: it only pulls in DMA_DIRECT_REMAP, which cannot produce
# an uncached mapping on RV32 anyway.
CONFIG_ESP32S31_CACHE=y
# CONFIG_RISCV_ISA_ZICBOM is not set

# MMC/SD card support
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y

# Network devices: the wireless class only, for the esp-hosted interface.
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ESPRESSIF=y
CONFIG_ESP32S31_WIFI=y
# CONFIG_ETHERNET is not set

# Frame buffer for the loader's 800x480 RGB565 panel, with fbcon on the VTs.
# VT is a printk console and console=tty0 is on the command line, so the boot
# log renders on the panel; scrolling that buffer in PSRAM costs about a
# second of boot time. Drop CONFIG_VT_CONSOLE and console=tty0 to get it back
# when the panel is not in use.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Serial / TTY
# CONFIG_SERIO is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LDISC_AUTOLOAD is not set
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_ESP32=y

# The SoC's TRNG seeds the CRNG at boot; without it the kernel needs about
# twenty seconds of interrupt timing before getrandom() stops blocking.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_ESP32S31=y
# CONFIG_DEVMEM is not set

# Virtualisation I/O -- off
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VHOST_MENU is not set

# Filesystems
# CONFIG_FILE_LOCKING is not set
# CONFIG_DNOTIFY is not set
# CONFIG_INOTIFY_USER is not set
# CONFIG_MISC_FILESYSTEMS is not set
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Debug / printk
CONFIG_PRINTK_TIME=y
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_SECTION_MISMATCH_WARN_ONLY is not set
# CONFIG_FRAME_POINTER is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_MISC is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_FTRACE is not set
# CONFIG_RUNTIME_TESTING_MENU is not set

CONFIG_INITRAMFS_SOURCE=""
CONFIG_DECOMPRESS_GZIP=y

# Keep the load image compact: no 4MB PMD section padding
# CONFIG_STRICT_KERNEL_RWX is not set
