 };
 
+static int dw_mci_esp32s31_init(struct dw_mci *host)
+{
+	/*
+	 * PSRAM has no uncached alias on this SoC and RV32 cannot remap it,
+	 * so dma_alloc_coherent() would hand back plain cached memory and the
+	 * IDMAC ownership bits would go stale.  Take the descriptor ring from
+	 * non-coherent DMA memory and maintain it explicitly instead.
+	 */
+	host->quirks |= DW_MMC_QUIRK_NONCOHERENT_DESC;
+	return 0;
+}
+
+static const struct dw_mci_drv_data esp32s31_drv_data = {
+	.init		= dw_mci_esp32s31_init,
+};
