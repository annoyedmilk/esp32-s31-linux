+/*
+ * The IDMAC ring is ordinary cached memory on platforms that cannot provide a
+ * coherent alias, so ownership hand-offs need explicit maintenance.  Sync the
+ * whole ring rather than individual descriptors: they are 16 bytes and several
+ * share a cache line, so a per-descriptor invalidate could discard a
+ * neighbour.
+ */
+static void dw_mci_desc_sync_for_cpu(struct dw_mci *host)
+{
+	if (host->quirks & DW_MMC_QUIRK_NONCOHERENT_DESC)
+		dma_sync_single_for_cpu(host->dev, host->sg_dma,
+					DESC_RING_BUF_SZ, DMA_BIDIRECTIONAL);
+}
+
+static void dw_mci_desc_sync_for_device(struct dw_mci *host)
+{
+	if (host->quirks & DW_MMC_QUIRK_NONCOHERENT_DESC)
+		dma_sync_single_for_device(host->dev, host->sg_dma,
+					   DESC_RING_BUF_SZ, DMA_BIDIRECTIONAL);
+}
+
+static void dw_mci_free_noncoherent_desc(void *data)
+{
+	struct dw_mci *host = data;
+
+	dma_free_noncoherent(host->dev, DESC_RING_BUF_SZ, host->sg_cpu,
+			     host->sg_dma, DMA_BIDIRECTIONAL);
+}
