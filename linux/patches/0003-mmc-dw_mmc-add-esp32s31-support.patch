+static int dw_mci_esp32s31_init(struct dw_mci *host)
+{
+	struct platform_device *pdev = to_platform_device(host->dev);
+	void __iomem *pad;
+
+	/*
+	 * This port does not map PSRAM as uncached.
+	 * Thus dma_alloc_coherent() gives cached memory, and the IDMAC owner
+	 * bits become old.  Get the descriptor ring from non-coherent DMA
+	 * memory and do the cache maintenance in the driver.
+	 */
+	host->quirks |= DW_MMC_QUIRK_NONCOHERENT_DESC;
+
+	/* GPIO20-25 are CNNT pads: the SD signals need their own pad control. */
+	pad = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(pad))
+		return PTR_ERR(pad);
+	writel(readl(pad) | BIT(0), pad);
+	return 0;
+}
+
+static const struct dw_mci_drv_data esp32s31_drv_data = {
+	.init		= dw_mci_esp32s31_init,
+};
