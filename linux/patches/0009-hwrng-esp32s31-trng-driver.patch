From: Marco Müller <hello@annoyedmilk.ch>
Subject: [PATCH] hwrng: esp32s31: hook up the ESP32-S31 TRNG driver

Without a hardware entropy source the kernel takes about twenty seconds to
seed its CRNG from interrupt timing alone, during which getrandom() blocks.
The ESP32-S31 has a true random number generator, so add its driver to the
hw_random Kconfig and Makefile.

Signed-off-by: Marco Müller <hello@annoyedmilk.ch>
---
--- a/drivers/char/hw_random/Kconfig
+++ b/drivers/char/hw_random/Kconfig
@@ -503,6 +503,20 @@
 
 	  To compile this driver as a module, choose M here: the module
 	  will be called exynos-trng.
+
+	  If unsure, say Y.
+
+config HW_RANDOM_ESP32S31
+	tristate "Espressif ESP32-S31 True Random Number Generator support"
+	depends on SOC_ESP32S31 || COMPILE_TEST
+	depends on HAS_IOMEM
+	default HW_RANDOM if SOC_ESP32S31
+	help
+	  This driver provides support for the True Random Number Generator
+	  available in the ESP32-S31 SoC.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called esp32s31-rng.
 
 	  If unsure, say Y.
 
--- a/drivers/char/hw_random/Makefile
+++ b/drivers/char/hw_random/Makefile
@@ -16,6 +16,7 @@
 n2-rng-y := n2-drv.o n2-asm.o
 obj-$(CONFIG_HW_RANDOM_VIA) += via-rng.o
 obj-$(CONFIG_HW_RANDOM_EXYNOS) += exynos-trng.o
+obj-$(CONFIG_HW_RANDOM_ESP32S31) += esp32s31-rng.o
 obj-$(CONFIG_HW_RANDOM_IXP4XX) += ixp4xx-rng.o
 obj-$(CONFIG_HW_RANDOM_OMAP) += omap-rng.o
 obj-$(CONFIG_HW_RANDOM_OMAP3_ROM) += omap3-rom-rng.o
