+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/i2c/esp,esp32s31-i2c.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 I2C controller
+
+maintainers:
+  - Marco Mueller <hello@annoyedmilk.ch>
+
+description:
+  The two I2C controllers of the ESP32-S31 in master mode, with a list of 8
+  commands and a 32-byte FIFO for each direction. The pins come through the
+  GPIO matrix.
+
+allOf:
+  - $ref: /schemas/i2c/i2c-controller.yaml#
+
+properties:
+  compatible:
+    const: esp,esp32s31-i2c
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: APB bus clock of the registers
+      - description: Core clock, the source of the SCL timing
+
+  clock-names:
+    items:
+      - const: apb
+      - const: core
+
+  resets:
+    maxItems: 1
+
+  clock-frequency:
+    maximum: 1000000
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/esp32s31-clk.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c@20385000 {
+        compatible = "esp,esp32s31-i2c";
+        reg = <0x20385000 0x1000>;
+        interrupt-parent = <&clic>;
+        interrupts = <37 23 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&hp_clkrst ESP32S31_CLK_I2C0_APB>,
+                 <&hp_clkrst ESP32S31_CLK_I2C0>;
+        clock-names = "apb", "core";
+        resets = <&hp_clkrst ESP32S31_RST_I2C0>;
+        clock-frequency = <400000>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+    };
diff --git a/Documentation/devicetree/bindings/interrupt-controller/esp,esp32s31-clic.yaml b/Documentation/devicetree/bindings/interrupt-controller/esp,esp32s31-clic.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/interrupt-controller/esp,esp32s31-clic.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interrupt-controller/esp,esp32s31-clic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 Core-Local Interrupt Controller
+
+maintainers:
+  - Marco Müller <hello@annoyedmilk.ch>
+
+description: >
+  Each ESP32-S31 core has a CLIC with 48 inputs: 16 architectural local
+  causes, then 32 inputs from the Interrupt Matrix of that core. The matrix
+  connects SoC interrupt sources to these inputs. All cores use the same
+  physical address for the register window, and each core sees its own
+  registers. The supervisor window shows an input only after the
+  machine-mode firmware gives it to S-mode. Thus this binding describes only
+  the supervisor view.
+
+  A peripheral interrupt is only a SoC source number until the matrix
+  connects it. Thus an interrupt specifier has three cells: the CLIC input,
+  the SoC interrupt source for that input, and the trigger type.
+
+properties:
+  compatible:
+    const: esp,esp32s31-clic
+
+  reg:
+    items:
+      - description: supervisor CLIC register window
+      - description: Interrupt Matrix routing blocks for both cores
+
+  reg-names:
+    items:
+      - const: clic
+      - const: intmatrix
+
+  interrupt-controller: true
+
+  "#interrupt-cells":
+    const: 3
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupt-controller
+  - "#interrupt-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    interrupt-controller@10a00000 {
+        compatible = "esp,esp32s31-clic";
+        reg = <0x10a00000 0x20000>, <0x20585000 0x1000>;
+        reg-names = "clic", "intmatrix";
+        interrupt-controller;
+        #interrupt-cells = <3>;
+    };
