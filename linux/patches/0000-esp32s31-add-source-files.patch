+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/rng/esp,esp32s31-trng.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 true random number generator
+
+maintainers:
+  - Marco Müller <hello@annoyedmilk.ch>
+
+description: >
+  The ESP32-S31 samples a noise source and mixes it through a CRC, so unlike
+  the generator on earlier Espressif parts it needs neither the RF subsystem
+  nor the SAR ADC to be running. Its clock and reset are one register in the
+  LP peripheral clock controller rather than a clock provider.
+
+properties:
+  compatible:
+    const: esp,esp32s31-trng
+
+  reg:
+    items:
+      - description: generator registers
+      - description: clock and reset control
+
+  reg-names:
+    items:
+      - const: trng
+      - const: clkrst
+
+required:
+  - compatible
+  - reg
+  - reg-names
+
+additionalProperties: false
+
+examples:
+  - |
+    rng@20814000 {
+        compatible = "esp,esp32s31-trng";
+        reg = <0x20814000 0x100>, <0x2071003c 0x4>;
+        reg-names = "trng", "clkrst";
+    };
