diff --git a/drivers/net/wireless/espressif/esp_hosted/Kbuild b/drivers/net/wireless/espressif/esp_hosted/Kbuild
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/espressif/esp_hosted/Kbuild
@@ -0,0 +1,11 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# The ESP-Hosted host driver with the shared-memory transport.  The objects
+# are the common objects of host/Makefile of ESP-Hosted, which
+# br2-external/linux/linux-ext-esp-hosted-linux.mk copies to this directory.
+obj-y := esp32_shm.o
+esp32_shm-y := esp_shm.o esp_bt.o esp_rcp.o main.o esp_cmd.o esp_utils.o \
+	esp_cfg80211.o esp_stats.o esp_debugfs.o esp_log.o
+# The flash window of the firmware, as an MTD device.
+esp32_shm-$(CONFIG_MTD) += esp_shm_flash.o
+ccflags-y += -I$(src) -I$(src)/include -DCONFIG_AP_MODE
+CFLAGS_esp_log.o = -DDEBUG
diff --git a/drivers/net/wireless/espressif/esp_hosted/esp_shm.c b/drivers/net/wireless/espressif/esp_hosted/esp_shm.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/espressif/esp_hosted/esp_shm.c
@@ -0,0 +1,560 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ESP-Hosted transport for the ESP32-S31 when this Linux runs on hart 1 and
+ * the ESP-Hosted firmware runs on hart 0 of the same chip.  The frames go
+ * through two byte rings in internal SRAM, and the cross-core interrupts are
+ * the doorbells.  The frames are the frames of the USB transport, so the
+ * driver core sees a USB transport.  esp32s31-hosted-shm.h has the layout.
+ */
+
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/skbuff.h>
+#include <linux/workqueue.h>
+
+#include "utils.h"
+#include "esp_if.h"
+#include "esp_api.h"
+#include "esp_utils.h"
+#include "esp32s31-hosted-shm.h"
+#include "esp_shm_flash.h"
+
+/* Frames that wait for ring space: stop the net queues, wake them, drop. */
+#define ESP_SHM_TX_PAUSE	64
+#define ESP_SHM_TX_RESUME	16
+#define ESP_SHM_TX_QUEUE_MAX	256
+
+/* Doorbell registers: FROM_CPU_1 to the firmware, FROM_CPU_2 to Linux. */
+#define ESP_SHM_DOORBELL_TO_FW	0x0
+#define ESP_SHM_DOORBELL_TO_HOST	0x4
+
+struct esp_shm_ring {
+	u32 ctrl;
+	u32 data;
+	u32 size;
+};
+
+static const struct esp_shm_ring to_host = {
+	ESP_SHM_TO_HOST_CTRL, ESP_SHM_TO_HOST_DATA, ESP_SHM_TO_HOST_SIZE
+};
+static const struct esp_shm_ring to_fw = {
+	ESP_SHM_TO_FW_CTRL, ESP_SHM_TO_FW_DATA, ESP_SHM_TO_FW_SIZE
+};
+
+struct esp_shm_context {
+	struct esp_adapter *adapter;
+	struct device *dev;
+	void __iomem *shm;
+	void __iomem *doorbell;
+	struct sk_buff_head tx_queue;
+	struct work_struct tx_work;
+	spinlock_t tx_lock;		/* running, tx_quiesced, tx_paused, tx_queue */
+	struct esp_shm_flash *flash;
+	bool running;
+	bool tx_quiesced;
+	bool tx_paused;
+};
+
+static struct esp_adapter *s_adapter;
+
+/* Each transport defines it.  This one never sleeps, as on USB. */
+volatile u8 host_sleep;
+
+static u32 shm_read32(struct esp_shm_context *ctx, u32 off)
+{
+	return ioread32(ctx->shm + off);
+}
+
+static void shm_write32(struct esp_shm_context *ctx, u32 off, u32 val)
+{
+	iowrite32(val, ctx->shm + off);
+}
+
+static void ring_copy_in(struct esp_shm_context *ctx,
+			 const struct esp_shm_ring *r, u32 pos,
+			 const void *src, u32 len)
+{
+	u32 off = pos & (r->size - 1);
+	u32 first = min(len, r->size - off);
+
+	memcpy_toio(ctx->shm + r->data + off, src, first);
+	memcpy_toio(ctx->shm + r->data, src + first, len - first);
+}
+
+/*
+ * dst and src are 4-byte aligned.  memcpy_fromio() cannot know that for dst,
+ * and on RV32 it then stores each word as four bytes.
+ */
+static void shm_copy_from(void *dst, const void __iomem *src, u32 len)
+{
+	u32 *d = dst;
+
+	for (; len >= 4; len -= 4, src += 4)
+		*d++ = __raw_readl(src);
+	memcpy_fromio(d, src, len);
+}
+
+static void ring_copy_out(struct esp_shm_context *ctx,
+			  const struct esp_shm_ring *r, u32 pos,
+			  void *dst, u32 len)
+{
+	u32 off = pos & (r->size - 1);
+	u32 first = min(len, r->size - off);
+
+	shm_copy_from(dst, ctx->shm + r->data + off, first);
+	shm_copy_from(dst + first, ctx->shm + r->data, len - first);
+}
+
+static void esp_shm_ring_firmware(struct esp_shm_context *ctx)
+{
+	iowrite32(1, ctx->doorbell + ESP_SHM_DOORBELL_TO_FW);
+}
+
+/* Ask the firmware for a new boot event, as the USB READY replay does. */
+static void esp_shm_request_ready_replay(struct esp_shm_context *ctx)
+{
+	u32 req = shm_read32(ctx, ESP_SHM_CTRL + ESP_SHM_HOST_REQ_OFF);
+
+	shm_write32(ctx, ESP_SHM_CTRL + ESP_SHM_HOST_REQ_OFF,
+		    req | ESP_SHM_REQ_READY_REPLAY);
+	esp_shm_ring_firmware(ctx);
+}
+
+/*
+ * Add one frame.  Returns false when the ring is full.  Sets *kick when the
+ * firmware had read all frames: then it can wait for the doorbell.  Else it
+ * reads this frame before it waits.
+ */
+static bool esp_shm_push(struct esp_shm_context *ctx, const struct sk_buff *skb,
+			 bool *kick)
+{
+	u32 head = shm_read32(ctx, to_fw.ctrl + ESP_SHM_HEAD_OFF);
+	u32 tail = shm_read32(ctx, to_fw.ctrl + ESP_SHM_TAIL_OFF);
+	u32 need = ESP_SHM_RECORD_LEN(skb->len);
+	u32 len = skb->len;
+
+	if (need > to_fw.size - (head - tail))
+		return false;
+
+	ring_copy_in(ctx, &to_fw, head + 4, skb->data, len);
+	ring_copy_in(ctx, &to_fw, head, &len, 4);
+	/* The firmware reads head, then the frame. */
+	wmb();
+	shm_write32(ctx, to_fw.ctrl + ESP_SHM_HEAD_OFF, head + need);
+	/*
+	 * Store head before the load of tail.  The firmware stores tail before
+	 * it loads head, so one of the two sides sees the other.
+	 */
+	mb();
+	*kick |= shm_read32(ctx, to_fw.ctrl + ESP_SHM_TAIL_OFF) == head;
+	return true;
+}
+
+/* Stop or wake the net queues.  Called with tx_lock held. */
+static void esp_shm_tx_flow(struct esp_shm_context *ctx, bool pause)
+{
+	int i;
+
+	if (ctx->tx_paused == pause)
+		return;
+	ctx->tx_paused = pause;
+	for (i = 0; i < ESP_MAX_INTERFACE; i++) {
+		if (pause)
+			esp_tx_pause(ctx->adapter->priv[i]);
+		else
+			esp_tx_resume(ctx->adapter->priv[i]);
+	}
+}
+
+/* Move the queued frames into the ring.  Called with tx_lock held. */
+static void esp_shm_tx_flush(struct esp_shm_context *ctx)
+{
+	struct sk_buff *skb;
+	bool kick = false;
+
+	if (!ctx->running || ctx->tx_quiesced)
+		return;
+
+	while ((skb = skb_peek(&ctx->tx_queue))) {
+		/*
+		 * Ask for a doorbell before the second try, so that space which
+		 * the firmware frees in between is not missed.
+		 */
+		if (!esp_shm_push(ctx, skb, &kick)) {
+			shm_write32(ctx, to_fw.ctrl + ESP_SHM_WAIT_OFF, 1);
+			/* The flag before the second read of the ring index. */
+			mb();
+			if (!esp_shm_push(ctx, skb, &kick))
+				break;
+		}
+		__skb_unlink(skb, &ctx->tx_queue);
+		dev_kfree_skb_any(skb);
+	}
+
+	if (skb_queue_len(&ctx->tx_queue) <= ESP_SHM_TX_RESUME)
+		esp_shm_tx_flow(ctx, false);
+	if (kick)
+		esp_shm_ring_firmware(ctx);
+}
+
+/* The firmware freed space in the ring. */
+static void esp_shm_tx_work(struct work_struct *work)
+{
+	struct esp_shm_context *ctx =
+		container_of(work, struct esp_shm_context, tx_work);
+
+	spin_lock_bh(&ctx->tx_lock);
+	esp_shm_tx_flush(ctx);
+	spin_unlock_bh(&ctx->tx_lock);
+}
+
+static void esp_shm_tx_purge(struct esp_shm_context *ctx)
+{
+	spin_lock_bh(&ctx->tx_lock);
+	__skb_queue_purge(&ctx->tx_queue);
+	spin_unlock_bh(&ctx->tx_lock);
+}
+
+static irqreturn_t esp_shm_irq(int irq, void *data)
+{
+	struct esp_shm_context *ctx = data;
+
+	iowrite32(0, ctx->doorbell + ESP_SHM_DOORBELL_TO_HOST);
+	esp_process_new_packet_intr(ctx->adapter);
+	esp_shm_flash_wake(ctx->flash);
+	if (!skb_queue_empty(&ctx->tx_queue))
+		schedule_work(&ctx->tx_work);
+	return IRQ_HANDLED;
+}
+
+static struct sk_buff *esp_shm_alloc_skb(u32 len)
+{
+	struct sk_buff *skb;
+	u32 offset;
+
+	/* As the USB transport: keep the headroom and align the data. */
+	skb = netdev_alloc_skb(NULL, len + INTERFACE_HEADER_PADDING +
+			       SKB_DATA_ADDR_ALIGNMENT);
+	if (!skb)
+		return NULL;
+
+	skb_reserve(skb, INTERFACE_HEADER_PADDING);
+	offset = ((unsigned long)skb->data) & (SKB_DATA_ADDR_ALIGNMENT - 1);
+	if (offset)
+		skb_reserve(skb, SKB_DATA_ADDR_ALIGNMENT - offset);
+	return skb;
+}
+
+/* Give the space of the read frames back to the firmware. */
+static void esp_shm_rx_done(struct esp_shm_context *ctx, u32 tail)
+{
+	/* Read the frames before the firmware can write over them. */
+	mb();
+	shm_write32(ctx, to_host.ctrl + ESP_SHM_TAIL_OFF, tail);
+	/* Store tail before the loads of wait and head.  See esp_shm_push(). */
+	mb();
+	if (shm_read32(ctx, to_host.ctrl + ESP_SHM_WAIT_OFF)) {
+		shm_write32(ctx, to_host.ctrl + ESP_SHM_WAIT_OFF, 0);
+		esp_shm_ring_firmware(ctx);
+	}
+}
+
+static struct sk_buff *esp_shm_read(struct esp_adapter *adapter)
+{
+	struct esp_shm_context *ctx = adapter ? adapter->if_context : NULL;
+	struct sk_buff *skb = NULL;
+	u32 head, tail, len;
+
+	if (!ctx || !ctx->running)
+		return NULL;
+
+	tail = shm_read32(ctx, to_host.ctrl + ESP_SHM_TAIL_OFF);
+	while (!skb) {
+		head = shm_read32(ctx, to_host.ctrl + ESP_SHM_HEAD_OFF);
+		if (head == tail)
+			return NULL;
+		/* The firmware wrote the frame before head. */
+		rmb();
+
+		ring_copy_out(ctx, &to_host, tail, &len, 4);
+		if (len < sizeof(struct esp_payload_header) ||
+		    ESP_SHM_RECORD_LEN(len) > head - tail) {
+			dev_err_ratelimited(ctx->dev, "bad frame length %u\n", len);
+			shm_write32(ctx, to_host.ctrl + ESP_SHM_TAIL_OFF, head);
+			esp_schedule_transport_recovery(adapter);
+			return NULL;
+		}
+
+		/* Without memory, drop the frame: no doorbell comes for it. */
+		skb = esp_shm_alloc_skb(len);
+		if (skb)
+			ring_copy_out(ctx, &to_host, tail + 4, skb_put(skb, len), len);
+		tail += ESP_SHM_RECORD_LEN(len);
+		esp_shm_rx_done(ctx, tail);
+	}
+	return skb;
+}
+
+static int esp_shm_write(struct esp_adapter *adapter, struct sk_buff *skb)
+{
+	struct esp_shm_context *ctx = adapter ? adapter->if_context : NULL;
+	int ret = 0;
+
+	if (!skb)
+		return -EINVAL;
+	if (!ctx || skb->len > adapter->tx_aggr_size ||
+	    (skb_is_nonlinear(skb) && skb_linearize(skb))) {
+		dev_kfree_skb_any(skb);
+		return ctx ? -EMSGSIZE : -ENODEV;
+	}
+
+	spin_lock_bh(&ctx->tx_lock);
+	if (!ctx->running || ctx->tx_quiesced) {
+		ret = -ENODEV;
+	} else if (skb_queue_len(&ctx->tx_queue) >= ESP_SHM_TX_QUEUE_MAX) {
+		ret = -EBUSY;
+	} else {
+		__skb_queue_tail(&ctx->tx_queue, skb);
+		esp_shm_tx_flush(ctx);
+		if (skb_queue_len(&ctx->tx_queue) >= ESP_SHM_TX_PAUSE)
+			esp_shm_tx_flow(ctx, true);
+	}
+	spin_unlock_bh(&ctx->tx_lock);
+
+	if (ret)
+		dev_kfree_skb_any(skb);
+	return ret;
+}
+
+static void esp_shm_set_tx_quiesced(struct esp_shm_context *ctx, bool quiesced)
+{
+	spin_lock_bh(&ctx->tx_lock);
+	ctx->tx_quiesced = quiesced;
+	spin_unlock_bh(&ctx->tx_lock);
+}
+
+/*
+ * The firmware never restarts without Linux, so a "firmware reset" here is a
+ * new boot event.  Drop the frames of the old session in the two directions.
+ */
+static int esp_shm_quiesce_for_fw_reset(struct esp_adapter *adapter)
+{
+	struct esp_shm_context *ctx = adapter ? adapter->if_context : NULL;
+
+	if (!ctx)
+		return -ENODEV;
+	esp_shm_set_tx_quiesced(ctx, true);
+	cancel_work_sync(&ctx->tx_work);
+	esp_shm_tx_purge(ctx);
+	return 0;
+}
+
+static int esp_shm_reinit_after_fw_reset(struct esp_adapter *adapter)
+{
+	struct esp_shm_context *ctx = adapter ? adapter->if_context : NULL;
+
+	if (!ctx || !ctx->running)
+		return -ENODEV;
+	esp_shm_set_tx_quiesced(ctx, false);
+	schedule_work(&ctx->tx_work);
+	return 0;
+}
+
+static int esp_shm_recover_transport(struct esp_adapter *adapter)
+{
+	struct esp_shm_context *ctx = adapter ? adapter->if_context : NULL;
+
+	if (!ctx || !ctx->running)
+		return -ENODEV;
+	/* A new boot event completes the recovery, as on USB. */
+	esp_shm_request_ready_replay(ctx);
+	return 0;
+}
+
+static struct esp_if_ops esp_shm_if_ops = {
+	.read = esp_shm_read,
+	.write = esp_shm_write,
+	.alloc_skb = esp_shm_alloc_skb,
+	.quiesce_for_fw_reset = esp_shm_quiesce_for_fw_reset,
+	.reinit_after_fw_reset = esp_shm_reinit_after_fw_reset,
+	.recover_transport = esp_shm_recover_transport,
+};
+
+static int esp_shm_probe(struct platform_device *pdev)
+{
+	struct esp_adapter *adapter = s_adapter;
+	struct device *dev = &pdev->dev;
+	struct esp_shm_context *ctx;
+	int irq, ret;
+
+	if (!adapter)
+		return -ENODEV;
+	if (adapter->if_context)
+		return -EBUSY;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->shm = devm_platform_ioremap_resource_byname(pdev, "shm");
+	if (IS_ERR(ctx->shm))
+		return PTR_ERR(ctx->shm);
+	ctx->doorbell = devm_platform_ioremap_resource_byname(pdev, "doorbell");
+	if (IS_ERR(ctx->doorbell))
+		return PTR_ERR(ctx->doorbell);
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	if (shm_read32(ctx, ESP_SHM_CTRL + ESP_SHM_MAGIC_OFF) != ESP_SHM_MAGIC ||
+	    shm_read32(ctx, ESP_SHM_CTRL + ESP_SHM_VERSION_OFF) != ESP_SHM_VERSION) {
+		dev_err(dev, "no ESP-Hosted firmware with shared-memory transport\n");
+		return -ENODEV;
+	}
+
+	ctx->adapter = adapter;
+	ctx->dev = dev;
+	skb_queue_head_init(&ctx->tx_queue);
+	spin_lock_init(&ctx->tx_lock);
+	INIT_WORK(&ctx->tx_work, esp_shm_tx_work);
+
+	adapter->if_context = ctx;
+	adapter->if_ops = &esp_shm_if_ops;
+	adapter->if_type = ESP_IF_TYPE_USB;
+	adapter->dev = dev;
+	esp_reset_boot_recovery_for_binding(adapter, true);
+	clear_bit(ESP_TRANSPORT_REMOVING, &adapter->state_flags);
+	clear_bit(ESP_CLEANUP_IN_PROGRESS, &adapter->state_flags);
+	atomic_set(&adapter->state, ESP_CONTEXT_RX_READY);
+	ctx->running = true;
+	platform_set_drvdata(pdev, ctx);
+
+	ret = devm_request_irq(dev, irq, esp_shm_irq, 0, dev_name(dev), ctx);
+	if (ret) {
+		ctx->running = false;
+		adapter->if_context = NULL;
+		adapter->dev = NULL;
+		atomic_set(&adapter->state, ESP_CONTEXT_DISABLED);
+		return ret;
+	}
+
+	/*
+	 * The firmware put its boot event into the ring before Linux started.
+	 * Read it now.  If it is missing, the recovery watchdog asks for a new
+	 * one through recover_transport().
+	 */
+	esp_process_new_packet_intr(adapter);
+	ctx->flash = esp_shm_flash_probe(dev, ctx->shm, ctx->doorbell);
+	schedule_delayed_work(&adapter->fw_recovery_work,
+			      msecs_to_jiffies(ESP_FW_RECOVERY_WATCHDOG_MS));
+	dev_info(dev, "ESP32-S31 shared-memory transport bound\n");
+	return 0;
+}
+
+static void esp_shm_remove(struct platform_device *pdev)
+{
+	struct esp_shm_context *ctx = platform_get_drvdata(pdev);
+	struct esp_adapter *adapter = ctx->adapter;
+
+	set_bit(ESP_TRANSPORT_REMOVING, &adapter->state_flags);
+	set_bit(ESP_CLEANUP_IN_PROGRESS, &adapter->state_flags);
+	clear_bit(ESP_INIT_DONE, &adapter->state_flags);
+	atomic_set(&adapter->state, ESP_CONTEXT_DISABLED);
+	cancel_delayed_work_sync(&adapter->fw_recovery_work);
+	if (adapter->events_wq)
+		cancel_work_sync(&adapter->events_work);
+	skb_queue_purge(&adapter->events_skb_q);
+	if (adapter->if_rx_workqueue)
+		cancel_work_sync(&adapter->if_rx_work);
+	esp_remove_card(adapter, false);
+	esp_shm_flash_remove(ctx->flash);
+
+	esp_shm_set_tx_quiesced(ctx, true);
+	ctx->running = false;
+	devm_free_irq(&pdev->dev, platform_get_irq(pdev, 0), ctx);
+	cancel_work_sync(&ctx->tx_work);
+	esp_shm_tx_purge(ctx);
+	adapter->if_context = NULL;
+	adapter->dev = NULL;
+}
+
+static const struct of_device_id esp_shm_of_match[] = {
+	{ .compatible = "esp,esp32s31-hosted-shm" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, esp_shm_of_match);
+
+static struct platform_driver esp_shm_driver = {
+	.probe = esp_shm_probe,
+	.remove = esp_shm_remove,
+	.driver = {
+		.name = "esp32s31-hosted-shm",
+		.of_match_table = esp_shm_of_match,
+	},
+};
+
+/*
+ * On USB, close is a soft reset of the firmware.  Here a firmware restart
+ * also restarts Linux, so open and close only ask for a new boot event.  The
+ * driver core starts a new session, but the firmware keeps its Wi-Fi state.
+ */
+int generate_slave_intr(void *context, u8 data)
+{
+	struct esp_shm_context *ctx = context;
+
+	if (!ctx)
+		return -ENODEV;
+	if (data & (BIT(ESP_OPEN_DATA_PATH) | BIT(ESP_CLOSE_DATA_PATH)))
+		esp_shm_request_ready_replay(ctx);
+	return 0;
+}
+
+int esp_init_interface_layer(struct esp_adapter *adapter, u32 speed)
+{
+	int ret;
+
+	if (!adapter)
+		return -EINVAL;
+
+	s_adapter = adapter;
+	adapter->if_type = ESP_IF_TYPE_USB;
+	adapter->if_ops = &esp_shm_if_ops;
+	ret = platform_driver_register(&esp_shm_driver);
+	if (ret) {
+		adapter->if_ops = NULL;
+		s_adapter = NULL;
+	}
+	return ret;
+}
+
+void esp_deinit_interface_layer(void)
+{
+	platform_driver_unregister(&esp_shm_driver);
+	s_adapter = NULL;
+}
+
+int esp_validate_chipset(struct esp_adapter *adapter, u8 chipset)
+{
+	if (!adapter)
+		return -EINVAL;
+
+	if (chipset != ESP_FIRMWARE_CHIP_ESP32S31) {
+		esp_err("Chipset=%s ID=%02x not supported for shared memory\n",
+			esp_chipname_from_id(chipset), chipset);
+		adapter->chipset = ESP_FIRMWARE_CHIP_UNRECOGNIZED;
+		return -ENODEV;
+	}
+
+	adapter->chipset = chipset;
+	esp_info("Chipset=%s ID=%02x detected over shared memory\n",
+		 esp_chipname_from_id(chipset), chipset);
+	return 0;
+}
+
+int esp_adjust_spi_clock(struct esp_adapter *adapter, u8 spi_clk_mhz)
+{
+	return 0;
+}
diff --git a/drivers/net/wireless/espressif/esp_hosted/esp_shm_flash.c b/drivers/net/wireless/espressif/esp_hosted/esp_shm_flash.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/espressif/esp_hosted/esp_shm_flash.c
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The flash window of the ESP32-S31 firmware, as an MTD device with the
+ * partitions of the "flash" child node.  Linux cannot use the SPI flash
+ * itself: hart 0 runs its code from it.  The firmware maps the window in the
+ * flash cache, and Linux reads it there.  The firmware programs and erases
+ * the window for Linux, through the flash mailbox of the shared block
+ * (esp32s31-hosted-shm.h).  Linux runs on while it does: the firmware uses
+ * flash auto-suspend.  An erase block is 64 KiB, for UBI.
+ */
+
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/minmax.h>
+#include <linux/mtd/mtd.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/wait.h>
+
+#include "esp32s31-hosted-shm.h"
+#include "esp_shm_flash.h"
+
+/* A block erase takes longer when cache misses suspend it often. */
+#define ESP_SHM_FLASH_TIMEOUT_MS	10000
+
+struct esp_shm_flash {
+	struct mtd_info mtd;
+	void *window;			/* the window in the flash cache */
+	void __iomem *mbox;		/* ESP_SHM_FLASH in the shared block */
+	void __iomem *data;		/* ESP_SHM_FLASH_DATA */
+	void __iomem *doorbell;
+	struct mutex lock;		/* the mailbox */
+	wait_queue_head_t wq;		/* the firmware completed a command */
+};
+
+static u32 mbox_read(struct esp_shm_flash *flash, u32 off)
+{
+	return ioread32(flash->mbox + off);
+}
+
+/* One command of the mailbox.  Called with the lock held. */
+static int esp_shm_flash_cmd(struct esp_shm_flash *flash, u32 cmd, u32 addr,
+			     const void *buf, u32 len)
+{
+	/* After a timeout, the firmware can still work on the old command. */
+	if (mbox_read(flash, ESP_SHM_FLASH_CMD_OFF))
+		return -EBUSY;
+	iowrite32(addr, flash->mbox + ESP_SHM_FLASH_ADDR_OFF);
+	iowrite32(len, flash->mbox + ESP_SHM_FLASH_LEN_OFF);
+	if (cmd == ESP_SHM_FLASH_PROGRAM)
+		memcpy_toio(flash->data, buf, len);
+	/* The firmware reads the request when it sees the command. */
+	wmb();
+	iowrite32(cmd, flash->mbox + ESP_SHM_FLASH_CMD_OFF);
+	iowrite32(1, flash->doorbell);
+
+	if (!wait_event_timeout(flash->wq, !mbox_read(flash, ESP_SHM_FLASH_CMD_OFF),
+				msecs_to_jiffies(ESP_SHM_FLASH_TIMEOUT_MS)))
+		return -ETIMEDOUT;
+	/* Read the status and the data only after the cleared command. */
+	rmb();
+	return mbox_read(flash, ESP_SHM_FLASH_STATUS_OFF) ? -EIO : 0;
+}
+
+/* The lock keeps a read from seeing half of a program or erase. */
+static int esp_shm_flash_read(struct mtd_info *mtd, loff_t from, size_t len,
+			      size_t *retlen, u_char *buf)
+{
+	struct esp_shm_flash *flash = container_of(mtd, struct esp_shm_flash, mtd);
+
+	mutex_lock(&flash->lock);
+	memcpy(buf, flash->window + from, len);
+	mutex_unlock(&flash->lock);
+	*retlen = len;
+	return 0;
+}
+
+/* In mailbox blocks that do not cross a sector. */
+static int esp_shm_flash_write(struct mtd_info *mtd, loff_t to, size_t len,
+			       size_t *retlen, const u_char *buf)
+{
+	struct esp_shm_flash *flash = container_of(mtd, struct esp_shm_flash, mtd);
+	int ret = 0;
+
+	mutex_lock(&flash->lock);
+	while (len) {
+		u32 n = min_t(size_t, len,
+			      ESP_SHM_FLASH_DATA_SIZE - to % ESP_SHM_FLASH_DATA_SIZE);
+
+		ret = esp_shm_flash_cmd(flash, ESP_SHM_FLASH_PROGRAM, to, buf, n);
+		if (ret)
+			break;
+		*retlen += n;
+		to += n;
+		buf += n;
+		len -= n;
+	}
+	mutex_unlock(&flash->lock);
+	return ret;
+}
+
+static int esp_shm_flash_erase(struct mtd_info *mtd, struct erase_info *instr)
+{
+	struct esp_shm_flash *flash = container_of(mtd, struct esp_shm_flash, mtd);
+	u64 addr;
+	int ret = 0;
+
+	mutex_lock(&flash->lock);
+	for (addr = instr->addr; addr < instr->addr + instr->len;
+	     addr += ESP_SHM_FLASH_BLOCK) {
+		ret = esp_shm_flash_cmd(flash, ESP_SHM_FLASH_ERASE, addr, NULL,
+					ESP_SHM_FLASH_BLOCK);
+		if (ret) {
+			instr->fail_addr = addr;
+			break;
+		}
+	}
+	mutex_unlock(&flash->lock);
+	return ret;
+}
+
+struct esp_shm_flash *esp_shm_flash_probe(struct device *dev, void __iomem *shm,
+					  void __iomem *doorbell)
+{
+	u32 size = ioread32(shm + ESP_SHM_FLASH + ESP_SHM_FLASH_SIZE_OFF);
+	u32 map = ioread32(shm + ESP_SHM_FLASH + ESP_SHM_FLASH_MAP_OFF);
+	struct device_node *np;
+	struct esp_shm_flash *flash;
+	struct mtd_info *mtd;
+	int ret;
+
+	np = of_get_child_by_name(dev->of_node, "flash");
+	if (!size || !np)
+		goto none;
+	flash = kzalloc_obj(*flash);
+	if (!flash)
+		goto none;
+	flash->window = memremap(map, size, MEMREMAP_WB);
+	if (!flash->window)
+		goto free;
+
+	flash->mbox = shm + ESP_SHM_FLASH;
+	flash->data = shm + ESP_SHM_FLASH_DATA;
+	flash->doorbell = doorbell;
+	mutex_init(&flash->lock);
+	init_waitqueue_head(&flash->wq);
+
+	mtd = &flash->mtd;
+	mtd->name = "esp32s31-flash";
+	mtd->type = MTD_NORFLASH;
+	mtd->flags = MTD_CAP_NORFLASH;
+	mtd->size = size;
+	mtd->erasesize = ESP_SHM_FLASH_BLOCK;
+	mtd->writesize = 1;
+	mtd->writebufsize = ESP_SHM_FLASH_DATA_SIZE;
+	mtd->owner = THIS_MODULE;
+	mtd->dev.parent = dev;
+	mtd->_read = esp_shm_flash_read;
+	mtd->_write = esp_shm_flash_write;
+	mtd->_erase = esp_shm_flash_erase;
+	mtd_set_of_node(mtd, np);
+
+	ret = mtd_device_register(mtd, NULL, 0);
+	if (!ret)
+		return flash;
+	dev_warn(dev, "no flash device: %d\n", ret);
+	memunmap(flash->window);
+free:
+	kfree(flash);
+none:
+	of_node_put(np);
+	return NULL;
+}
+
+void esp_shm_flash_wake(struct esp_shm_flash *flash)
+{
+	if (flash)
+		wake_up(&flash->wq);
+}
+
+void esp_shm_flash_remove(struct esp_shm_flash *flash)
+{
+	if (!flash)
+		return;
+	mtd_device_unregister(&flash->mtd);
+	of_node_put(mtd_get_of_node(&flash->mtd));
+	memunmap(flash->window);
+	kfree(flash);
+}
diff --git a/drivers/net/wireless/espressif/esp_hosted/esp_shm_flash.h b/drivers/net/wireless/espressif/esp_hosted/esp_shm_flash.h
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/espressif/esp_hosted/esp_shm_flash.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * The flash window of the ESP32-S31 firmware as an MTD device.  Without MTD,
+ * these do nothing.
+ */
+#ifndef _ESP_SHM_FLASH_H
+#define _ESP_SHM_FLASH_H
+
+#include <linux/device.h>
+#include <linux/io.h>
+
+struct esp_shm_flash;
+
+#if IS_ENABLED(CONFIG_MTD)
+struct esp_shm_flash *esp_shm_flash_probe(struct device *dev, void __iomem *shm,
+					  void __iomem *doorbell);
+void esp_shm_flash_wake(struct esp_shm_flash *flash);
+void esp_shm_flash_remove(struct esp_shm_flash *flash);
+#else
+static inline struct esp_shm_flash *esp_shm_flash_probe(struct device *dev,
+							void __iomem *shm,
+							void __iomem *doorbell)
+{
+	return NULL;
+}
+
+static inline void esp_shm_flash_wake(struct esp_shm_flash *flash) {}
+static inline void esp_shm_flash_remove(struct esp_shm_flash *flash) {}
+#endif
+
+#endif /* _ESP_SHM_FLASH_H */
diff --git a/drivers/nvmem/esp32s31-efuse.c b/drivers/nvmem/esp32s31-efuse.c
new file mode 100644
--- /dev/null
+++ b/drivers/nvmem/esp32s31-efuse.c
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Author: Marco Mueller <hello@annoyedmilk.ch>
+ *
+ * ESP32-S31 eFuse, read only
+ *
+ * The eFuse controller shows the eFuse blocks in its read registers.  The
+ * nvmem offset is the register offset.  BLK1 has the factory MAC address in
+ * the bytes 0x50 to 0x55, in the reverse order.
+ */
+
+#include <linux/etherdevice.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/nvmem-provider.h>
+#include <linux/platform_device.h>
+
+struct esp32s31_efuse {
+	void __iomem *base;
+};
+
+static int esp32s31_efuse_read(void *context, unsigned int offset, void *val,
+			       size_t bytes)
+{
+	struct esp32s31_efuse *efuse = context;
+	u8 *buf = val;
+
+	/* The registers take 32-bit reads only. */
+	for (; bytes; bytes--, offset++)
+		*buf++ = readl(efuse->base + (offset & ~3)) >> (8 * (offset & 3));
+
+	return 0;
+}
+
+/*
+ * The cell argument selects the address as ESP-IDF makes it from the factory
+ * address, with two universal addresses for each chip: 0 Wi-Fi station,
+ * 1 Wi-Fi access point, 2 Bluetooth, 3 Ethernet.  The odd ones are the
+ * locally administered form of the even ones.
+ */
+static int esp32s31_efuse_mac_pp(void *context, const char *id, int index,
+				 unsigned int offset, void *data, size_t bytes)
+{
+	u8 *mac = data;
+	u8 universal;
+	int i;
+
+	if (bytes != ETH_ALEN || index < 0 || index > 3)
+		return -EINVAL;
+
+	for (i = 0; i < ETH_ALEN / 2; i++)
+		swap(mac[i], mac[ETH_ALEN - 1 - i]);
+
+	mac[5] += index / 2;
+	if (index & 1) {
+		universal = mac[0];
+		mac[0] |= 0x02;
+		if (mac[0] == universal)
+			mac[0] ^= 0x04;
+	}
+
+	return 0;
+}
+
+static void esp32s31_efuse_fixup_cell_info(struct nvmem_device *nvmem,
+					   struct nvmem_cell_info *cell)
+{
+	if (cell->name && !strcmp(cell->name, "mac-address"))
+		cell->read_post_process = esp32s31_efuse_mac_pp;
+}
+
+static int esp32s31_efuse_probe(struct platform_device *pdev)
+{
+	struct nvmem_config config = {
+		.name = "esp32s31-efuse",
+		.id = NVMEM_DEVID_NONE,
+		.owner = THIS_MODULE,
+		.read_only = true,
+		.root_only = true,
+		.word_size = 1,
+		.stride = 1,
+		.reg_read = esp32s31_efuse_read,
+		.fixup_dt_cell_info = esp32s31_efuse_fixup_cell_info,
+	};
+	struct device *dev = &pdev->dev;
+	struct esp32s31_efuse *efuse;
+	struct resource *res;
+
+	efuse = devm_kzalloc(dev, sizeof(*efuse), GFP_KERNEL);
+	if (!efuse)
+		return -ENOMEM;
+
+	efuse->base = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(efuse->base))
+		return PTR_ERR(efuse->base);
+
+	config.dev = dev;
+	config.priv = efuse;
+	config.size = resource_size(res);
+
+	return PTR_ERR_OR_ZERO(devm_nvmem_register(dev, &config));
+}
+
+static const struct of_device_id esp32s31_efuse_of_match[] = {
+	{ .compatible = "esp,esp32s31-efuse" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, esp32s31_efuse_of_match);
+
+static struct platform_driver esp32s31_efuse_driver = {
+	.driver = {
+		.name = "esp32s31-efuse",
+		.of_match_table = esp32s31_efuse_of_match,
+	},
+	.probe = esp32s31_efuse_probe,
+};
+module_platform_driver(esp32s31_efuse_driver);
+
+MODULE_DESCRIPTION("ESP32-S31 eFuse driver");
+MODULE_AUTHOR("Marco Mueller <hello@annoyedmilk.ch>");
+MODULE_LICENSE("GPL");
diff --git a/drivers/phy/phy-esp32s31-usb.c b/drivers/phy/phy-esp32s31-usb.c
new file mode 100644
--- /dev/null
+++ b/drivers/phy/phy-esp32s31-usb.c
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ESP32-S31 integrated USB 2.0 UTMI PHY
+ *
+ * The register sequence is the same as ESP-IDF usb_utmi_hal_init() and
+ * usb_phy_otg_set_mode(..., USB_OTG_MODE_HOST).  The PHY and the DWC2 core
+ * use the same clock and reset controls, so this provider sets both.
+ */
+
+#include <linux/bitops.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+
+/* HP_SYS_CLKRST_USB_OTGHS_CTRL0 */
+#define ESP32S31_USB_APB_CLK_EN		BIT(0)
+#define ESP32S31_USB_SYS_CLK_EN		BIT(1)
+
+/* CNNT_SYS_USB_OTG20_CTRL */
+#define ESP32S31_USB_UTMIFS_CLK_EN	BIT(23)
+#define ESP32S31_USB_PHYREF_CLK_EN	BIT(27)
+#define ESP32S31_USB_PHY_RST_EN		BIT(29)
+#define ESP32S31_USB_AHB_RST_EN		BIT(30)
+#define ESP32S31_USB_APB_RST_EN		BIT(31)
+#define ESP32S31_USB_ALL_RST_EN		(ESP32S31_USB_PHY_RST_EN | \
+					 ESP32S31_USB_AHB_RST_EN | \
+					 ESP32S31_USB_APB_RST_EN)
+
+/* HP_ALIVE_SYS_USB_CTRL */
+#define ESP32S31_USB_DM_PULLDOWN		BIT(2)
+#define ESP32S31_USB_DP_PULLDOWN		BIT(3)
+
+/* HP_ALIVE_SYS_USB_OTGHS_CTRL */
+#define ESP32S31_USB_PHY_PLL_FORCE_EN	BIT(0)
+#define ESP32S31_USB_PHY_SUSPEND_FORCE_EN BIT(2)
+#define ESP32S31_USB_PHY_OTG_SUSPENDM	BIT(7)
+
+/* USB_UTMI_FC_06 */
+#define ESP32S31_USB_LS_PARALLEL_EN	BIT(0)
+#define ESP32S31_USB_LS_KEEPALIVE_EN	BIT(3)
+
+struct esp32s31_usb_phy {
+	void __iomem *clkrst;
+	void __iomem *cnnt;
+	void __iomem *usb_ctrl;
+	void __iomem *otghs_ctrl;
+	void __iomem *utmi_fc06;
+};
+
+static void esp32s31_usb_set_bits(void __iomem *reg, u32 bits, bool on)
+{
+	u32 val = readl(reg);
+
+	writel(on ? val | bits : val & ~bits, reg);
+}
+
+static int esp32s31_usb_phy_init(struct phy *phy)
+{
+	struct esp32s31_usb_phy *priv = phy_get_drvdata(phy);
+	u32 val;
+
+	/* Enable the DWC2 APB and system clocks, and the UTMI and reference clocks. */
+	esp32s31_usb_set_bits(priv->clkrst,
+			      ESP32S31_USB_APB_CLK_EN |
+			      ESP32S31_USB_SYS_CLK_EN, true);
+	esp32s31_usb_set_bits(priv->cnnt,
+			      ESP32S31_USB_UTMIFS_CLK_EN |
+			      ESP32S31_USB_PHYREF_CLK_EN, true);
+
+	/* DWC2 controls the PHY suspend and the PLL state. */
+	esp32s31_usb_set_bits(priv->otghs_ctrl,
+			      ESP32S31_USB_PHY_PLL_FORCE_EN |
+			      ESP32S31_USB_PHY_SUSPEND_FORCE_EN, false);
+
+	/* Set all resets.  Then release the PHY before the AHB and APB core. */
+	val = readl(priv->cnnt) | ESP32S31_USB_ALL_RST_EN;
+	writel(val, priv->cnnt);
+	val &= ~ESP32S31_USB_PHY_RST_EN;
+	writel(val, priv->cnnt);
+	val &= ~(ESP32S31_USB_AHB_RST_EN | ESP32S31_USB_APB_RST_EN);
+	writel(val, priv->cnnt);
+
+	/* Use the same UTMI setup as ESP-IDF on the ESP32-S31. */
+	esp32s31_usb_set_bits(priv->otghs_ctrl,
+			      ESP32S31_USB_PHY_OTG_SUSPENDM, true);
+	esp32s31_usb_set_bits(priv->utmi_fc06,
+			      ESP32S31_USB_LS_PARALLEL_EN |
+			      ESP32S31_USB_LS_KEEPALIVE_EN, true);
+
+	/* Host mode needs 15 kohm pull-downs on the two data lines. */
+	esp32s31_usb_set_bits(priv->usb_ctrl,
+			      ESP32S31_USB_DM_PULLDOWN |
+			      ESP32S31_USB_DP_PULLDOWN, true);
+
+	return 0;
+}
+
+static int esp32s31_usb_phy_exit(struct phy *phy)
+{
+	struct esp32s31_usb_phy *priv = phy_get_drvdata(phy);
+
+	esp32s31_usb_set_bits(priv->usb_ctrl,
+			      ESP32S31_USB_DM_PULLDOWN |
+			      ESP32S31_USB_DP_PULLDOWN, false);
+	esp32s31_usb_set_bits(priv->cnnt,
+			      ESP32S31_USB_UTMIFS_CLK_EN |
+			      ESP32S31_USB_PHYREF_CLK_EN, false);
+	esp32s31_usb_set_bits(priv->clkrst,
+			      ESP32S31_USB_APB_CLK_EN |
+			      ESP32S31_USB_SYS_CLK_EN, false);
+
+	return 0;
+}
+
+static const struct phy_ops esp32s31_usb_phy_ops = {
+	.init = esp32s31_usb_phy_init,
+	.exit = esp32s31_usb_phy_exit,
+	.owner = THIS_MODULE,
+};
+
+static int esp32s31_usb_phy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct phy_provider *provider;
+	struct esp32s31_usb_phy *priv;
+	struct phy *phy;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->clkrst = devm_platform_ioremap_resource_byname(pdev, "clkrst");
+	if (IS_ERR(priv->clkrst))
+		return PTR_ERR(priv->clkrst);
+	priv->cnnt = devm_platform_ioremap_resource_byname(pdev, "cnnt");
+	if (IS_ERR(priv->cnnt))
+		return PTR_ERR(priv->cnnt);
+	priv->usb_ctrl = devm_platform_ioremap_resource_byname(pdev, "usb-ctrl");
+	if (IS_ERR(priv->usb_ctrl))
+		return PTR_ERR(priv->usb_ctrl);
+	priv->otghs_ctrl = devm_platform_ioremap_resource_byname(pdev,
+								 "otghs-ctrl");
+	if (IS_ERR(priv->otghs_ctrl))
+		return PTR_ERR(priv->otghs_ctrl);
+	priv->utmi_fc06 = devm_platform_ioremap_resource_byname(pdev,
+								"utmi-fc06");
+	if (IS_ERR(priv->utmi_fc06))
+		return PTR_ERR(priv->utmi_fc06);
+
+	phy = devm_phy_create(dev, NULL, &esp32s31_usb_phy_ops);
+	if (IS_ERR(phy))
+		return PTR_ERR(phy);
+
+	phy_set_drvdata(phy, priv);
+	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id esp32s31_usb_phy_of_match[] = {
+	{ .compatible = "esp,esp32s31-usb-phy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, esp32s31_usb_phy_of_match);
+
+static struct platform_driver esp32s31_usb_phy_driver = {
+	.probe = esp32s31_usb_phy_probe,
+	.driver = {
+		.name = "esp32s31-usb-phy",
+		.of_match_table = esp32s31_usb_phy_of_match,
+	},
+};
+module_platform_driver(esp32s31_usb_phy_driver);
+
+MODULE_DESCRIPTION("Espressif ESP32-S31 USB 2.0 UTMI PHY driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/pinctrl/pinctrl-esp32s31.c b/drivers/pinctrl/pinctrl-esp32s31.c
new file mode 100644
--- /dev/null
+++ b/drivers/pinctrl/pinctrl-esp32s31.c
@@ -0,0 +1,490 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Author: Marco Mueller <hello@annoyedmilk.ch>
+ *
+ * ESP32-S31 pin controller and GPIO controller
+ *
+ * Two blocks connect a pin to its pad.  The IO MUX selects the function of
+ * the pin: a peripheral directly, or function 1, the GPIO matrix.  The GPIO
+ * matrix connects a peripheral signal or the GPIO registers to the pin.  The
+ * GPIO registers are in the block of the matrix, so one driver has both.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+#include <linux/gpio/driver.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+
+#include <linux/pinctrl/pinconf-generic.h>
+#include <linux/pinctrl/pinconf.h>
+#include <linux/pinctrl/pinctrl.h>
+#include <linux/pinctrl/pinmux.h>
+
+#include "core.h"
+#include "pinconf.h"
+#include "pinctrl-utils.h"
+#include "pinmux.h"
+
+#define ESP32S31_GPIO_OUT_W1TS		0x08
+#define ESP32S31_GPIO_OUT_W1TC		0x0c
+#define ESP32S31_GPIO_OUT1_W1TS		0x14
+#define ESP32S31_GPIO_OUT1_W1TC		0x18
+#define ESP32S31_GPIO_ENABLE		0x34
+#define ESP32S31_GPIO_ENABLE_W1TS	0x38
+#define ESP32S31_GPIO_ENABLE_W1TC	0x3c
+#define ESP32S31_GPIO_ENABLE1		0x40
+#define ESP32S31_GPIO_ENABLE1_W1TS	0x44
+#define ESP32S31_GPIO_ENABLE1_W1TC	0x48
+#define ESP32S31_GPIO_IN		0x64
+#define ESP32S31_GPIO_IN1		0x68
+#define ESP32S31_GPIO_PIN(n)		(0xf4 + (n) * 4)
+#define ESP32S31_GPIO_FUNC_IN_SEL(s)	(0x2f4 + (s) * 4)
+#define ESP32S31_GPIO_FUNC_OUT_SEL(n)	(0xaf4 + (n) * 4)
+
+#define ESP32S31_PIN_PAD_DRIVER		BIT(2)
+#define ESP32S31_IN_SEL_MATRIX		BIT(9)
+/* The reset value: the signal comes from the IO MUX. */
+#define ESP32S31_IN_SEL_IOMUX		0x80
+/* The matrix sends the GPIO registers, not a peripheral signal. */
+#define ESP32S31_SIG_GPIO_OUT		256
+
+#define ESP32S31_IOMUX_FUN_WPD		BIT(7)
+#define ESP32S31_IOMUX_FUN_WPU		BIT(8)
+#define ESP32S31_IOMUX_FUN_IE		BIT(9)
+#define ESP32S31_IOMUX_FUN_DRV		GENMASK(11, 10)
+#define ESP32S31_IOMUX_MCU_SEL		GENMASK(14, 12)
+#define ESP32S31_FUNC_GPIO		1
+
+/* The low 16 bits of a "pinmux" cell, see dt-bindings/pinctrl/esp32s31-pinctrl.h. */
+#define ESP32S31_MUX_SIG		GENMASK(8, 0)
+#define ESP32S31_MUX_IN			BIT(9)
+#define ESP32S31_MUX_OUT		BIT(10)
+#define ESP32S31_MUX_FUNC		GENMASK(13, 11)
+
+#define ESP32S31_NPINS			62
+#define ESP32S31_NSIGS			256
+
+/* FUN_DRV 0 to 3 */
+static const u32 esp32s31_drive_ma[] = { 5, 10, 20, 40 };
+
+struct esp32s31_pinctrl {
+	struct pinctrl_desc desc;
+	struct pinctrl_dev *pctl;
+	struct gpio_chip chip;
+	void __iomem *iomux;
+	void __iomem *gpio;
+	raw_spinlock_t lock;
+};
+
+static void esp32s31_iomux_rmw(struct esp32s31_pinctrl *pctrl,
+			       unsigned int pin, u32 clr, u32 set)
+{
+	void __iomem *reg = pctrl->iomux + pin * 4;
+
+	guard(raw_spinlock_irqsave)(&pctrl->lock);
+	writel((readl(reg) & ~clr) | set, reg);
+}
+
+/* Bank 1 has pins 32 and higher, at a fixed offset from bank 0. */
+static unsigned int esp32s31_bank(unsigned int pin, unsigned int reg0,
+				  unsigned int reg1)
+{
+	return pin < 32 ? reg0 : reg1;
+}
+
+static int esp32s31_mux_one(struct esp32s31_pinctrl *pctrl, unsigned int pin,
+			    u32 mux)
+{
+	unsigned int func = FIELD_GET(ESP32S31_MUX_FUNC, mux);
+	unsigned int sig = FIELD_GET(ESP32S31_MUX_SIG, mux);
+	u32 set = FIELD_PREP(ESP32S31_IOMUX_MCU_SEL, func);
+	bool matrix = func == ESP32S31_FUNC_GPIO;
+
+	if (pin >= ESP32S31_NPINS || sig >= ESP32S31_NSIGS)
+		return -EINVAL;
+
+	if (mux & ESP32S31_MUX_IN) {
+		writel(matrix ? ESP32S31_IN_SEL_MATRIX | pin : ESP32S31_IN_SEL_IOMUX,
+		       pctrl->gpio + ESP32S31_GPIO_FUNC_IN_SEL(sig));
+		set |= ESP32S31_IOMUX_FUN_IE;
+	}
+	/* The peripheral drives the output enable of the pad. */
+	if (mux & ESP32S31_MUX_OUT)
+		writel(sig, pctrl->gpio + ESP32S31_GPIO_FUNC_OUT_SEL(pin));
+
+	esp32s31_iomux_rmw(pctrl, pin, ESP32S31_IOMUX_MCU_SEL, set);
+	return 0;
+}
+
+static int esp32s31_set_mux(struct pinctrl_dev *pctldev, unsigned int fsel,
+			    unsigned int gsel)
+{
+	struct esp32s31_pinctrl *pctrl = pinctrl_dev_get_drvdata(pctldev);
+	const struct group_desc *group;
+	const unsigned int *muxes;
+	unsigned int i;
+	int ret;
+
+	group = pinctrl_generic_get_group(pctldev, gsel);
+	if (!group)
+		return -EINVAL;
+
+	muxes = group->data;
+	for (i = 0; i < group->grp.npins; i++) {
+		ret = esp32s31_mux_one(pctrl, group->grp.pins[i], muxes[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/* Start as an input, with the GPIO registers on the matrix output. */
+static int esp32s31_gpio_request_enable(struct pinctrl_dev *pctldev,
+					struct pinctrl_gpio_range *range,
+					unsigned int pin)
+{
+	struct esp32s31_pinctrl *pctrl = pinctrl_dev_get_drvdata(pctldev);
+
+	writel(BIT(pin % 32), pctrl->gpio +
+	       esp32s31_bank(pin, ESP32S31_GPIO_ENABLE_W1TC,
+			     ESP32S31_GPIO_ENABLE1_W1TC));
+	writel(ESP32S31_SIG_GPIO_OUT,
+	       pctrl->gpio + ESP32S31_GPIO_FUNC_OUT_SEL(pin));
+	esp32s31_iomux_rmw(pctrl, pin, ESP32S31_IOMUX_MCU_SEL,
+			   FIELD_PREP(ESP32S31_IOMUX_MCU_SEL, ESP32S31_FUNC_GPIO) |
+			   ESP32S31_IOMUX_FUN_IE);
+	return 0;
+}
+
+static int esp32s31_pin_config_get(struct pinctrl_dev *pctldev,
+				   unsigned int pin, unsigned long *config)
+{
+	struct esp32s31_pinctrl *pctrl = pinctrl_dev_get_drvdata(pctldev);
+	enum pin_config_param param = pinconf_to_config_param(*config);
+	u32 iomux = readl(pctrl->iomux + pin * 4);
+	u32 pad = readl(pctrl->gpio + ESP32S31_GPIO_PIN(pin));
+	u32 arg = 1;
+	bool on;
+
+	switch (param) {
+	case PIN_CONFIG_BIAS_DISABLE:
+		on = !(iomux & (ESP32S31_IOMUX_FUN_WPU | ESP32S31_IOMUX_FUN_WPD));
+		break;
+	case PIN_CONFIG_BIAS_PULL_UP:
+		on = iomux & ESP32S31_IOMUX_FUN_WPU;
+		break;
+	case PIN_CONFIG_BIAS_PULL_DOWN:
+		on = iomux & ESP32S31_IOMUX_FUN_WPD;
+		break;
+	case PIN_CONFIG_INPUT_ENABLE:
+		on = iomux & ESP32S31_IOMUX_FUN_IE;
+		break;
+	case PIN_CONFIG_DRIVE_OPEN_DRAIN:
+		on = pad & ESP32S31_PIN_PAD_DRIVER;
+		break;
+	case PIN_CONFIG_DRIVE_PUSH_PULL:
+		on = !(pad & ESP32S31_PIN_PAD_DRIVER);
+		break;
+	case PIN_CONFIG_DRIVE_STRENGTH:
+		arg = esp32s31_drive_ma[FIELD_GET(ESP32S31_IOMUX_FUN_DRV, iomux)];
+		on = true;
+		break;
+	default:
+		return -ENOTSUPP;
+	}
+
+	if (!on)
+		return -EINVAL;
+
+	*config = pinconf_to_config_packed(param, arg);
+	return 0;
+}
+
+static int esp32s31_drive_field(u32 ma)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(esp32s31_drive_ma); i++)
+		if (esp32s31_drive_ma[i] == ma)
+			return FIELD_PREP(ESP32S31_IOMUX_FUN_DRV, i);
+
+	return -EINVAL;
+}
+
+static int esp32s31_config_one(struct esp32s31_pinctrl *pctrl, unsigned int pin,
+			       unsigned long config)
+{
+	u32 arg = pinconf_to_config_argument(config);
+	void __iomem *pad = pctrl->gpio + ESP32S31_GPIO_PIN(pin);
+	u32 pull = ESP32S31_IOMUX_FUN_WPU | ESP32S31_IOMUX_FUN_WPD;
+	int drv;
+
+	switch (pinconf_to_config_param(config)) {
+	case PIN_CONFIG_BIAS_DISABLE:
+		esp32s31_iomux_rmw(pctrl, pin, pull, 0);
+		break;
+	case PIN_CONFIG_BIAS_PULL_UP:
+		esp32s31_iomux_rmw(pctrl, pin, pull, ESP32S31_IOMUX_FUN_WPU);
+		break;
+	case PIN_CONFIG_BIAS_PULL_DOWN:
+		esp32s31_iomux_rmw(pctrl, pin, pull, ESP32S31_IOMUX_FUN_WPD);
+		break;
+	case PIN_CONFIG_INPUT_ENABLE:
+		esp32s31_iomux_rmw(pctrl, pin, ESP32S31_IOMUX_FUN_IE,
+				   arg ? ESP32S31_IOMUX_FUN_IE : 0);
+		break;
+	case PIN_CONFIG_DRIVE_STRENGTH:
+		drv = esp32s31_drive_field(arg);
+		if (drv < 0)
+			return drv;
+		esp32s31_iomux_rmw(pctrl, pin, ESP32S31_IOMUX_FUN_DRV, drv);
+		break;
+	case PIN_CONFIG_DRIVE_OPEN_DRAIN:
+	case PIN_CONFIG_DRIVE_PUSH_PULL: {
+		bool od = pinconf_to_config_param(config) == PIN_CONFIG_DRIVE_OPEN_DRAIN;
+
+		guard(raw_spinlock_irqsave)(&pctrl->lock);
+		writel((readl(pad) & ~ESP32S31_PIN_PAD_DRIVER) |
+		       (od ? ESP32S31_PIN_PAD_DRIVER : 0), pad);
+		break;
+	}
+	default:
+		return -ENOTSUPP;
+	}
+
+	return 0;
+}
+
+static int esp32s31_pin_config_set(struct pinctrl_dev *pctldev,
+				   unsigned int pin, unsigned long *configs,
+				   unsigned int num_configs)
+{
+	struct esp32s31_pinctrl *pctrl = pinctrl_dev_get_drvdata(pctldev);
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < num_configs; i++) {
+		ret = esp32s31_config_one(pctrl, pin, configs[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int esp32s31_pin_config_group_set(struct pinctrl_dev *pctldev,
+					 unsigned int gsel,
+					 unsigned long *configs,
+					 unsigned int num_configs)
+{
+	const struct group_desc *group;
+	unsigned int i;
+	int ret;
+
+	group = pinctrl_generic_get_group(pctldev, gsel);
+	if (!group)
+		return -EINVAL;
+
+	for (i = 0; i < group->grp.npins; i++) {
+		ret = esp32s31_pin_config_set(pctldev, group->grp.pins[i],
+					      configs, num_configs);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static const struct pinctrl_ops esp32s31_pctrl_ops = {
+	.get_groups_count	= pinctrl_generic_get_group_count,
+	.get_group_name		= pinctrl_generic_get_group_name,
+	.get_group_pins		= pinctrl_generic_get_group_pins,
+	.dt_node_to_map		= pinctrl_generic_pinmux_dt_node_to_map,
+	.dt_free_map		= pinctrl_utils_free_map,
+};
+
+static const struct pinmux_ops esp32s31_pmx_ops = {
+	.get_functions_count	= pinmux_generic_get_function_count,
+	.get_function_name	= pinmux_generic_get_function_name,
+	.get_function_groups	= pinmux_generic_get_function_groups,
+	.set_mux		= esp32s31_set_mux,
+	.gpio_request_enable	= esp32s31_gpio_request_enable,
+	.strict			= true,
+};
+
+static const struct pinconf_ops esp32s31_pinconf_ops = {
+	.pin_config_get		= esp32s31_pin_config_get,
+	.pin_config_set		= esp32s31_pin_config_set,
+	.pin_config_group_set	= esp32s31_pin_config_group_set,
+	.is_generic		= true,
+};
+
+static int esp32s31_gpio_set(struct gpio_chip *chip, unsigned int offset,
+			     int value)
+{
+	struct esp32s31_pinctrl *pctrl = gpiochip_get_data(chip);
+	unsigned int reg;
+
+	if (value)
+		reg = esp32s31_bank(offset, ESP32S31_GPIO_OUT_W1TS,
+				    ESP32S31_GPIO_OUT1_W1TS);
+	else
+		reg = esp32s31_bank(offset, ESP32S31_GPIO_OUT_W1TC,
+				    ESP32S31_GPIO_OUT1_W1TC);
+
+	/* Set and clear are different registers, so no lock is necessary. */
+	writel(BIT(offset % 32), pctrl->gpio + reg);
+	return 0;
+}
+
+static int esp32s31_gpio_get(struct gpio_chip *chip, unsigned int offset)
+{
+	struct esp32s31_pinctrl *pctrl = gpiochip_get_data(chip);
+	unsigned int reg = esp32s31_bank(offset, ESP32S31_GPIO_IN,
+					 ESP32S31_GPIO_IN1);
+
+	return !!(readl(pctrl->gpio + reg) & BIT(offset % 32));
+}
+
+static int esp32s31_gpio_get_direction(struct gpio_chip *chip,
+				       unsigned int offset)
+{
+	struct esp32s31_pinctrl *pctrl = gpiochip_get_data(chip);
+	unsigned int reg = esp32s31_bank(offset, ESP32S31_GPIO_ENABLE,
+					 ESP32S31_GPIO_ENABLE1);
+
+	if (readl(pctrl->gpio + reg) & BIT(offset % 32))
+		return GPIO_LINE_DIRECTION_OUT;
+
+	return GPIO_LINE_DIRECTION_IN;
+}
+
+static int esp32s31_gpio_direction_input(struct gpio_chip *chip,
+					 unsigned int offset)
+{
+	struct esp32s31_pinctrl *pctrl = gpiochip_get_data(chip);
+
+	writel(BIT(offset % 32), pctrl->gpio +
+	       esp32s31_bank(offset, ESP32S31_GPIO_ENABLE_W1TC,
+			     ESP32S31_GPIO_ENABLE1_W1TC));
+	return 0;
+}
+
+static int esp32s31_gpio_direction_output(struct gpio_chip *chip,
+					  unsigned int offset, int value)
+{
+	struct esp32s31_pinctrl *pctrl = gpiochip_get_data(chip);
+
+	/* Set the level before the output driver starts. */
+	esp32s31_gpio_set(chip, offset, value);
+	writel(BIT(offset % 32), pctrl->gpio +
+	       esp32s31_bank(offset, ESP32S31_GPIO_ENABLE_W1TS,
+			     ESP32S31_GPIO_ENABLE1_W1TS));
+	return 0;
+}
+
+static int esp32s31_gpio_set_config(struct gpio_chip *chip, unsigned int offset,
+				    unsigned long config)
+{
+	struct esp32s31_pinctrl *pctrl = gpiochip_get_data(chip);
+
+	return esp32s31_config_one(pctrl, offset, config);
+}
+
+static int esp32s31_pins_init(struct device *dev, struct pinctrl_desc *desc)
+{
+	struct pinctrl_pin_desc *pins;
+	unsigned int i;
+
+	pins = devm_kcalloc(dev, ESP32S31_NPINS, sizeof(*pins), GFP_KERNEL);
+	if (!pins)
+		return -ENOMEM;
+
+	for (i = 0; i < ESP32S31_NPINS; i++) {
+		pins[i].number = i;
+		pins[i].name = devm_kasprintf(dev, GFP_KERNEL, "GPIO%u", i);
+		if (!pins[i].name)
+			return -ENOMEM;
+	}
+
+	desc->pins = pins;
+	desc->npins = ESP32S31_NPINS;
+	return 0;
+}
+
+static int esp32s31_pinctrl_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct esp32s31_pinctrl *pctrl;
+	struct gpio_chip *chip;
+	int ret;
+
+	pctrl = devm_kzalloc(dev, sizeof(*pctrl), GFP_KERNEL);
+	if (!pctrl)
+		return -ENOMEM;
+
+	pctrl->iomux = devm_platform_ioremap_resource_byname(pdev, "iomux");
+	if (IS_ERR(pctrl->iomux))
+		return PTR_ERR(pctrl->iomux);
+
+	pctrl->gpio = devm_platform_ioremap_resource_byname(pdev, "gpio");
+	if (IS_ERR(pctrl->gpio))
+		return PTR_ERR(pctrl->gpio);
+
+	raw_spin_lock_init(&pctrl->lock);
+
+	ret = esp32s31_pins_init(dev, &pctrl->desc);
+	if (ret)
+		return ret;
+
+	pctrl->desc.name = dev_name(dev);
+	pctrl->desc.pctlops = &esp32s31_pctrl_ops;
+	pctrl->desc.pmxops = &esp32s31_pmx_ops;
+	pctrl->desc.confops = &esp32s31_pinconf_ops;
+	pctrl->desc.owner = THIS_MODULE;
+
+	ret = devm_pinctrl_register_and_init(dev, &pctrl->desc, pctrl,
+					     &pctrl->pctl);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register pinctrl\n");
+
+	ret = pinctrl_enable(pctrl->pctl);
+	if (ret)
+		return ret;
+
+	chip = &pctrl->chip;
+	chip->label = dev_name(dev);
+	chip->parent = dev;
+	chip->owner = THIS_MODULE;
+	chip->base = -1;
+	chip->ngpio = ESP32S31_NPINS;
+	chip->request = gpiochip_generic_request;
+	chip->free = gpiochip_generic_free;
+	chip->get = esp32s31_gpio_get;
+	chip->set = esp32s31_gpio_set;
+	chip->get_direction = esp32s31_gpio_get_direction;
+	chip->direction_input = esp32s31_gpio_direction_input;
+	chip->direction_output = esp32s31_gpio_direction_output;
+	chip->set_config = esp32s31_gpio_set_config;
+
+	return devm_gpiochip_add_data(dev, chip, pctrl);
+}
+
+static const struct of_device_id esp32s31_pinctrl_of_match[] = {
+	{ .compatible = "esp,esp32s31-pinctrl" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, esp32s31_pinctrl_of_match);
+
+static struct platform_driver esp32s31_pinctrl_driver = {
+	.driver = {
+		.name = "esp32s31-pinctrl",
+		.of_match_table = esp32s31_pinctrl_of_match,
+	},
+	.probe = esp32s31_pinctrl_probe,
+};
+builtin_platform_driver(esp32s31_pinctrl_driver);
diff --git a/drivers/tty/serial/esp32_uart.c b/drivers/tty/serial/esp32_uart.c
new file mode 100644
--- /dev/null
+++ b/drivers/tty/serial/esp32_uart.c
@@ -0,0 +1,658 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Author: Marco Müller <hello@annoyedmilk.ch>
+ *
+ * UART of the Espressif ESP32-S31.  It is the same block as on the
+ * ESP32-S3.  Based on the ESP32 UART driver by Max Filippov.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/console.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/serial_core.h>
+#include <linux/slab.h>
+#include <linux/tty_flip.h>
+#include <asm/serial.h>
+
+#define DRIVER_NAME	"esp32-uart"
+#define DEV_NAME	"ttyS"
+#define UART_NR		3
+
+#define ESP32_UART_TX_FIFO_SIZE	127
+
+#define UART_FIFO_REG			0x00
+#define UART_INT_ST_REG			0x08
+#define UART_INT_ENA_REG		0x0c
+#define UART_INT_CLR_REG		0x10
+#define UART_RXFIFO_FULL_INT			BIT(0)
+#define UART_TXFIFO_EMPTY_INT			BIT(1)
+#define UART_BRK_DET_INT			BIT(7)
+#define UART_CLKDIV_REG			0x14
+#define UART_CLKDIV				GENMASK(11, 0)
+#define UART_CLKDIV_FRAG			GENMASK(23, 20)
+#define UART_STATUS_REG			0x1c
+#define UART_RXFIFO_CNT				GENMASK(9, 0)
+#define UART_DSRN				BIT(13)
+#define UART_CTSN				BIT(14)
+#define UART_TXFIFO_CNT				GENMASK(25, 16)
+#define UART_CONF0_REG			0x20
+#define UART_PARITY				BIT(0)
+#define UART_PARITY_EN				BIT(1)
+#define UART_BIT_NUM				GENMASK(3, 2)
+#define UART_BIT_NUM_5				0
+#define UART_BIT_NUM_6				1
+#define UART_BIT_NUM_7				2
+#define UART_BIT_NUM_8				3
+#define UART_STOP_BIT_NUM			GENMASK(5, 4)
+#define UART_STOP_BIT_NUM_1			1
+#define UART_STOP_BIT_NUM_2			3
+#define UART_SW_RTS				BIT(6)
+#define UART_SW_DTR				BIT(7)
+#define UART_LOOPBACK				BIT(14)
+#define UART_RTS_INV				BIT(23)
+#define UART_DTR_INV				BIT(24)
+#define UART_CONF1_REG			0x24
+#define UART_RXFIFO_FULL_THRHD_SHIFT		0
+#define UART_TXFIFO_EMPTY_THRHD_SHIFT		10
+#define UART_RX_FLOW_EN				BIT(22)
+#define ESP32S3_UART_CLK_CONF_REG	0x78
+#define ESP32S3_UART_SCLK_DIV_NUM		GENMASK(19, 12)
+#define ESP32S3_UART_SCLK_SEL			GENMASK(21, 20)
+#define XTAL_CLK				3
+#define ESP32S3_UART_SCLK_EN			BIT(22)
+#define ESP32S3_UART_TX_SCLK_EN			BIT(24)
+#define ESP32S3_UART_RX_SCLK_EN			BIT(25)
+
+#define ESP32S3_UART_CLK_CONF_DEFAULT \
+	(ESP32S3_UART_RX_SCLK_EN | \
+	 ESP32S3_UART_TX_SCLK_EN | \
+	 ESP32S3_UART_SCLK_EN | \
+	 FIELD_PREP(ESP32S3_UART_SCLK_SEL, XTAL_CLK))
+
+struct esp32_port {
+	struct uart_port port;
+	struct clk *clk;
+};
+
+static const struct of_device_id esp32_uart_dt_ids[] = {
+	{ .compatible = "esp,esp32s3-uart" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, esp32_uart_dt_ids);
+
+static struct esp32_port *esp32_uart_ports[UART_NR];
+
+static void esp32_uart_write(struct uart_port *port, unsigned long reg, u32 v)
+{
+	writel(v, port->membase + reg);
+}
+
+static u32 esp32_uart_read(struct uart_port *port, unsigned long reg)
+{
+	return readl(port->membase + reg);
+}
+
+static u32 esp32_uart_tx_fifo_cnt(struct uart_port *port)
+{
+	u32 status = esp32_uart_read(port, UART_STATUS_REG);
+
+	return FIELD_GET(UART_TXFIFO_CNT, status);
+}
+
+static u32 esp32_uart_rx_fifo_cnt(struct uart_port *port)
+{
+	u32 status = esp32_uart_read(port, UART_STATUS_REG);
+
+	return FIELD_GET(UART_RXFIFO_CNT, status);
+}
+
+static unsigned int esp32_uart_tx_empty(struct uart_port *port)
+{
+	return esp32_uart_tx_fifo_cnt(port) ? 0 : TIOCSER_TEMT;
+}
+
+static void esp32_uart_set_mctrl(struct uart_port *port, unsigned int mctrl)
+{
+	u32 conf0 = esp32_uart_read(port, UART_CONF0_REG);
+
+	conf0 &= ~(UART_LOOPBACK |
+		   UART_SW_RTS | UART_RTS_INV |
+		   UART_SW_DTR | UART_DTR_INV);
+
+	if (mctrl & TIOCM_RTS)
+		conf0 |= UART_SW_RTS;
+	if (mctrl & TIOCM_DTR)
+		conf0 |= UART_SW_DTR;
+	if (mctrl & TIOCM_LOOP)
+		conf0 |= UART_LOOPBACK;
+
+	esp32_uart_write(port, UART_CONF0_REG, conf0);
+}
+
+static unsigned int esp32_uart_get_mctrl(struct uart_port *port)
+{
+	u32 status = esp32_uart_read(port, UART_STATUS_REG);
+	unsigned int ret = TIOCM_CAR;
+
+	if (status & UART_DSRN)
+		ret |= TIOCM_DSR;
+	if (status & UART_CTSN)
+		ret |= TIOCM_CTS;
+
+	return ret;
+}
+
+static void esp32_uart_stop_tx(struct uart_port *port)
+{
+	u32 int_ena;
+
+	int_ena = esp32_uart_read(port, UART_INT_ENA_REG);
+	int_ena &= ~UART_TXFIFO_EMPTY_INT;
+	esp32_uart_write(port, UART_INT_ENA_REG, int_ena);
+}
+
+static void esp32_uart_rxint(struct uart_port *port)
+{
+	struct tty_port *tty_port = &port->state->port;
+	u32 rx_fifo_cnt = esp32_uart_rx_fifo_cnt(port);
+	unsigned long flags;
+	u32 i;
+
+	if (!rx_fifo_cnt)
+		return;
+
+	spin_lock_irqsave(&port->lock, flags);
+
+	for (i = 0; i < rx_fifo_cnt; ++i) {
+		u32 rx = esp32_uart_read(port, UART_FIFO_REG);
+
+		if (!rx &&
+		    (esp32_uart_read(port, UART_INT_ST_REG) & UART_BRK_DET_INT)) {
+			esp32_uart_write(port, UART_INT_CLR_REG, UART_BRK_DET_INT);
+			++port->icount.brk;
+			uart_handle_break(port);
+		} else {
+			if (uart_handle_sysrq_char(port, (unsigned char)rx))
+				continue;
+			tty_insert_flip_char(tty_port, rx, TTY_NORMAL);
+			++port->icount.rx;
+		}
+	}
+	spin_unlock_irqrestore(&port->lock, flags);
+
+	tty_flip_buffer_push(tty_port);
+}
+
+static void esp32_uart_put_char(struct uart_port *port, u8 c)
+{
+	esp32_uart_write(port, UART_FIFO_REG, c);
+}
+
+static void esp32_uart_put_char_sync(struct uart_port *port, u8 c)
+{
+	unsigned long timeout = jiffies + HZ;
+
+	while (esp32_uart_tx_fifo_cnt(port) >= ESP32_UART_TX_FIFO_SIZE) {
+		if (time_after(jiffies, timeout)) {
+			dev_warn(port->dev, "timeout waiting for TX FIFO\n");
+			return;
+		}
+		cpu_relax();
+	}
+	esp32_uart_put_char(port, c);
+}
+
+static void esp32_uart_transmit_buffer(struct uart_port *port)
+{
+	u32 tx_fifo_used = esp32_uart_tx_fifo_cnt(port);
+	unsigned int pending;
+	u8 ch;
+
+	if (tx_fifo_used >= ESP32_UART_TX_FIFO_SIZE)
+		return;
+
+	pending = uart_port_tx_limited(port, ch,
+				       ESP32_UART_TX_FIFO_SIZE - tx_fifo_used,
+				       true, esp32_uart_put_char(port, ch),
+				       ({}));
+	if (pending) {
+		u32 int_ena;
+
+		int_ena = esp32_uart_read(port, UART_INT_ENA_REG);
+		int_ena |= UART_TXFIFO_EMPTY_INT;
+		esp32_uart_write(port, UART_INT_ENA_REG, int_ena);
+	}
+}
+
+static irqreturn_t esp32_uart_int(int irq, void *dev_id)
+{
+	struct uart_port *port = dev_id;
+	u32 status;
+
+	status = esp32_uart_read(port, UART_INT_ST_REG);
+
+	if (status & (UART_RXFIFO_FULL_INT | UART_BRK_DET_INT))
+		esp32_uart_rxint(port);
+	if (status & UART_TXFIFO_EMPTY_INT)
+		esp32_uart_transmit_buffer(port);
+
+	esp32_uart_write(port, UART_INT_CLR_REG, status);
+
+	return IRQ_RETVAL(status);
+}
+
+static void esp32_uart_stop_rx(struct uart_port *port)
+{
+	u32 int_ena;
+
+	int_ena = esp32_uart_read(port, UART_INT_ENA_REG);
+	int_ena &= ~UART_RXFIFO_FULL_INT;
+	esp32_uart_write(port, UART_INT_ENA_REG, int_ena);
+}
+
+static int esp32_uart_startup(struct uart_port *port)
+{
+	struct esp32_port *sport = container_of(port, struct esp32_port, port);
+	unsigned long flags;
+	int ret;
+
+	ret = clk_prepare_enable(sport->clk);
+	if (ret)
+		return ret;
+
+	ret = request_irq(port->irq, esp32_uart_int, 0, DRIVER_NAME, port);
+	if (ret) {
+		clk_disable_unprepare(sport->clk);
+		return ret;
+	}
+
+	spin_lock_irqsave(&port->lock, flags);
+	esp32_uart_write(port, ESP32S3_UART_CLK_CONF_REG,
+			 ESP32S3_UART_CLK_CONF_DEFAULT);
+	esp32_uart_write(port, UART_CONF1_REG,
+			 (1 << UART_RXFIFO_FULL_THRHD_SHIFT) |
+			 (1 << UART_TXFIFO_EMPTY_THRHD_SHIFT));
+	esp32_uart_write(port, UART_INT_CLR_REG, UART_RXFIFO_FULL_INT | UART_BRK_DET_INT);
+	esp32_uart_write(port, UART_INT_ENA_REG, UART_RXFIFO_FULL_INT | UART_BRK_DET_INT);
+	spin_unlock_irqrestore(&port->lock, flags);
+
+	return 0;
+}
+
+static void esp32_uart_shutdown(struct uart_port *port)
+{
+	struct esp32_port *sport = container_of(port, struct esp32_port, port);
+
+	esp32_uart_write(port, UART_INT_ENA_REG, 0);
+	free_irq(port->irq, port);
+	clk_disable_unprepare(sport->clk);
+}
+
+static bool esp32_uart_set_baud(struct uart_port *port, u32 baud)
+{
+	u32 sclk = port->uartclk;
+	u32 div = sclk / baud;
+	u32 sclk_div = div / UART_CLKDIV;
+
+	if (div > UART_CLKDIV) {
+		sclk /= (sclk_div + 1);
+		div = sclk / baud;
+	}
+	esp32_uart_write(port, ESP32S3_UART_CLK_CONF_REG,
+			 FIELD_PREP(ESP32S3_UART_SCLK_DIV_NUM, sclk_div) |
+			 ESP32S3_UART_CLK_CONF_DEFAULT);
+
+	if (div <= UART_CLKDIV) {
+		u32 frag = (sclk * 16) / baud - div * 16;
+
+		esp32_uart_write(port, UART_CLKDIV_REG,
+				 div | FIELD_PREP(UART_CLKDIV_FRAG, frag));
+		return true;
+	}
+
+	return false;
+}
+
+static void esp32_uart_set_termios(struct uart_port *port,
+				   struct ktermios *termios,
+				   const struct ktermios *old)
+{
+	unsigned long flags;
+	u32 conf0, conf1;
+	u32 max_div = UART_CLKDIV * FIELD_MAX(ESP32S3_UART_SCLK_DIV_NUM);
+	u32 baud;
+
+	termios->c_cflag &= ~CMSPAR;
+
+	baud = uart_get_baud_rate(port, termios, old,
+				  port->uartclk / max_div,
+				  port->uartclk / 16);
+
+	spin_lock_irqsave(&port->lock, flags);
+
+	conf0 = esp32_uart_read(port, UART_CONF0_REG);
+	conf0 &= ~(UART_PARITY_EN | UART_PARITY | UART_BIT_NUM | UART_STOP_BIT_NUM);
+
+	conf1 = esp32_uart_read(port, UART_CONF1_REG);
+	conf1 &= ~UART_RX_FLOW_EN;
+
+	if (termios->c_cflag & PARENB) {
+		conf0 |= UART_PARITY_EN;
+		if (termios->c_cflag & PARODD)
+			conf0 |= UART_PARITY;
+	}
+
+	switch (termios->c_cflag & CSIZE) {
+	case CS5:
+		conf0 |= FIELD_PREP(UART_BIT_NUM, UART_BIT_NUM_5);
+		break;
+	case CS6:
+		conf0 |= FIELD_PREP(UART_BIT_NUM, UART_BIT_NUM_6);
+		break;
+	case CS7:
+		conf0 |= FIELD_PREP(UART_BIT_NUM, UART_BIT_NUM_7);
+		break;
+	case CS8:
+		conf0 |= FIELD_PREP(UART_BIT_NUM, UART_BIT_NUM_8);
+		break;
+	}
+
+	if (termios->c_cflag & CSTOPB)
+		conf0 |= FIELD_PREP(UART_STOP_BIT_NUM, UART_STOP_BIT_NUM_2);
+	else
+		conf0 |= FIELD_PREP(UART_STOP_BIT_NUM, UART_STOP_BIT_NUM_1);
+
+	if (termios->c_cflag & CRTSCTS)
+		conf1 |= UART_RX_FLOW_EN;
+
+	esp32_uart_write(port, UART_CONF0_REG, conf0);
+	esp32_uart_write(port, UART_CONF1_REG, conf1);
+
+	if (baud) {
+		esp32_uart_set_baud(port, baud);
+		uart_update_timeout(port, termios->c_cflag, baud);
+	} else {
+		if (esp32_uart_set_baud(port, 115200)) {
+			baud = 115200;
+			tty_termios_encode_baud_rate(termios, baud, baud);
+			uart_update_timeout(port, termios->c_cflag, baud);
+		} else {
+			dev_warn(port->dev,
+				 "unable to set speed to %d baud or the default 115200\n",
+				 baud);
+		}
+	}
+	spin_unlock_irqrestore(&port->lock, flags);
+}
+
+static const char *esp32_uart_type(struct uart_port *port)
+{
+	return "ESP32S3 UART";
+}
+
+static void esp32_uart_config_port(struct uart_port *port, int flags)
+{
+	if (flags & UART_CONFIG_TYPE)
+		port->type = PORT_GENERIC;
+}
+
+#ifdef CONFIG_CONSOLE_POLL
+static int esp32_uart_poll_init(struct uart_port *port)
+{
+	struct esp32_port *sport = container_of(port, struct esp32_port, port);
+
+	return clk_prepare_enable(sport->clk);
+}
+
+static int esp32_uart_poll_get_char(struct uart_port *port)
+{
+	if (esp32_uart_rx_fifo_cnt(port))
+		return esp32_uart_read(port, UART_FIFO_REG);
+	else
+		return NO_POLL_CHAR;
+}
+#endif
+
+static const struct uart_ops esp32_uart_pops = {
+	.tx_empty	= esp32_uart_tx_empty,
+	.set_mctrl	= esp32_uart_set_mctrl,
+	.get_mctrl	= esp32_uart_get_mctrl,
+	.stop_tx	= esp32_uart_stop_tx,
+	.start_tx	= esp32_uart_transmit_buffer,
+	.stop_rx	= esp32_uart_stop_rx,
+	.startup	= esp32_uart_startup,
+	.shutdown	= esp32_uart_shutdown,
+	.set_termios	= esp32_uart_set_termios,
+	.type		= esp32_uart_type,
+	.config_port	= esp32_uart_config_port,
+#ifdef CONFIG_CONSOLE_POLL
+	.poll_init	= esp32_uart_poll_init,
+	.poll_put_char	= esp32_uart_put_char_sync,
+	.poll_get_char	= esp32_uart_poll_get_char,
+#endif
+};
+
+static void
+esp32_uart_console_write(struct console *co, const char *s, unsigned int count)
+{
+	struct esp32_port *sport = esp32_uart_ports[co->index];
+	struct uart_port *port = &sport->port;
+	unsigned long flags;
+	bool locked = true;
+
+	if (port->sysrq)
+		locked = false;
+	else if (oops_in_progress)
+		locked = spin_trylock_irqsave(&port->lock, flags);
+	else
+		spin_lock_irqsave(&port->lock, flags);
+
+	uart_console_write(port, s, count, esp32_uart_put_char_sync);
+
+	if (locked)
+		spin_unlock_irqrestore(&port->lock, flags);
+}
+
+static int __init esp32_uart_console_setup(struct console *co, char *options)
+{
+	struct esp32_port *sport;
+	int baud = 115200;
+	int bits = 8;
+	int parity = 'n';
+	int flow = 'n';
+	int ret;
+
+	if (co->index == -1 || co->index >= ARRAY_SIZE(esp32_uart_ports))
+		co->index = 0;
+
+	sport = esp32_uart_ports[co->index];
+	if (!sport)
+		return -ENODEV;
+
+	ret = clk_prepare_enable(sport->clk);
+	if (ret)
+		return ret;
+
+	if (options)
+		uart_parse_options(options, &baud, &parity, &bits, &flow);
+
+	return uart_set_options(&sport->port, co, baud, parity, bits, flow);
+}
+
+static int esp32_uart_console_exit(struct console *co)
+{
+	struct esp32_port *sport = esp32_uart_ports[co->index];
+
+	clk_disable_unprepare(sport->clk);
+	return 0;
+}
+
+static struct uart_driver esp32_uart_reg;
+static struct console esp32_uart_console = {
+	.name		= DEV_NAME,
+	.write		= esp32_uart_console_write,
+	.device		= uart_console_device,
+	.setup		= esp32_uart_console_setup,
+	.exit		= esp32_uart_console_exit,
+	.flags		= CON_PRINTBUFFER,
+	.index		= -1,
+	.data		= &esp32_uart_reg,
+};
+
+static void esp32_uart_earlycon_write(struct console *con, const char *s,
+				      unsigned int n)
+{
+	struct earlycon_device *dev = con->data;
+
+	uart_console_write(&dev->port, s, n, esp32_uart_put_char_sync);
+}
+
+#ifdef CONFIG_CONSOLE_POLL
+static int esp32_uart_earlycon_read(struct console *con, char *s, unsigned int n)
+{
+	struct earlycon_device *dev = con->data;
+	unsigned int num_read = 0;
+
+	while (num_read < n) {
+		int c = esp32_uart_poll_get_char(&dev->port);
+
+		if (c == NO_POLL_CHAR)
+			break;
+		s[num_read++] = c;
+	}
+	return num_read;
+}
+#endif
+
+static int __init esp32s3_uart_early_console_setup(struct earlycon_device *device,
+						   const char *options)
+{
+	if (!device->port.membase)
+		return -ENODEV;
+
+	device->con->write = esp32_uart_earlycon_write;
+#ifdef CONFIG_CONSOLE_POLL
+	device->con->read = esp32_uart_earlycon_read;
+#endif
+	if (device->port.uartclk != BASE_BAUD * 16)
+		esp32_uart_set_baud(&device->port, device->baud);
+
+	return 0;
+}
+
+OF_EARLYCON_DECLARE(esp32s3uart, "esp,esp32s3-uart",
+		    esp32s3_uart_early_console_setup);
+
+static struct uart_driver esp32_uart_reg = {
+	.owner		= THIS_MODULE,
+	.driver_name	= DRIVER_NAME,
+	.dev_name	= DEV_NAME,
+	.nr		= ARRAY_SIZE(esp32_uart_ports),
+	.cons		= &esp32_uart_console,
+};
+
+static int esp32_uart_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct uart_port *port;
+	struct esp32_port *sport;
+	struct resource *res;
+	int ret;
+
+	sport = devm_kzalloc(&pdev->dev, sizeof(*sport), GFP_KERNEL);
+	if (!sport)
+		return -ENOMEM;
+
+	port = &sport->port;
+
+	ret = of_alias_get_id(np, "serial");
+	if (ret < 0) {
+		dev_err(&pdev->dev, "failed to get alias id, errno %d\n", ret);
+		return ret;
+	}
+	if (ret >= UART_NR) {
+		dev_err(&pdev->dev, "driver limited to %d serial ports\n", UART_NR);
+		return -ENOMEM;
+	}
+
+	port->line = ret;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -ENODEV;
+
+	port->mapbase = res->start;
+	port->membase = devm_ioremap_resource(&pdev->dev, res);
+	if (IS_ERR(port->membase))
+		return PTR_ERR(port->membase);
+
+	sport->clk = devm_clk_get(&pdev->dev, NULL);
+	if (IS_ERR(sport->clk))
+		return PTR_ERR(sport->clk);
+
+	port->uartclk = clk_get_rate(sport->clk);
+	port->dev = &pdev->dev;
+	port->type = PORT_GENERIC;
+	port->iotype = UPIO_MEM;
+	port->irq = platform_get_irq(pdev, 0);
+	port->ops = &esp32_uart_pops;
+	port->flags = UPF_BOOT_AUTOCONF;
+	port->has_sysrq = 1;
+	port->fifosize = ESP32_UART_TX_FIFO_SIZE;
+	esp32_uart_ports[port->line] = sport;
+
+	platform_set_drvdata(pdev, port);
+
+	return uart_add_one_port(&esp32_uart_reg, port);
+}
+
+static void esp32_uart_remove(struct platform_device *pdev)
+{
+	struct uart_port *port = platform_get_drvdata(pdev);
+
+	uart_remove_one_port(&esp32_uart_reg, port);
+}
+
+static struct platform_driver esp32_uart_driver = {
+	.probe		= esp32_uart_probe,
+	.remove		= esp32_uart_remove,
+	.driver		= {
+		.name	= DRIVER_NAME,
+		.of_match_table	= esp32_uart_dt_ids,
+	},
+};
+
+static int __init esp32_uart_init(void)
+{
+	int ret;
+
+	ret = uart_register_driver(&esp32_uart_reg);
+	if (ret)
+		return ret;
+
+	ret = platform_driver_register(&esp32_uart_driver);
+	if (ret)
+		uart_unregister_driver(&esp32_uart_reg);
+
+	return ret;
+}
+
+static void __exit esp32_uart_exit(void)
+{
+	platform_driver_unregister(&esp32_uart_driver);
+	uart_unregister_driver(&esp32_uart_reg);
+}
+
+module_init(esp32_uart_init);
+module_exit(esp32_uart_exit);
+
+MODULE_AUTHOR("Max Filippov <jcmvbkbc@gmail.com>");
+MODULE_DESCRIPTION("Espressif ESP32 UART support");
+MODULE_LICENSE("GPL");
