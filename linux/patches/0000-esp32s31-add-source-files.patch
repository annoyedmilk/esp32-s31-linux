+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/esp,esp32s31-gmac.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 DWMAC glue layer
+
+maintainers:
+  - Roan Brand <brandroan@gmail.com>
+
+description: >
+  The DesignWare GMAC 3.70a of the ESP32-S31, with RGMII. The firmware sets
+  the pins, clocks, reset and interface mode. The operating system sets the
+  divider of the TX clock for the link speed.
+
+select:
+  properties:
+    compatible:
+      contains:
+        const: esp,esp32s31-gmac
+  required:
+    - compatible
+
+properties:
+  compatible:
+    items:
+      - const: esp,esp32s31-gmac
+      - const: snps,dwmac-3.70a
+
+  reg:
+    items:
+      - description: MAC and DMA registers
+      - description: HP_EMAC_REF_CTRL, the TX clock divider
+
+  reg-names:
+    items:
+      - const: stmmaceth
+      - const: tx-clk
+
+  clocks:
+    items:
+      - description: Bus clock, which also makes the MDC clock
+      - description: MPLL, the source of the TX clock
+
+  clock-names:
+    items:
+      - const: stmmaceth
+      - const: mpll
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-names:
+    const: macirq
+
+  phy-mode:
+    enum:
+      - rgmii
+      - rgmii-id
+      - rgmii-rxid
+      - rgmii-txid
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - interrupts
+  - interrupt-names
+
+allOf:
+  - $ref: snps,dwmac.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    ethernet@20350000 {
+      compatible = "esp,esp32s31-gmac", "snps,dwmac-3.70a";
+      reg = <0x20350000 0x4000>, <0x20359040 0x4>;
+      reg-names = "stmmaceth", "tx-clk";
+      interrupt-parent = <&clic>;
+      interrupts = <36 98 IRQ_TYPE_LEVEL_HIGH>;
+      interrupt-names = "macirq";
+      clocks = <&sys_clk>, <&mpll>;
+      clock-names = "stmmaceth", "mpll";
+      phy-mode = "rgmii-id";
+      snps,pbl = <16>;
+      snps,no-pbl-x8;
+      snps,force_thresh_dma_mode;
+    };
diff --git a/Documentation/devicetree/bindings/net/wireless/esp,esp32s31-hosted-shm.yaml b/Documentation/devicetree/bindings/net/wireless/esp,esp32s31-hosted-shm.yaml
