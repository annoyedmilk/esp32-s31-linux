@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/wireless/esp,esp32s31-hosted-shm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 ESP-Hosted shared-memory transport
+
+maintainers:
+  - Marco Müller <hello@annoyedmilk.ch>
+
+description: >
+  The ESP-Hosted firmware on the hart that does not run Linux controls the
+  WLAN modem of the ESP32-S31. Linux is the ESP-Hosted host. The two sides
+  send ESP-Hosted frames through two byte rings in internal SRAM. One
+  cross-core interrupt register signals each direction. Linux sets the
+  first. The firmware sets the second and Linux clears it. The firmware
+  also maps a window of the SPI flash for Linux to read, and programs and
+  erases it for Linux, which cannot drive the flash itself.
+
+properties:
+  compatible:
+    const: esp,esp32s31-hosted-shm
+
+  reg:
+    items:
+      - description: shared ring region in internal SRAM
+      - description: cross-core doorbell register pair
+
+  reg-names:
+    items:
+      - const: shm
+      - const: doorbell
+
+  interrupts:
+    maxItems: 1
+    description: doorbell that the firmware sets when it adds frames
+
+  flash:
+    type: object
+    description: >
+      The flash window of the firmware, as an MTD device. Its partitions
+      node describes the layout of the window.
+    properties:
+      partitions:
+        type: object
+        $ref: /schemas/mtd/partitions/partitions.yaml
+    additionalProperties: false
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    wifi@2f050000 {
+        compatible = "esp,esp32s31-hosted-shm";
+        reg = <0x2f050000 0xd000>, <0x20586014 0x8>;
+        reg-names = "shm", "doorbell";
+        interrupt-parent = <&clic>;
+        interrupts = <35 67 4>;
+    };
