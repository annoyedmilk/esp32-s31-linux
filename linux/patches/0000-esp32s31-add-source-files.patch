+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/wireless/esp,esp32s31-wifi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 WLAN modem
+
+maintainers:
+  - Marco Müller <hello@annoyedmilk.ch>
+
+description: >
+  ESP-IDF firmware on the hart that does not run Linux controls the WLAN
+  modem of the ESP32-S31. The firmware runs 802.11 and its supplicant. It
+  sends 802.3 frames, scan results and the association state through rings
+  of fixed-size slots in internal SRAM. At the start of that region, the
+  firmware writes its ring layout, protocol version, station MAC address and
+  association. One cross-core interrupt register signals each direction. The
+  firmware sets the first and Linux clears it. Linux sets the second.
+
+allOf:
+  - $ref: /schemas/net/network-class.yaml#
+
+properties:
+  compatible:
+    const: esp,esp32s31-wifi
+
+  reg:
+    items:
+      - description: shared ring region in internal SRAM
+      - description: cross-core doorbell register pair
+
+  reg-names:
+    items:
+      - const: ipc
+      - const: doorbell
+
+  interrupts:
+    maxItems: 1
+    description: doorbell that the firmware sets when it adds frames
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    wifi@2f050000 {
+        compatible = "esp,esp32s31-wifi";
+        reg = <0x2f050000 0x10000>, <0x20586014 0x8>;
+        reg-names = "ipc", "doorbell";
+        interrupt-parent = <&clic>;
+        interrupts = <35 67 4>;
+    };
