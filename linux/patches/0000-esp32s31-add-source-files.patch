diff --git a/arch/riscv/kernel/esp32s31-clic-trampoline.S b/arch/riscv/kernel/esp32s31-clic-trampoline.S
new file mode 100644
--- /dev/null
+++ b/arch/riscv/kernel/esp32s31-clic-trampoline.S
@@ -0,0 +1,326 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Author: Marco Müller <hello@annoyedmilk.ch>
+ *
+ * ESP32-S31 supervisor CLIC interrupt trampoline
+ *
+ * All supervisor CLIC interrupts come here through stvec, in non-vectored
+ * CLIC mode.  At entry, the hardware has set:
+ *
+ *     sepc         = PC of the interrupted code
+ *     scause       = interrupt ID and CLIC state
+ *     sstatus.SPIE = previous SIE
+ *     sstatus.SIE  = 0
+ *
+ * The trampoline:
+ *   1. Saves all registers in pt_regs on the stack
+ *   2. Sends a synchronous exception to its trap handler, or calls
+ *      do_irq(regs) with SIE disabled
+ *   3. Restores the registers and executes sret
+ *
+ * The Linux IRQ core runs hard IRQ handlers with CPU interrupts disabled.
+ * The ESP32-S31 CLIC can nest interrupts in hardware, but this trampoline
+ * gives Linux a usual IRQ entry without nesting.
+ */
+
+#include <linux/linkage.h>
+#include <asm/asm.h>
+#include <asm/csr.h>
+#include <asm/asm-offsets.h>
+
+	.text
+	/*
+	 * In CLIC mode, stvec.BASE is rounded down to a larger boundary.  Align
+	 * the entry to 64 bytes, so an interrupt cannot go into the function
+	 * before it.
+	 */
+	.balign 64
+
+/*
+ * Trampoline for all supervisor interrupts.  The register save area is a
+ * struct pt_regs, with the generated PT_* asm-offsets, as in entry.S.
+ */
+
+/* scause[23:16] is the CLIC previous-interrupt-level (spil) field. */
+#define CLIC_CAUSE_SPIL_MASK (0xff << 16)
+
+SYM_CODE_START(esp32s31_clic_trampoline)
+
+	/*
+	 * Use the same tp and scratch rules as handle_exception, before C code.
+	 * From user mode: CSR_SCRATCH = kernel tp and tp = user TLS.  From
+	 * kernel mode: CSR_SCRATCH = 0.
+	 */
+	csrrw	tp, CSR_SCRATCH, tp
+	bnez	tp, .Lclic_from_user
+
+.Lclic_from_kernel:
+	csrr	tp, CSR_SCRATCH
+	/* As handle_exception: first save the interrupted kernel stack. */
+	REG_S	sp, TASK_TI_KERNEL_SP(tp)
+
+.Lclic_from_user:
+	/*
+	 * Use thread_info.user_sp for the interrupted stack in the two cases.
+	 * For a kernel trap, TASK_TI_KERNEL_SP is now the current stack.  For a
+	 * user trap, it is the top of the kernel stack of the task.
+	 */
+	REG_S	sp, TASK_TI_USER_SP(tp)
+	REG_L	sp, TASK_TI_KERNEL_SP(tp)
+
+	/*
+	 * Save the interrupted context.
+	 *
+	 * Save all registers.  The caller-saved registers are necessary.  Save
+	 * the callee-saved registers too, so the C handler can call
+	 * schedule().
+	 */
+	addi	sp, sp, -PT_SIZE_ON_STACK
+
+	/* Save GPRs */
+	REG_S	ra,  PT_RA(sp)
+	REG_S	gp,  PT_GP(sp)
+	REG_S	t0,  PT_T0(sp)
+	REG_S	t1,  PT_T1(sp)
+	REG_S	t2,  PT_T2(sp)
+	REG_S	s0,  PT_S0(sp)
+	REG_S	s1,  PT_S1(sp)
+	REG_S	a0,  PT_A0(sp)
+	REG_S	a1,  PT_A1(sp)
+	REG_S	a2,  PT_A2(sp)
+	REG_S	a3,  PT_A3(sp)
+	REG_S	a4,  PT_A4(sp)
+	REG_S	a5,  PT_A5(sp)
+	REG_S	a6,  PT_A6(sp)
+	REG_S	a7,  PT_A7(sp)
+	REG_S	s2,  PT_S2(sp)
+	REG_S	s3,  PT_S3(sp)
+	REG_S	s4,  PT_S4(sp)
+	REG_S	s5,  PT_S5(sp)
+	REG_S	s6,  PT_S6(sp)
+	REG_S	s7,  PT_S7(sp)
+	REG_S	s8,  PT_S8(sp)
+	REG_S	s9,  PT_S9(sp)
+	REG_S	s10, PT_S10(sp)
+	REG_S	s11, PT_S11(sp)
+	REG_S	t3,  PT_T3(sp)
+	REG_S	t4,  PT_T4(sp)
+	REG_S	t5,  PT_T5(sp)
+	REG_S	t6,  PT_T6(sp)
+
+	/* Save CSRs */
+	csrr	t0, CSR_STATUS
+	REG_S	t0,  PT_STATUS(sp)
+	csrr	t1, CSR_EPC
+	REG_S	t1,  PT_EPC(sp)
+	csrr	t1, CSR_TVAL
+	REG_S	t1,  PT_BADADDR(sp)
+	csrr	t1, CSR_CAUSE
+	REG_S	t1,  PT_CAUSE(sp)
+	csrr	t1, CSR_SCRATCH
+	REG_S	t1,  PT_TP(sp)
+
+	/* Save the interrupted stack pointer, not the kernel IRQ stack. */
+	REG_L	t1, TASK_TI_USER_SP(tp)
+	REG_S	t1,  PT_SP(sp)
+
+	/* Nested interrupts use the current kernel tp and stack. */
+	csrw	CSR_SCRATCH, zero
+	load_global_pointer
+
+	/* orig_a0 is not used for IRQs.  Set it to 0. */
+	REG_S	zero, PT_ORIG_A0(sp)
+
+	/*
+	 * In CLIC mode, synchronous exceptions also come to stvec.BASE.  Send
+	 * them to the usual trap handlers, not to the IRQ dispatcher.  The CLIC
+	 * keeps more state in scause, so the low cause bits are not sufficient:
+	 * exception 7 and the machine-timer interrupt both have 7.  Use the
+	 * interrupt bit to identify them.
+	 */
+	REG_L	t1, PT_CAUSE(sp)
+	li	t0, CAUSE_IRQ_FLAG
+	and	t0, t1, t0
+	beqz	t0, .Lclic_exception
+
+.Lclic_interrupt:
+
+	/*
+	 * Remove the level from the CLIC supervisor level stack before C code.
+	 *
+	 * On this CLIC, only sret lowers the supervisor interrupt level
+	 * (sintstatus.SIL <- scause.spil), and only when the interrupt bit of
+	 * scause is set.  It is set here.  do_irq() can switch context
+	 * through irqentry_exit() or preempt_schedule_irq().  If the level is
+	 * still high then, other tasks run at handler level, with all S-mode
+	 * interrupts masked.  The handler frames of preempted tasks then do
+	 * their sret in scheduling order, not in nesting order.  A frame with
+	 * an old level can keep SIL high: the timer tick stops and the system
+	 * hangs without a message.
+	 *
+	 * Thus do an sret to the next instruction with scause.spil set to zero,
+	 * so the handler and all that it schedules run at base level.  Clear
+	 * SPIE first, so interrupts stay disabled.  Set SPP, so the CPU stays in
+	 * S-mode.  pt_regs has the real sstatus, sepc and scause of the
+	 * interrupted context, and the exit path restores them.
+	 */
+	REG_L	t0, PT_CAUSE(sp)
+	li	t1, CLIC_CAUSE_SPIL_MASK
+	not	t1, t1
+	and	t0, t0, t1
+	csrw	CSR_CAUSE, t0
+	li	t0, SR_SPIE
+	csrc	CSR_STATUS, t0
+	li	t0, SR_SPP
+	csrs	CSR_STATUS, t0
+	la	t0, .Lclic_level_popped
+	csrw	CSR_EPC, t0
+	sret
+
+.Lclic_level_popped:
+
+	/*
+	 * Call do_irq(regs) with SIE disabled.  The Linux IRQ core handles it as
+	 * a usual hardirq.  The standard RISC-V IRQ wrapper also sets irq_regs
+	 * and does the hardirq and RCU accounting that the timer and the
+	 * scheduler need.
+	 */
+	mv	a0, sp
+	call	do_irq
+	j	.Lclic_irq_return
+
+.Lclic_exception:
+	li	t2, 0xfff
+	and	t0, t1, t2
+	REG_S	t0, PT_CAUSE(sp)   /* Store the masked cause for the handlers */
+	slli	t0, t0, RISCV_LGPTR
+	la	t1, esp32s31_clic_excp_vect_table
+	la	t2, esp32s31_clic_excp_vect_table_end
+	add	t0, t1, t0
+	bgeu	t0, t2, .Lclic_exception_unknown
+	REG_L	t0, 0(t0)
+	mv	a0, sp
+	la	ra, ret_from_exception
+	jr	t0
+
+.Lclic_exception_unknown:
+	tail	do_trap_unknown
+
+.Lclic_irq_return:
+
+	/*
+	 * Disable interrupts during the cleanup.
+	 *
+	 * The CLIC uses the level stack for nested interrupts.  With xIE
+	 * clear, a higher-level interrupt cannot corrupt the restore sequence.
+	 */
+	csrci	CSR_STATUS, SR_IE
+
+	/*
+	 * For a return to userspace, save the kernel stack and the kernel tp in
+	 * CSR_SCRATCH before the user registers are restored.
+	 */
+	REG_L	t0, PT_STATUS(sp)
+	li	t1, SR_PP
+	and	t1, t0, t1
+	bnez	t1, .Lclic_restore_csrs
+	addi	t1, sp, PT_SIZE_ON_STACK
+	REG_S	t1, TASK_TI_KERNEL_SP(tp)
+	csrw	CSR_SCRATCH, tp
+
+.Lclic_restore_csrs:
+
+	/*
+	 * Restore the context and return.  xIE is clear.  Restore xepc first,
+	 * because it does not change the interrupt state.  Then restore
+	 * xstatus with xIE clear, so interrupts stay disabled while the GPRs
+	 * are restored.  sret at the end sets the interrupt-enable state.
+	 */
+	REG_L	t0, PT_EPC(sp)
+	csrw	CSR_EPC, t0
+
+	REG_L	t0, PT_STATUS(sp)
+	li	t1, SR_IE
+	not	t1, t1
+	and	t0, t0, t1
+	csrw	CSR_STATUS, t0
+
+	/* Restore the GPRs.  Restore sp last. */
+	REG_L	ra,  PT_RA(sp)
+	REG_L	gp,  PT_GP(sp)
+	REG_L	tp,  PT_TP(sp)
+	REG_L	t2,  PT_T2(sp)
+	REG_L	s0,  PT_S0(sp)
+	REG_L	s1,  PT_S1(sp)
+	REG_L	a0,  PT_A0(sp)
+	REG_L	a1,  PT_A1(sp)
+	REG_L	a2,  PT_A2(sp)
+	REG_L	a3,  PT_A3(sp)
+	REG_L	a4,  PT_A4(sp)
+	REG_L	a5,  PT_A5(sp)
+	REG_L	a6,  PT_A6(sp)
+	REG_L	a7,  PT_A7(sp)
+	REG_L	s2,  PT_S2(sp)
+	REG_L	s3,  PT_S3(sp)
+	REG_L	s4,  PT_S4(sp)
+	REG_L	s5,  PT_S5(sp)
+	REG_L	s6,  PT_S6(sp)
+	REG_L	s7,  PT_S7(sp)
+	REG_L	s8,  PT_S8(sp)
+	REG_L	s9,  PT_S9(sp)
+	REG_L	s10, PT_S10(sp)
+	REG_L	s11, PT_S11(sp)
+	REG_L	t3,  PT_T3(sp)
+	REG_L	t4,  PT_T4(sp)
+	REG_L	t5,  PT_T5(sp)
+	REG_L	t6,  PT_T6(sp)
+
+	/*
+	 * sret uses scause, so restore it after all other state.  The CLIC
+	 * keeps the previous interrupt level in scause, and sret copies it to
+	 * sintstatus when the interrupt bit of scause is set.  Thus use scause
+	 * and sret.  With mret, mintstatus.SIL stays at the level of the
+	 * interrupt, and all later supervisor interrupts stay masked.
+	 *
+	 * The entry already removed the level, so set spil to zero here too.
+	 * The interrupted context always continues at base level.  The saved
+	 * spil can be old if the scheduler mixed the order of handler frames.
+	 */
+	REG_L	t0, PT_CAUSE(sp)
+	li	t1, CLIC_CAUSE_SPIL_MASK
+	not	t1, t1
+	and	t0, t0, t1
+	csrw	CSR_CAUSE, t0
+	REG_L	t1, PT_T1(sp)
+	REG_L	t0, PT_T0(sp)
+
+	/* Return on the interrupted stack, not on the kernel IRQ stack. */
+	REG_L	sp, PT_SP(sp)
+
+	/*
+	 * sret returns to sepc, sets SIE from SPIE, and tells the CLIC that
+	 * this interrupt level is complete.  Then the CLIC sends the pending
+	 * interrupts at the restored level.
+	 */
+	sret
+
+SYM_CODE_END(esp32s31_clic_trampoline)
+
+SYM_DATA_START_LOCAL(esp32s31_clic_excp_vect_table)
+	RISCV_PTR do_trap_insn_misaligned
+	RISCV_PTR do_trap_insn_fault
+	RISCV_PTR do_trap_insn_illegal
+	RISCV_PTR do_trap_break
+	RISCV_PTR do_trap_load_misaligned
+	RISCV_PTR do_trap_load_fault
+	RISCV_PTR do_trap_store_misaligned
+	RISCV_PTR do_trap_store_fault
+	RISCV_PTR do_trap_ecall_u
+	RISCV_PTR do_trap_ecall_s
+	RISCV_PTR do_trap_unknown
+	RISCV_PTR do_trap_ecall_m
+	RISCV_PTR do_page_fault
+	RISCV_PTR do_page_fault
+	RISCV_PTR do_trap_unknown
+	RISCV_PTR do_page_fault
+SYM_DATA_END_LABEL(esp32s31_clic_excp_vect_table, SYM_L_LOCAL, esp32s31_clic_excp_vect_table_end)
diff --git a/drivers/cache/esp32s31-cache.c b/drivers/cache/esp32s31-cache.c
new file mode 100644
--- /dev/null
+++ b/drivers/cache/esp32s31-cache.c
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Author: Marco Müller <hello@annoyedmilk.ch>
+ *
+ * ESP32-S31 cache controller: non-standard cache maintenance for DMA
+ *
+ * The hart has no Zicbom.  Thus the only way to make DMA buffers in cached
+ * memory coherent is the sync engine of the cache controller.  The uncached
+ * alias of PSRAM at 0xc0000000 is not used.  One set of global SYNC_*
+ * registers holds one operation at a time.  OpenSBI does all sync operations
+ * in M-mode under one lock, and this driver asks for them through the vendor
+ * SBI extension.  The SBI call also works early in the boot, before an
+ * ioremap() is possible.
+ *
+ * The I-cache of each core refills from PSRAM, not from the shared D-cache,
+ * and fence.i does not invalidate it.  With write-back PSRAM, new code can
+ * also stay in the D-cache.  Thus local_flush_icache_all() and
+ * flush_icache_folio() call esp32s31_icache_sync().
+ */
+
+#include <linux/align.h>
+#include <linux/dma-mapping.h>
+#include <linux/of.h>
+#include <linux/printk.h>
+#include <asm/cacheflush.h>
+#include <asm/dma-noncoherent.h>
+#include <asm/esp32s31-cache.h>
+#include <asm/sbi.h>
+
+/* 0x09000000 + mvendorid.  Keep the IDs the same as in OpenSBI. */
+#define ESP32S31_SBI_EXT		0x09000612
+#define ESP32S31_SBI_CACHE_WBACK_ALL	0
+#define ESP32S31_SBI_CACHE_INV		1
+#define ESP32S31_SBI_CACHE_WBACK	2
+#define ESP32S31_SBI_CACHE_WBACK_INV	3
+#define ESP32S31_SBI_ICACHE_SYNC	4
+
+/*
+ * Make new code visible: write back the D-cache, then invalidate the I-cache
+ * of this hart.  A size of 0 means the full caches.  The kernel calls this at
+ * any time.
+ */
+void esp32s31_icache_sync(phys_addr_t paddr, size_t size)
+{
+	sbi_ecall(ESP32S31_SBI_EXT, ESP32S31_SBI_ICACHE_SYNC,
+		  paddr, size, 0, 0, 0, 0);
+}
+
+/*
+ * Do one sync operation on the range.  The coherent DMA pool is in internal
+ * SRAM.  The CPU accesses SRAM without the data cache, and the sync engine
+ * cannot use it.  A buffer is never in SRAM and PSRAM at the same time.  Thus
+ * a range that is not fully in PSRAM needs no maintenance.  A size of 0 means
+ * the full cache for the engine, so never send an empty range.
+ */
+static void esp32s31_cache_sync(phys_addr_t paddr, size_t size,
+				unsigned long funcid)
+{
+	phys_addr_t end = paddr + size;
+
+	paddr = ALIGN_DOWN(paddr, ESP32S31_CACHE_LINE_SIZE);
+	size = ALIGN(end - paddr, ESP32S31_CACHE_LINE_SIZE);
+
+	if (!size || paddr < ESP32S31_CACHE_EXTRAM_BASE ||
+	    paddr + size > ESP32S31_CACHE_EXTRAM_BASE + ESP32S31_CACHE_EXTRAM_SIZE)
+		return;
+
+	sbi_ecall(ESP32S31_SBI_EXT, funcid, paddr, size, 0, 0, 0, 0);
+}
+
+static void esp32s31_cache_wback(phys_addr_t paddr, size_t size)
+{
+	esp32s31_cache_sync(paddr, size, ESP32S31_SBI_CACHE_WBACK);
+}
+
+static void esp32s31_cache_inv(phys_addr_t paddr, size_t size)
+{
+	esp32s31_cache_sync(paddr, size, ESP32S31_SBI_CACHE_INV);
+}
+
+static void esp32s31_cache_wback_inv(phys_addr_t paddr, size_t size)
+{
+	esp32s31_cache_sync(paddr, size, ESP32S31_SBI_CACHE_WBACK_INV);
+}
+
+static const struct riscv_nonstd_cache_ops esp32s31_cache_ops __initconst = {
+	.wback = &esp32s31_cache_wback,
+	.inv = &esp32s31_cache_inv,
+	.wback_inv = &esp32s31_cache_wback_inv,
+};
+
+static const struct of_device_id esp32s31_cache_ids[] __initconst = {
+	{ .compatible = "esp,esp32s31-cache" },
+	{ /* sentinel */ }
+};
+
+static int __init esp32s31_cache_init(void)
+{
+	struct device_node *np;
+	bool available;
+
+	np = of_find_matching_node(NULL, esp32s31_cache_ids);
+	available = of_device_is_available(np);
+	of_node_put(np);
+	if (!available)
+		return -ENODEV;
+
+	if (sbi_probe_extension(ESP32S31_SBI_EXT) <= 0) {
+		pr_err("esp32s31-cache: no cache SBI extension in the firmware\n");
+		return -ENODEV;
+	}
+
+	/*
+	 * setup_arch() already set the line size and enabled non-coherent DMA,
+	 * because the slab allocator sets its DMA alignment before the
+	 * initcalls.
+	 */
+	riscv_noncoherent_register_cache_ops(&esp32s31_cache_ops);
+
+	/*
+	 * This alignment prevents a kmalloc DMA buffer from sharing a cache
+	 * line with a different allocation.  A value below the line size means
+	 * that setup_arch() did not enable non-coherent DMA.
+	 */
+	pr_info("esp32s31-cache: non-coherent DMA cache ops registered (%u-byte lines, DMA alignment %d)\n",
+		ESP32S31_CACHE_LINE_SIZE, dma_get_cache_alignment());
+
+	return 0;
+}
+early_initcall(esp32s31_cache_init);
diff --git a/drivers/clk/clk-esp32s31.c b/drivers/clk/clk-esp32s31.c
new file mode 100644
--- /dev/null
+++ b/drivers/clk/clk-esp32s31.c
@@ -0,0 +1,429 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Author: Marco Mueller <hello@annoyedmilk.ch>
+ *
+ * ESP32-S31 clock and reset controllers
+ *
+ * Three blocks have clocks for Linux.  LP_AONCLKRST has the MPLL, which the
+ * firmware sets for the PSRAM, so Linux only reads its rate.  HP_SYS_CLKRST
+ * has the CPU, SYS and APB clocks, which the firmware sets, and a gate for
+ * each peripheral.  CNNT_SYS has the EMAC TX clock and reset, and the EMAC
+ * interface registers, which the EMAC glue gets as a syscon.
+ *
+ * The firmware on hart 0 does not write these registers after it starts
+ * Linux.  The USB PHY maps single registers of HP_SYS_CLKRST and CNNT_SYS,
+ * so this driver does not request the regions.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/math.h>
+#include <linux/mfd/syscon.h>
+#include <linux/mod_devicetable.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset-controller.h>
+#include <linux/spinlock.h>
+
+#include <dt-bindings/clock/esp32s31-clk.h>
+
+#define LP_MSPI_DIV			0x54
+#define LP_MSPI_REF_DIV			GENMASK(2, 0)
+#define LP_MSPI_FB_DIV			GENMASK(7, 3)
+
+#define HP_SOC_CLK_SEL			0x00
+#define HP_CPU_FREQ_CTRL0		0x04
+#define HP_SYS_FREQ_CTRL0		0x0c
+#define HP_APB_FREQ_CTRL0		0x10
+#define HP_EMAC_CTRL0			0xc8
+#define HP_I2C_CTRL0(n)			(0xdc + (n) * 4)
+#define HP_I2C_APB_CLK_EN		0
+#define HP_I2C_RST_EN			BIT(1)
+#define HP_I2C_CLK_SRC_SEL		3
+#define HP_I2C_CLK_EN			4
+#define HP_I2C_CLK_DIV_NUM		5
+#define HP_FREQ_DIV_NUM			GENMASK(7, 0)
+#define HP_FREQ_NUMERATOR		GENMASK(10, 8)
+#define HP_FREQ_DENOMINATOR		GENMASK(13, 11)
+
+#define CNNT_EMAC_CTRL			0x3c
+#define CNNT_EMAC_RST_EN		BIT(1)
+#define CNNT_EMAC_REF_CTRL		0x40
+#define CNNT_SIZE			0x1000
+
+/* A reset bit: 1 holds the peripheral in reset. */
+struct esp32s31_reset {
+	u16 offset;
+	u32 mask;
+};
+
+struct esp32s31_clk {
+	struct device *dev;
+	void __iomem *base;
+	struct clk_hw_onecell_data *hws;
+	/* For the read-modify-write of the registers */
+	spinlock_t lock;
+	const struct esp32s31_reset *resets;
+	struct reset_controller_dev rcdev;
+};
+
+/* The MPLL and the root dividers are set by the firmware: read only. */
+struct esp32s31_ro_clk {
+	struct clk_hw hw;
+	void __iomem *reg;
+};
+
+#define to_ro_clk(_hw) container_of(_hw, struct esp32s31_ro_clk, hw)
+
+static unsigned long esp32s31_mpll_recalc_rate(struct clk_hw *hw,
+					       unsigned long parent_rate)
+{
+	u32 val = readl(to_ro_clk(hw)->reg);
+
+	return parent_rate * (FIELD_GET(LP_MSPI_FB_DIV, val) + 1) /
+	       (FIELD_GET(LP_MSPI_REF_DIV, val) + 1);
+}
+
+static const struct clk_ops esp32s31_mpll_ops = {
+	.recalc_rate = esp32s31_mpll_recalc_rate,
+};
+
+/* rate = parent / (div + numerator / denominator), div = DIV_NUM + 1 */
+static unsigned long esp32s31_frac_recalc_rate(struct clk_hw *hw,
+					       unsigned long parent_rate)
+{
+	u32 val = readl(to_ro_clk(hw)->reg);
+	u32 div = FIELD_GET(HP_FREQ_DIV_NUM, val) + 1;
+	u32 num = FIELD_GET(HP_FREQ_NUMERATOR, val);
+	u32 den = FIELD_GET(HP_FREQ_DENOMINATOR, val);
+
+	if (!den)
+		return parent_rate / div;
+
+	return mult_frac(parent_rate, den, div * den + num);
+}
+
+static const struct clk_ops esp32s31_frac_ops = {
+	.recalc_rate = esp32s31_frac_recalc_rate,
+};
+
+static struct clk_hw *esp32s31_ro_register(struct esp32s31_clk *ec,
+					   const char *name,
+					   const struct clk_parent_data *parent,
+					   const struct clk_ops *ops,
+					   unsigned int offset)
+{
+	struct clk_init_data init = {
+		.name = name,
+		.ops = ops,
+		.parent_data = parent,
+		.num_parents = 1,
+	};
+	struct esp32s31_ro_clk *clk;
+	int ret;
+
+	clk = devm_kzalloc(ec->dev, sizeof(*clk), GFP_KERNEL);
+	if (!clk)
+		return ERR_PTR(-ENOMEM);
+
+	clk->reg = ec->base + offset;
+	clk->hw.init = &init;
+	ret = devm_clk_hw_register(ec->dev, &clk->hw);
+	if (ret)
+		return ERR_PTR(ret);
+
+	return &clk->hw;
+}
+
+static int esp32s31_lp_init(struct esp32s31_clk *ec)
+{
+	static const struct clk_parent_data xtal = { .fw_name = "xtal" };
+
+	ec->hws->hws[ESP32S31_LP_CLK_MPLL] =
+		esp32s31_ro_register(ec, "mpll", &xtal, &esp32s31_mpll_ops,
+				     LP_MSPI_DIV);
+	return 0;
+}
+
+/* I2C n: the APB gate, and the function clock: source, divider, gate */
+static struct clk_hw *esp32s31_i2c_register(struct esp32s31_clk *ec,
+					    unsigned int n)
+{
+	static const struct clk_parent_data src[] = {
+		{ .fw_name = "xtal" },
+		{ .fw_name = "rc-fast" },
+	};
+	static const char * const names[][4] = {
+		{ "i2c0-apb", "i2c0-sel", "i2c0-div", "i2c0" },
+		{ "i2c1-apb", "i2c1-sel", "i2c1-div", "i2c1" },
+	};
+	void __iomem *reg = ec->base + HP_I2C_CTRL0(n);
+	struct clk_hw **hws = ec->hws->hws;
+	struct clk_hw *hw;
+
+	hws[ESP32S31_CLK_I2C0_APB + 2 * n] =
+		devm_clk_hw_register_gate_parent_hw(ec->dev, names[n][0],
+						    hws[ESP32S31_CLK_APB], 0,
+						    reg, HP_I2C_APB_CLK_EN, 0,
+						    &ec->lock);
+
+	hw = devm_clk_hw_register_mux_parent_data_table(ec->dev, names[n][1],
+							src, ARRAY_SIZE(src),
+							CLK_SET_RATE_NO_REPARENT,
+							reg, HP_I2C_CLK_SRC_SEL,
+							1, 0, NULL, &ec->lock);
+	if (IS_ERR(hw))
+		return hw;
+
+	hw = devm_clk_hw_register_divider_parent_hw(ec->dev, names[n][2], hw,
+						    0, reg, HP_I2C_CLK_DIV_NUM,
+						    8, 0, &ec->lock);
+	if (IS_ERR(hw))
+		return hw;
+
+	hw = devm_clk_hw_register_gate_parent_hw(ec->dev, names[n][3], hw,
+						 CLK_SET_RATE_PARENT, reg,
+						 HP_I2C_CLK_EN, 0, &ec->lock);
+	hws[ESP32S31_CLK_I2C0 + 2 * n] = hw;
+	return hw;
+}
+
+static int esp32s31_hp_init(struct esp32s31_clk *ec)
+{
+	static const struct clk_parent_data root[] = {
+		{ .fw_name = "xtal" },
+		{ .fw_name = "cpll" },
+		{ .fw_name = "rc-fast" },
+		{ .fw_name = "pll-f240m" },
+	};
+	/* Each one is the parent of the next. */
+	static const struct {
+		const char *name;
+		unsigned int id;
+		unsigned int offset;
+	} chain[] = {
+		{ "cpu", ESP32S31_CLK_CPU, HP_CPU_FREQ_CTRL0 },
+		{ "sys", ESP32S31_CLK_SYS, HP_SYS_FREQ_CTRL0 },
+		{ "apb", ESP32S31_CLK_APB, HP_APB_FREQ_CTRL0 },
+	};
+	struct clk_hw **hws = ec->hws->hws;
+	struct clk_parent_data parent = {};
+	struct clk_hw *hw;
+	unsigned int i;
+
+	hw = devm_clk_hw_register_mux_parent_data_table(ec->dev, "soc-root",
+							root, ARRAY_SIZE(root),
+							0, ec->base + HP_SOC_CLK_SEL,
+							0, 2, CLK_MUX_READ_ONLY,
+							NULL, &ec->lock);
+	for (i = 0; i < ARRAY_SIZE(chain) && !IS_ERR(hw); i++) {
+		parent.hw = hw;
+		hw = esp32s31_ro_register(ec, chain[i].name, &parent,
+					  &esp32s31_frac_ops, chain[i].offset);
+		hws[chain[i].id] = hw;
+	}
+	if (IS_ERR(hw))
+		return PTR_ERR(hw);
+
+	hws[ESP32S31_CLK_EMAC_SYS] =
+		devm_clk_hw_register_gate_parent_hw(ec->dev, "emac-sys",
+						    hws[ESP32S31_CLK_SYS], 0,
+						    ec->base + HP_EMAC_CTRL0,
+						    0, 0, &ec->lock);
+
+	for (i = 0; i < 2; i++) {
+		hw = esp32s31_i2c_register(ec, i);
+		if (IS_ERR(hw))
+			return PTR_ERR(hw);
+	}
+	return 0;
+}
+
+static struct esp32s31_clk *to_esp32s31_clk(struct reset_controller_dev *rcdev)
+{
+	return container_of(rcdev, struct esp32s31_clk, rcdev);
+}
+
+static int esp32s31_reset_update(struct reset_controller_dev *rcdev,
+				 unsigned long id, bool assert)
+{
+	struct esp32s31_clk *ec = to_esp32s31_clk(rcdev);
+	const struct esp32s31_reset *rst = &ec->resets[id];
+	void __iomem *reg = ec->base + rst->offset;
+	u32 val;
+
+	guard(spinlock_irqsave)(&ec->lock);
+	val = readl(reg) & ~rst->mask;
+	writel(val | (assert ? rst->mask : 0), reg);
+	return 0;
+}
+
+static int esp32s31_reset_assert(struct reset_controller_dev *rcdev,
+				 unsigned long id)
+{
+	return esp32s31_reset_update(rcdev, id, true);
+}
+
+static int esp32s31_reset_deassert(struct reset_controller_dev *rcdev,
+				   unsigned long id)
+{
+	return esp32s31_reset_update(rcdev, id, false);
+}
+
+static const struct reset_control_ops esp32s31_reset_ops = {
+	.assert = esp32s31_reset_assert,
+	.deassert = esp32s31_reset_deassert,
+};
+
+static const struct regmap_config esp32s31_cnnt_regmap_config = {
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.max_register = CNNT_SIZE - 4,
+};
+
+static int esp32s31_cnnt_init(struct esp32s31_clk *ec)
+{
+	static const struct clk_parent_data ref[] = {
+		{ .fw_name = "mpll" },
+		{ .fw_name = "cpll" },
+		{ .fw_name = "apll" },
+	};
+	void __iomem *reg = ec->base + CNNT_EMAC_REF_CTRL;
+	struct device *dev = ec->dev;
+	struct regmap *regmap;
+	struct clk_hw *hw;
+
+	/* EMAC_REF, the RGMII TX clock: source, divider (DIV_NUM + 1), gate */
+	hw = devm_clk_hw_register_mux_parent_data_table(dev, "emac-ref-mux", ref,
+							ARRAY_SIZE(ref),
+							CLK_SET_RATE_NO_REPARENT,
+							reg, 0, 2, 0, NULL,
+							&ec->lock);
+	if (IS_ERR(hw))
+		return PTR_ERR(hw);
+
+	hw = devm_clk_hw_register_divider_parent_hw(dev, "emac-ref-div", hw, 0,
+						    reg, 8, 8, 0, &ec->lock);
+	if (IS_ERR(hw))
+		return PTR_ERR(hw);
+
+	ec->hws->hws[ESP32S31_CNNT_CLK_EMAC_REF] =
+		devm_clk_hw_register_gate_parent_hw(dev, "emac-ref", hw,
+						    CLK_SET_RATE_PARENT, reg,
+						    2, 0, &ec->lock);
+
+	regmap = devm_regmap_init_mmio(dev, ec->base,
+				       &esp32s31_cnnt_regmap_config);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+	return of_syscon_register_regmap(dev->of_node, regmap);
+}
+
+struct esp32s31_clk_data {
+	unsigned int nclks;
+	int (*init)(struct esp32s31_clk *ec);
+	const struct esp32s31_reset *resets;
+	unsigned int nresets;
+};
+
+static int esp32s31_clk_probe(struct platform_device *pdev)
+{
+	const struct esp32s31_clk_data *data = device_get_match_data(&pdev->dev);
+	struct device *dev = &pdev->dev;
+	struct esp32s31_clk *ec;
+	struct resource *res;
+	unsigned int i;
+	int ret;
+
+	ec = devm_kzalloc(dev, sizeof(*ec), GFP_KERNEL);
+	if (!ec)
+		return -ENOMEM;
+
+	ec->hws = devm_kzalloc(dev, struct_size(ec->hws, hws, data->nclks),
+			       GFP_KERNEL);
+	if (!ec->hws)
+		return -ENOMEM;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+
+	ec->base = devm_ioremap(dev, res->start, resource_size(res));
+	if (!ec->base)
+		return -ENOMEM;
+
+	ec->dev = dev;
+	ec->hws->num = data->nclks;
+	spin_lock_init(&ec->lock);
+
+	ret = data->init(ec);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < data->nclks; i++)
+		if (IS_ERR(ec->hws->hws[i]))
+			return dev_err_probe(dev, PTR_ERR(ec->hws->hws[i]),
+					     "failed to register clock %u\n", i);
+
+	if (data->nresets) {
+		ec->resets = data->resets;
+		ec->rcdev.ops = &esp32s31_reset_ops;
+		ec->rcdev.owner = THIS_MODULE;
+		ec->rcdev.of_node = dev->of_node;
+		ec->rcdev.nr_resets = data->nresets;
+		ret = devm_reset_controller_register(dev, &ec->rcdev);
+		if (ret)
+			return ret;
+	}
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, ec->hws);
+}
+
+static const struct esp32s31_clk_data esp32s31_lp_data = {
+	.nclks = ESP32S31_LP_CLK_MPLL + 1,
+	.init = esp32s31_lp_init,
+};
+
+static const struct esp32s31_reset esp32s31_hp_resets[] = {
+	[ESP32S31_RST_I2C0] = { HP_I2C_CTRL0(0), HP_I2C_RST_EN },
+	[ESP32S31_RST_I2C1] = { HP_I2C_CTRL0(1), HP_I2C_RST_EN },
+};
+
+static const struct esp32s31_clk_data esp32s31_hp_data = {
+	.nclks = ESP32S31_CLK_I2C1 + 1,
+	.init = esp32s31_hp_init,
+	.resets = esp32s31_hp_resets,
+	.nresets = ARRAY_SIZE(esp32s31_hp_resets),
+};
+
+static const struct esp32s31_reset esp32s31_cnnt_resets[] = {
+	[ESP32S31_CNNT_RST_EMAC] = { CNNT_EMAC_CTRL, CNNT_EMAC_RST_EN },
+};
+
+static const struct esp32s31_clk_data esp32s31_cnnt_data = {
+	.nclks = ESP32S31_CNNT_CLK_EMAC_REF + 1,
+	.init = esp32s31_cnnt_init,
+	.resets = esp32s31_cnnt_resets,
+	.nresets = ARRAY_SIZE(esp32s31_cnnt_resets),
+};
+
+static const struct of_device_id esp32s31_clk_of_match[] = {
+	{ .compatible = "esp,esp32s31-lp-clkrst", .data = &esp32s31_lp_data },
+	{ .compatible = "esp,esp32s31-hp-clkrst", .data = &esp32s31_hp_data },
+	{ .compatible = "esp,esp32s31-cnnt-sys", .data = &esp32s31_cnnt_data },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, esp32s31_clk_of_match);
+
+static struct platform_driver esp32s31_clk_driver = {
+	.driver = {
+		.name = "esp32s31-clk",
+		.of_match_table = esp32s31_clk_of_match,
+		.suppress_bind_attrs = true,
+	},
+	.probe = esp32s31_clk_probe,
+};
+builtin_platform_driver(esp32s31_clk_driver);
diff --git a/drivers/i2c/busses/i2c-esp32s31.c b/drivers/i2c/busses/i2c-esp32s31.c
new file mode 100644
--- /dev/null
+++ b/drivers/i2c/busses/i2c-esp32s31.c
@@ -0,0 +1,488 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Author: Marco Mueller <hello@annoyedmilk.ch>
+ *
+ * ESP32-S31 I2C master
+ *
+ * The controller runs a list of up to 8 commands (RSTART, WRITE, READ, STOP,
+ * END) with a 32-byte FIFO for each direction.  The driver puts as much of
+ * the messages as fits into one list.  A list that ends with END pauses the
+ * bus with SCL low, and the interrupt handler then reads the received bytes
+ * and starts the next list.  The last list ends with STOP.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/log2.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+
+#define I2C_SCL_LOW_PERIOD		0x00
+#define I2C_CTR				0x04
+#define I2C_TO				0x0c
+#define I2C_FIFO_CONF			0x18
+#define I2C_DATA			0x1c
+#define I2C_INT_CLR			0x24
+#define I2C_INT_ENA			0x28
+#define I2C_INT_STATUS			0x2c
+#define I2C_SDA_HOLD			0x30
+#define I2C_SDA_SAMPLE			0x34
+#define I2C_SCL_HIGH_PERIOD		0x38
+#define I2C_SCL_START_HOLD		0x40
+#define I2C_SCL_RSTART_SETUP		0x44
+#define I2C_SCL_STOP_HOLD		0x48
+#define I2C_SCL_STOP_SETUP		0x4c
+#define I2C_FILTER_CFG			0x50
+#define I2C_COMD(n)			(0x58 + (n) * 4)
+#define I2C_SCL_SP_CONF			0x80
+
+#define I2C_CTR_MS_MODE			BIT(4)
+#define I2C_CTR_TRANS_START		BIT(5)
+#define I2C_CTR_FSM_RST			BIT(10)
+#define I2C_CTR_CONF_UPGATE		BIT(11)
+
+#define I2C_TO_VALUE			GENMASK(4, 0)
+#define I2C_TO_EN			BIT(5)
+
+#define I2C_FIFO_RX_RST			BIT(12)
+#define I2C_FIFO_TX_RST			BIT(13)
+
+#define I2C_SCL_WAIT_HIGH		GENMASK(15, 9)
+
+#define I2C_FILTER_SCL_THRES		GENMASK(3, 0)
+#define I2C_FILTER_SDA_THRES		GENMASK(7, 4)
+#define I2C_FILTER_SCL_EN		BIT(8)
+#define I2C_FILTER_SDA_EN		BIT(9)
+
+#define I2C_SCL_RST_SLV_EN		BIT(0)
+#define I2C_SCL_RST_SLV_NUM		GENMASK(5, 1)
+
+#define I2C_INT_END_DETECT		BIT(3)
+#define I2C_INT_ARB_LOST		BIT(5)
+#define I2C_INT_TRANS_COMPLETE		BIT(7)
+#define I2C_INT_TIME_OUT		BIT(8)
+#define I2C_INT_NACK			BIT(10)
+#define I2C_INT_SCL_ST_TO		BIT(13)
+#define I2C_INT_SCL_MAIN_ST_TO		BIT(14)
+#define I2C_INT_TIMEOUTS		(I2C_INT_TIME_OUT | I2C_INT_SCL_ST_TO | \
+					 I2C_INT_SCL_MAIN_ST_TO)
+#define I2C_INT_MASK			(I2C_INT_END_DETECT | I2C_INT_ARB_LOST | \
+					 I2C_INT_TRANS_COMPLETE | I2C_INT_NACK | \
+					 I2C_INT_TIMEOUTS)
+
+#define I2C_CMD_BYTES			GENMASK(7, 0)
+#define I2C_CMD_ACK_CHECK		BIT(8)
+#define I2C_CMD_ACK_VALUE		BIT(10)
+#define I2C_CMD_OP			GENMASK(13, 11)
+#define I2C_OP_WRITE			1
+#define I2C_OP_STOP			2
+#define I2C_OP_READ			3
+#define I2C_OP_END			4
+#define I2C_OP_RSTART			6
+
+#define I2C_NCMDS			8
+#define I2C_FIFO_SIZE			32
+/* Glitches shorter than this many source clock cycles are filtered. */
+#define I2C_FILTER_CYCLES		7
+
+struct esp32s31_i2c_rx {
+	u8 *buf;
+	unsigned int len;
+};
+
+struct esp32s31_i2c {
+	struct i2c_adapter adap;
+	struct device *dev;
+	void __iomem *base;
+	struct clk *clk;
+	struct reset_control *rst;
+	u32 bus_freq;
+	struct completion done;
+	int err;
+
+	/* The messages of the transfer, and the next byte to send or receive */
+	struct i2c_msg *msgs;
+	unsigned int num;
+	unsigned int msg;
+	unsigned int pos;
+	bool addressed;
+
+	/* The read commands of the running list */
+	struct esp32s31_i2c_rx rx[I2C_NCMDS];
+	unsigned int nrx;
+};
+
+static void esp32s31_i2c_cmd(struct esp32s31_i2c *i2c, unsigned int *n,
+			     u32 op, u32 bytes, u32 flags)
+{
+	writel(FIELD_PREP(I2C_CMD_OP, op) | FIELD_PREP(I2C_CMD_BYTES, bytes) |
+	       flags, i2c->base + I2C_COMD((*n)++));
+}
+
+static void esp32s31_i2c_next_msg(struct esp32s31_i2c *i2c)
+{
+	i2c->msg++;
+	i2c->pos = 0;
+	i2c->addressed = false;
+}
+
+/* The commands and FIFO bytes that the running list uses */
+struct esp32s31_i2c_batch {
+	unsigned int cmd;
+	unsigned int tx;
+	unsigned int rx;
+};
+
+/* A RESTART and the address, with room for one data command after them */
+static bool esp32s31_i2c_queue_addr(struct esp32s31_i2c *i2c,
+				    struct esp32s31_i2c_batch *b,
+				    struct i2c_msg *m)
+{
+	if (b->cmd + 3 > I2C_NCMDS - 1 || b->tx == I2C_FIFO_SIZE)
+		return false;
+
+	esp32s31_i2c_cmd(i2c, &b->cmd, I2C_OP_RSTART, 0, 0);
+	writel(i2c_8bit_addr_from_msg(m), i2c->base + I2C_DATA);
+	esp32s31_i2c_cmd(i2c, &b->cmd, I2C_OP_WRITE, 1, I2C_CMD_ACK_CHECK);
+	b->tx++;
+	i2c->addressed = true;
+	return true;
+}
+
+/* The last byte of a message gets a NACK, so it is a READ of its own. */
+static bool esp32s31_i2c_queue_read(struct esp32s31_i2c *i2c,
+				    struct esp32s31_i2c_batch *b,
+				    struct i2c_msg *m)
+{
+	unsigned int left = m->len - i2c->pos;
+	unsigned int n = min(left, I2C_FIFO_SIZE - b->rx);
+	bool last = n == left;
+	unsigned int bulk = n - last;
+
+	if (!n || b->cmd + !!bulk + last > I2C_NCMDS - 1)
+		return false;
+
+	i2c->rx[i2c->nrx++] = (struct esp32s31_i2c_rx){ m->buf + i2c->pos, n };
+	if (bulk)
+		esp32s31_i2c_cmd(i2c, &b->cmd, I2C_OP_READ, bulk, 0);
+	if (last)
+		esp32s31_i2c_cmd(i2c, &b->cmd, I2C_OP_READ, 1,
+				 I2C_CMD_ACK_VALUE);
+	b->rx += n;
+	i2c->pos += n;
+	return true;
+}
+
+static bool esp32s31_i2c_queue_write(struct esp32s31_i2c *i2c,
+				     struct esp32s31_i2c_batch *b,
+				     struct i2c_msg *m)
+{
+	unsigned int n = min(m->len - i2c->pos, I2C_FIFO_SIZE - b->tx);
+
+	if (!n || b->cmd + 1 > I2C_NCMDS - 1)
+		return false;
+
+	esp32s31_i2c_cmd(i2c, &b->cmd, I2C_OP_WRITE, n, I2C_CMD_ACK_CHECK);
+	b->tx += n;
+	while (n--)
+		writel(m->buf[i2c->pos++], i2c->base + I2C_DATA);
+	return true;
+}
+
+/*
+ * Put the next part of the messages into the command list.  One command is
+ * kept for the END or STOP.
+ */
+static void esp32s31_i2c_fill(struct esp32s31_i2c *i2c)
+{
+	struct esp32s31_i2c_batch b = { };
+
+	i2c->nrx = 0;
+	while (i2c->msg < i2c->num) {
+		struct i2c_msg *m = &i2c->msgs[i2c->msg];
+		bool queued;
+
+		if (!i2c->addressed)
+			queued = esp32s31_i2c_queue_addr(i2c, &b, m);
+		else if (m->flags & I2C_M_RD)
+			queued = esp32s31_i2c_queue_read(i2c, &b, m);
+		else
+			queued = esp32s31_i2c_queue_write(i2c, &b, m);
+		if (!queued)
+			break;
+		if (i2c->pos == m->len)
+			esp32s31_i2c_next_msg(i2c);
+	}
+
+	esp32s31_i2c_cmd(i2c, &b.cmd, i2c->msg < i2c->num ? I2C_OP_END :
+			 I2C_OP_STOP, 0, 0);
+}
+
+static void esp32s31_i2c_start(struct esp32s31_i2c *i2c)
+{
+	writel(readl(i2c->base + I2C_CTR) | I2C_CTR_TRANS_START,
+	       i2c->base + I2C_CTR);
+}
+
+static void esp32s31_i2c_drain(struct esp32s31_i2c *i2c)
+{
+	unsigned int i, j;
+
+	for (i = 0; i < i2c->nrx; i++)
+		for (j = 0; j < i2c->rx[i].len; j++)
+			i2c->rx[i].buf[j] = readl(i2c->base + I2C_DATA);
+	i2c->nrx = 0;
+}
+
+static irqreturn_t esp32s31_i2c_irq(int irq, void *dev_id)
+{
+	struct esp32s31_i2c *i2c = dev_id;
+	u32 status = readl(i2c->base + I2C_INT_STATUS);
+
+	if (!status)
+		return IRQ_NONE;
+
+	writel(status, i2c->base + I2C_INT_CLR);
+
+	if (status & I2C_INT_NACK)
+		i2c->err = -ENXIO;
+	else if (status & I2C_INT_ARB_LOST)
+		i2c->err = -EAGAIN;
+	else if (status & I2C_INT_TIMEOUTS)
+		i2c->err = -ETIMEDOUT;
+
+	if (!i2c->err && (status & I2C_INT_END_DETECT)) {
+		esp32s31_i2c_drain(i2c);
+		esp32s31_i2c_fill(i2c);
+		esp32s31_i2c_start(i2c);
+		return IRQ_HANDLED;
+	}
+
+	if (i2c->err || (status & I2C_INT_TRANS_COMPLETE)) {
+		if (!i2c->err)
+			esp32s31_i2c_drain(i2c);
+		writel(0, i2c->base + I2C_INT_ENA);
+		complete(&i2c->done);
+	}
+
+	return IRQ_HANDLED;
+}
+
+static void esp32s31_i2c_reset_fifos(struct esp32s31_i2c *i2c)
+{
+	u32 conf = readl(i2c->base + I2C_FIFO_CONF);
+
+	writel(conf | I2C_FIFO_RX_RST | I2C_FIFO_TX_RST,
+	       i2c->base + I2C_FIFO_CONF);
+	writel(conf & ~(I2C_FIFO_RX_RST | I2C_FIFO_TX_RST),
+	       i2c->base + I2C_FIFO_CONF);
+}
+
+/*
+ * The timing registers count source clock cycles.  half is half an SCL
+ * period.  SCL stays low for half; after the controller releases SCL, it
+ * waits up to WAIT_HIGH for the rise, then counts HIGH_PERIOD.
+ */
+static void esp32s31_i2c_set_timing(struct esp32s31_i2c *i2c)
+{
+	u32 half = DIV_ROUND_UP(clk_get_rate(i2c->clk), 2 * i2c->bus_freq);
+	u32 wait = i2c->bus_freq >= 80000 ? half / 2 - 2 : half / 4;
+	void __iomem *base = i2c->base;
+
+	writel(half - 1, base + I2C_SCL_LOW_PERIOD);
+	writel((half - wait) | FIELD_PREP(I2C_SCL_WAIT_HIGH, wait),
+	       base + I2C_SCL_HIGH_PERIOD);
+	writel(half / 4 - 1, base + I2C_SDA_HOLD);
+	writel(half / 2 - 1, base + I2C_SDA_SAMPLE);
+	writel(half - 1, base + I2C_SCL_START_HOLD);
+	writel(half - 1, base + I2C_SCL_RSTART_SETUP);
+	writel(half - 1, base + I2C_SCL_STOP_HOLD);
+	writel(half - 1, base + I2C_SCL_STOP_SETUP);
+	/* 2^n source clock cycles: approximately 10 SCL periods */
+	writel(FIELD_PREP(I2C_TO_VALUE, order_base_2(20 * half)) | I2C_TO_EN,
+	       base + I2C_TO);
+}
+
+/*
+ * Reset the controller and set it up.  After an error, also give 9 SCL
+ * pulses to free a bus that a device holds.  Not on an idle bus: the GT1151
+ * touch controller NACKs a transfer right after the pulses.
+ */
+static int esp32s31_i2c_init(struct esp32s31_i2c *i2c, bool clear_bus)
+{
+	void __iomem *base = i2c->base;
+	u32 val;
+	int ret;
+
+	ret = reset_control_assert(i2c->rst);
+	if (ret)
+		return ret;
+	ret = reset_control_deassert(i2c->rst);
+	if (ret)
+		return ret;
+
+	/* Open drain, no arbitration, MSB first, ACK at a full RX FIFO */
+	writel(I2C_CTR_MS_MODE, base + I2C_CTR);
+	writel(FIELD_PREP(I2C_FILTER_SCL_THRES, I2C_FILTER_CYCLES) |
+	       FIELD_PREP(I2C_FILTER_SDA_THRES, I2C_FILTER_CYCLES) |
+	       I2C_FILTER_SCL_EN | I2C_FILTER_SDA_EN, base + I2C_FILTER_CFG);
+	esp32s31_i2c_set_timing(i2c);
+	writel(I2C_INT_MASK, base + I2C_INT_CLR);
+	writel(0, base + I2C_INT_ENA);
+	writel(I2C_CTR_MS_MODE | I2C_CTR_CONF_UPGATE, base + I2C_CTR);
+	if (!clear_bus)
+		return 0;
+
+	/* The pulses start only in an idle master, so after the update above. */
+	writel(I2C_SCL_RST_SLV_EN | FIELD_PREP(I2C_SCL_RST_SLV_NUM, 9),
+	       base + I2C_SCL_SP_CONF);
+	writel(I2C_CTR_MS_MODE | I2C_CTR_CONF_UPGATE, base + I2C_CTR);
+	return readl_poll_timeout(base + I2C_SCL_SP_CONF, val,
+				  !(val & I2C_SCL_RST_SLV_EN), 10, 10000);
+}
+
+static int esp32s31_i2c_xfer(struct i2c_adapter *adap, struct i2c_msg *msgs,
+			     int num)
+{
+	struct esp32s31_i2c *i2c = i2c_get_adapdata(adap);
+	int i;
+
+	for (i = 0; i < num; i++)
+		if (msgs[i].flags & I2C_M_TEN)
+			return -EOPNOTSUPP;
+
+	i2c->msgs = msgs;
+	i2c->num = num;
+	i2c->msg = 0;
+	i2c->pos = 0;
+	i2c->addressed = false;
+	i2c->err = 0;
+	reinit_completion(&i2c->done);
+
+	esp32s31_i2c_reset_fifos(i2c);
+	writel(I2C_INT_MASK, i2c->base + I2C_INT_CLR);
+	esp32s31_i2c_fill(i2c);
+	writel(I2C_INT_MASK, i2c->base + I2C_INT_ENA);
+	esp32s31_i2c_start(i2c);
+
+	if (!wait_for_completion_timeout(&i2c->done, adap->timeout)) {
+		writel(0, i2c->base + I2C_INT_ENA);
+		i2c->err = -ETIMEDOUT;
+	}
+
+	/* After a NACK the bus is free: a reset of the state machine is enough. */
+	if (i2c->err == -ENXIO) {
+		writel(readl(i2c->base + I2C_CTR) | I2C_CTR_FSM_RST,
+		       i2c->base + I2C_CTR);
+	} else if (i2c->err && esp32s31_i2c_init(i2c, true)) {
+		dev_err(i2c->dev, "failed to reset the controller\n");
+	}
+
+	return i2c->err ?: num;
+}
+
+static u32 esp32s31_i2c_func(struct i2c_adapter *adap)
+{
+	return I2C_FUNC_I2C | I2C_FUNC_SMBUS_EMUL;
+}
+
+static const struct i2c_algorithm esp32s31_i2c_algo = {
+	.xfer = esp32s31_i2c_xfer,
+	.functionality = esp32s31_i2c_func,
+};
+
+static int esp32s31_i2c_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct i2c_timings timings;
+	struct esp32s31_i2c *i2c;
+	unsigned long rate;
+	struct clk *apb;
+	int irq, ret;
+
+	i2c = devm_kzalloc(dev, sizeof(*i2c), GFP_KERNEL);
+	if (!i2c)
+		return -ENOMEM;
+
+	i2c->dev = dev;
+	i2c->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(i2c->base))
+		return PTR_ERR(i2c->base);
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	apb = devm_clk_get_enabled(dev, "apb");
+	if (IS_ERR(apb))
+		return dev_err_probe(dev, PTR_ERR(apb), "failed to get APB clock\n");
+
+	i2c->clk = devm_clk_get_enabled(dev, "core");
+	if (IS_ERR(i2c->clk))
+		return dev_err_probe(dev, PTR_ERR(i2c->clk),
+				     "failed to get core clock\n");
+
+	i2c->rst = devm_reset_control_get_exclusive(dev, NULL);
+	if (IS_ERR(i2c->rst))
+		return dev_err_probe(dev, PTR_ERR(i2c->rst),
+				     "failed to get reset\n");
+
+	i2c_parse_fw_timings(dev, &timings, true);
+	i2c->bus_freq = timings.bus_freq_hz;
+	if (!i2c->bus_freq || i2c->bus_freq > I2C_MAX_FAST_MODE_PLUS_FREQ)
+		return dev_err_probe(dev, -EINVAL, "invalid clock-frequency\n");
+
+	/* The 9-bit timing fields need 8 to 1023 source cycles per period. */
+	ret = clk_set_rate(i2c->clk, i2c->bus_freq * 1023);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set the clock\n");
+	rate = clk_get_rate(i2c->clk);
+	if (rate < i2c->bus_freq * 8 || rate > i2c->bus_freq * 1023)
+		return dev_err_probe(dev, -EINVAL,
+				     "core clock %lu Hz out of range\n", rate);
+
+	init_completion(&i2c->done);
+	ret = esp32s31_i2c_init(i2c, false);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to reset the controller\n");
+
+	ret = devm_request_irq(dev, irq, esp32s31_i2c_irq, 0, dev_name(dev),
+			       i2c);
+	if (ret)
+		return ret;
+
+	i2c->adap.owner = THIS_MODULE;
+	i2c->adap.algo = &esp32s31_i2c_algo;
+	i2c->adap.dev.parent = dev;
+	i2c->adap.dev.of_node = dev->of_node;
+	strscpy(i2c->adap.name, dev_name(dev), sizeof(i2c->adap.name));
+	i2c_set_adapdata(&i2c->adap, i2c);
+
+	return devm_i2c_add_adapter(dev, &i2c->adap);
+}
+
+static const struct of_device_id esp32s31_i2c_of_match[] = {
+	{ .compatible = "esp,esp32s31-i2c" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, esp32s31_i2c_of_match);
+
+static struct platform_driver esp32s31_i2c_driver = {
+	.driver = {
+		.name = "esp32s31-i2c",
+		.of_match_table = esp32s31_i2c_of_match,
+	},
+	.probe = esp32s31_i2c_probe,
+};
+module_platform_driver(esp32s31_i2c_driver);
+
+MODULE_DESCRIPTION("ESP32-S31 I2C master driver");
+MODULE_AUTHOR("Marco Mueller <hello@annoyedmilk.ch>");
+MODULE_LICENSE("GPL");
diff --git a/drivers/irqchip/irq-esp32s31-clic.c b/drivers/irqchip/irq-esp32s31-clic.c
new file mode 100644
--- /dev/null
+++ b/drivers/irqchip/irq-esp32s31-clic.c
@@ -0,0 +1,616 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Author: Marco Müller <hello@annoyedmilk.ch>
+ *
+ * ESP32-S31 Core-Local Interrupt Controller (CLIC) driver
+ *
+ * Linux runs in S-mode and gets non-vectored interrupts through the
+ * supervisor CLIC window.  OpenSBI controls the machine interrupts.
+ *
+ * Main ESP32-S31 CLIC data:
+ *   - S-mode register base at 0x10a0_0000
+ *   - S-mode per-interrupt control at 0x10a0_1000
+ *   - CLICINTCTLBITS = 3, with CLICCFG.snlbits set to 0
+ *   - 32 external interrupts (CLIC IDs 16-47) from the Interrupt Matrix
+ */
+
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqchip.h>
+#include <linux/irqdomain.h>
+#include <linux/irq_work.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/percpu.h>
+#include <asm/csr.h>
+#include <asm/esp32s31-clic.h>
+#include <asm/irq.h>
+#include <asm/smp.h>
+
+/* CLIC register map */
+
+#define ESP32S31_CLIC_BASE 0x10a00000	/* S-mode sclicbase window */
+
+/*
+ * The per-interrupt control registers start at 0x10a0_1000.  Each interrupt
+ * has a 32-bit word with four byte registers.  All cores use the same
+ * address, and each core gets its own registers.  The registers of the other
+ * core are at +0x10000.
+ */
+#define ESP32S31_CLIC_CTRL_BASE 0x10a01000	/* S-mode per-interrupt window */
+#define ESP32S31_CLIC_INT_STRIDE 4		/* Bytes per interrupt */
+#define ESP32S31_CLIC_INT_IP 0x0		/* Pending (byte 0, bit 0) */
+#define ESP32S31_CLIC_INT_IE 0x1		/* Enable (byte 1, bit 0) */
+#define ESP32S31_CLIC_INT_ATTR 0x2		/* Attributes (byte 2) */
+#define ESP32S31_CLIC_INT_CTL 0x3		/* Level, priority (byte 3, [7:5]) */
+
+/* Interrupt numbering */
+
+#define CLIC_EXT_MIN_ID 16			/* First external IRQ */
+#define CLIC_NR_IRQS 48				/* 16 local + 32 external */
+#define ESP32S31_CLIC_IRQ_WORK_ID CLIC_EXT_MIN_ID
+
+/*
+ * Slot 16 is a software interrupt only when this driver reserves it for
+ * irq_work.  Otherwise it is a usual Interrupt Matrix input with a usual ack.
+ */
+#if defined(CONFIG_IRQ_WORK) && !defined(CONFIG_SMP)
+#define esp32s31_clic_is_irq_work(hwirq) ((hwirq) == ESP32S31_CLIC_IRQ_WORK_ID)
+#else
+#define esp32s31_clic_is_irq_work(hwirq) ((void)(hwirq), false)
+#endif
+
+/*
+ * In CLIC mode, the low cause bits hold the interrupt ID.  The high bits hold
+ * CLIC data, for example the previous interrupt level.  CAUSE_IRQ_FLAG does
+ * not remove them, so use a mask to get the exception code.
+ */
+#define CLIC_CAUSE_EXCCODE_MASK 0xfff
+
+/* CLIC configuration constants */
+
+#define ESP32S31_CLICINTCTLBITS 3		/* Implemented control bits */
+#define ESP32S31_CLICNLBITS 1			/* Level bits of CLICCTL_MAKE() */
+#define ESP32S31_MAX_PRIORITY 3			/* Bits [6:5] of CLICCTL_MAKE() */
+
+/* CLIC CSRs */
+#ifndef CSR_SINTTHRESH
+#define CSR_SINTTHRESH 0x147
+#endif
+
+/*
+ * clicintctl[i], byte 3 of the per-interrupt word.  OpenSBI sets CLICCFG to
+ * 0x23: snlbits = 0, so all supervisor inputs have level 255, and the three
+ * implemented bits are only the priority.  CLICCTL_MAKE(1, 3) gives 0xe0,
+ * which also keeps level 255 when snlbits is 1.
+ */
+#define CLICCTL_MAKE(level, prio) \
+	(((level) << (8 - ESP32S31_CLICNLBITS)) | \
+	 ((prio) << (8 - ESP32S31_CLICINTCTLBITS)))
+
+/*
+ * Interrupt attribute bits (byte 2 of the per-interrupt word):
+ *   bit 0:      SHV, 0 for non-vectored interrupts
+ *   bits [2:1]: TRIG, trigger type
+ *     X0 = level, 01 = rising edge, 11 = falling edge
+ *   bits [7:6]: MODE, supervisor mode for the Linux inputs
+ */
+#define CLIC_ATTR_TRIG_LEVEL 0x00
+#define CLIC_ATTR_TRIG_EDGE_RISE 0x02
+#define CLIC_ATTR_TRIG_EDGE_FALL 0x06
+#define CLIC_ATTR_TRIG_EDGE 0x02 /* bit 1: 1 = edge, 0 = level */
+#define CLIC_ATTR_MODE_S 0x40
+
+/*
+ * The Interrupt Matrix connects SoC interrupt sources to CLIC inputs.  Each
+ * core has its own block.  Linux maps only the block of its hart.  The other
+ * block is for the M-mode firmware.
+ */
+#define ESP32S31_INTMATRIX_CORE_STRIDE 0x800
+#define ESP32S31_INTMATRIX_MAP_MASK 0x3f
+#define ESP32S31_INTMATRIX_PASS_LEVEL_SHIFT 8
+#define ESP32S31_INTMATRIX_PASS_LEVEL_MASK (0x3 << ESP32S31_INTMATRIX_PASS_LEVEL_SHIFT)
+#define ESP32S31_INTMATRIX_PASS_LEVEL_S (1 << ESP32S31_INTMATRIX_PASS_LEVEL_SHIFT)
+
+/* Per-CPU CLIC structure */
+
+struct esp32s31_clic {
+	void __iomem *regs;
+	void __iomem *intmatrix_regs;
+	struct irq_domain *domain;
+};
+
+static DEFINE_PER_CPU(struct esp32s31_clic *, clic_per_cpu);
+static DEFINE_PER_CPU(raw_spinlock_t, clic_lock);
+
+/*
+ * Each core finds its own per-interrupt registers at
+ * ESP32S31_CLIC_CTRL_BASE + irq_id * 4 + byte_offset.  This driver does not
+ * use the +0x10000 alias of the other core.
+ */
+static inline u8 clic_readb(struct esp32s31_clic *clic, unsigned int irq_id,
+			    unsigned int byte_off)
+{
+	return readb(clic->regs + ESP32S31_CLIC_CTRL_BASE - ESP32S31_CLIC_BASE +
+		     (irq_id * ESP32S31_CLIC_INT_STRIDE) + byte_off);
+}
+
+static inline void clic_writeb(struct esp32s31_clic *clic, unsigned int irq_id,
+			       unsigned int byte_off, u8 val)
+{
+	writeb(val, clic->regs + ESP32S31_CLIC_CTRL_BASE - ESP32S31_CLIC_BASE +
+			    (irq_id * ESP32S31_CLIC_INT_STRIDE) + byte_off);
+}
+
+/* irq_chip callbacks */
+
+static void esp32s31_clic_irq_enable(struct irq_data *d, u8 enable)
+{
+	struct esp32s31_clic *clic = irq_data_get_irq_chip_data(d);
+	raw_spinlock_t *lock = this_cpu_ptr(&clic_lock);
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(lock, flags);
+	clic_writeb(clic, d->hwirq, ESP32S31_CLIC_INT_IE, enable);
+	raw_spin_unlock_irqrestore(lock, flags);
+}
+
+static void esp32s31_clic_irq_mask(struct irq_data *d)
+{
+	esp32s31_clic_irq_enable(d, 0);
+}
+
+static void esp32s31_clic_irq_unmask(struct irq_data *d)
+{
+	esp32s31_clic_irq_enable(d, 1);
+}
+
+static void esp32s31_clic_irq_eoi(struct irq_data *d)
+{
+	struct esp32s31_clic *clic = irq_data_get_irq_chip_data(d);
+	raw_spinlock_t *lock = this_cpu_ptr(&clic_lock);
+	u32 hwirq = d->hwirq;
+	unsigned long flags;
+	u8 attr;
+
+	/*
+	 * Write one to IP to ack an edge input, as ESP-IDF
+	 * rv_utils_intr_edge_ack() does.  A level input clears when the device
+	 * releases it.  Skip the irq_work slot: its handler clears IP before
+	 * it runs the work.  An ack here would lose an item that set IP again
+	 * in irq_work_run().
+	 */
+	if (esp32s31_clic_is_irq_work(hwirq))
+		return;
+
+	raw_spin_lock_irqsave(lock, flags);
+	attr = clic_readb(clic, hwirq, ESP32S31_CLIC_INT_ATTR);
+	if (attr & CLIC_ATTR_TRIG_EDGE)
+		clic_writeb(clic, hwirq, ESP32S31_CLIC_INT_IP, 1);
+	raw_spin_unlock_irqrestore(lock, flags);
+}
+
+static int esp32s31_clic_set_type(struct irq_data *d, unsigned int flow_type)
+{
+	struct esp32s31_clic *clic = irq_data_get_irq_chip_data(d);
+	u32 hwirq = d->hwirq;
+	unsigned long flags;
+	u8 attr;
+
+	/* The CLIC has no level-low mode, so the two Linux levels become level. */
+	switch (flow_type & IRQ_TYPE_SENSE_MASK) {
+	case IRQ_TYPE_LEVEL_HIGH:
+	case IRQ_TYPE_LEVEL_LOW:
+		attr = CLIC_ATTR_TRIG_LEVEL;
+		break;
+	case IRQ_TYPE_EDGE_RISING:
+		attr = CLIC_ATTR_TRIG_EDGE_RISE;
+		break;
+	case IRQ_TYPE_EDGE_FALLING:
+		attr = CLIC_ATTR_TRIG_EDGE_FALL;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* Linux uses only S-mode, non-vectored CLIC inputs. */
+	attr |= CLIC_ATTR_MODE_S;
+
+	raw_spin_lock_irqsave(this_cpu_ptr(&clic_lock), flags);
+	clic_writeb(clic, hwirq, ESP32S31_CLIC_INT_ATTR, attr);
+	raw_spin_unlock_irqrestore(this_cpu_ptr(&clic_lock), flags);
+
+	return 0;
+}
+
+static struct irq_chip esp32s31_clic_chip = {
+	.name = "ESP32S31-CLIC",
+	.irq_mask = esp32s31_clic_irq_mask,
+	.irq_unmask = esp32s31_clic_irq_unmask,
+	.irq_eoi = esp32s31_clic_irq_eoi,
+	.irq_set_type = esp32s31_clic_set_type,
+};
+
+#if defined(CONFIG_IRQ_WORK) && !defined(CONFIG_SMP)
+/*
+ * Upstream RISC-V has arch_irq_work_raise() in smp.c.  Thus a UP kernel
+ * waits for the next timer tick.  With NO_HZ_IDLE, this is a deadlock when
+ * the only task that can run waits for irq_work.  Tiny SRCU does this when it
+ * replaces the boot console.  CLIC local cause 1 accepts IP writes on S31
+ * v0.0, but the CLIC does not arbitrate it.  Thus use the first unused
+ * external CLIC input as a software interrupt.
+ */
+void arch_irq_work_raise(void)
+{
+	struct esp32s31_clic *clic = this_cpu_read(clic_per_cpu);
+
+	/* The first timer tick after the probe runs the queued work. */
+	if (!clic)
+		return;
+
+	clic_writeb(clic, ESP32S31_CLIC_IRQ_WORK_ID, ESP32S31_CLIC_INT_IP, 1);
+}
+
+static irqreturn_t esp32s31_irq_work_interrupt(int irq, void *dev_id)
+{
+	struct esp32s31_clic *clic = dev_id;
+	raw_spinlock_t *lock = this_cpu_ptr(&clic_lock);
+	unsigned long flags;
+
+	/*
+	 * Clear the software pending bit before the work runs.  An item that
+	 * adds more work sets IP again in irq_work_run(), and that IP must
+	 * stay set.  For the same reason, the eoi callback skips this slot.
+	 */
+	raw_spin_lock_irqsave(lock, flags);
+	clic_writeb(clic, ESP32S31_CLIC_IRQ_WORK_ID, ESP32S31_CLIC_INT_IP, 0);
+	raw_spin_unlock_irqrestore(lock, flags);
+
+	irq_work_run();
+
+	return IRQ_HANDLED;
+}
+
+static int __init esp32s31_irq_work_init(struct esp32s31_clic *clic)
+{
+	int virq;
+	int ret;
+
+	/* Slot 16 has no Interrupt Matrix source.  Software sets its IP bit. */
+	clic_writeb(clic, ESP32S31_CLIC_IRQ_WORK_ID, ESP32S31_CLIC_INT_IP, 0);
+	clic_writeb(clic, ESP32S31_CLIC_IRQ_WORK_ID, ESP32S31_CLIC_INT_ATTR,
+		    CLIC_ATTR_MODE_S | CLIC_ATTR_TRIG_EDGE_RISE);
+	clic_writeb(clic, ESP32S31_CLIC_IRQ_WORK_ID, ESP32S31_CLIC_INT_CTL,
+		    CLICCTL_MAKE(1, ESP32S31_MAX_PRIORITY));
+
+	virq = irq_create_mapping(clic->domain, ESP32S31_CLIC_IRQ_WORK_ID);
+	if (!virq)
+		return -ENOMEM;
+
+	ret = request_irq(virq, esp32s31_irq_work_interrupt, 0,
+			  "esp32s31-irq-work", clic);
+	if (ret) {
+		irq_dispose_mapping(virq);
+		return ret;
+	}
+
+	return 0;
+}
+#else
+static int __init esp32s31_irq_work_init(struct esp32s31_clic *clic)
+{
+	return 0;
+}
+#endif
+
+/*
+ * S-mode CLIC chip for the riscv,cpu-intc domain.
+ *
+ * On the ESP32-S31 in CLIC mode, the standard S-mode interrupt-enable CSRs
+ * (sie/sieh) are illegal.  Thus mask and unmask the local riscv,cpu-intc
+ * interrupts (timer, IPI) through the S-mode CLIC MMIO window.  This chip
+ * replaces the upstream riscv_intc_chip on the INTC domain.
+ */
+static void esp32s31_intc_clic_irq_mask(struct irq_data *d)
+{
+	clic_writeb(this_cpu_read(clic_per_cpu), d->hwirq,
+		    ESP32S31_CLIC_INT_IE, 0);
+}
+
+static void esp32s31_intc_clic_irq_unmask(struct irq_data *d)
+{
+	clic_writeb(this_cpu_read(clic_per_cpu), d->hwirq,
+		    ESP32S31_CLIC_INT_IE, 1);
+}
+
+static void esp32s31_intc_clic_irq_eoi(struct irq_data *d)
+{
+	/*
+	 * Empty EOI, as riscv_intc_irq_eoi().  Without it,
+	 * chained_irq_enter() and chained_irq_exit() in child irqchip drivers
+	 * do mask and unmask cycles that are not necessary.
+	 */
+}
+
+static struct irq_chip esp32s31_intc_chip = {
+	.name		= "ESP32-S31 CLIC local INTC",
+	.irq_mask	= esp32s31_intc_clic_irq_mask,
+	.irq_unmask	= esp32s31_intc_clic_irq_unmask,
+	.irq_eoi	= esp32s31_intc_clic_irq_eoi,
+};
+
+/* IRQ domain operations */
+
+static void esp32s31_intmatrix_route(struct esp32s31_clic *clic,
+				     unsigned int source,
+				     irq_hw_number_t hwirq)
+{
+	void __iomem *reg;
+	u32 val;
+
+	if (source >= ESP32S31_INTMATRIX_CORE_STRIDE / sizeof(u32)) {
+		pr_warn("CLIC: S31 interrupt source %u out of matrix range\n",
+			source);
+		return;
+	}
+
+	reg = clic->intmatrix_regs + source * sizeof(u32);
+	val = readl(reg);
+	val &= ~(ESP32S31_INTMATRIX_MAP_MASK |
+		 ESP32S31_INTMATRIX_PASS_LEVEL_MASK);
+	val |= (hwirq & ESP32S31_INTMATRIX_MAP_MASK) |
+	       ESP32S31_INTMATRIX_PASS_LEVEL_S;
+	writel(val, reg);
+}
+
+/*
+ * ESP32-S31 interrupt specifiers are <CLIC ID, SoC interrupt source, type>.
+ * For example, UART0 is <32 9 IRQ_TYPE_LEVEL_HIGH>.  Source 9 is
+ * ETS_UART0_INTR_SOURCE in the S31 ESP-IDF table.
+ */
+static int esp32s31_clic_parse_fwspec(struct irq_fwspec *fwspec,
+				     irq_hw_number_t *hwirq,
+				     unsigned int *source,
+				     unsigned int *type)
+{
+	if (fwspec->param_count != 3)
+		return -EINVAL;
+
+	*hwirq = fwspec->param[0];
+	*source = fwspec->param[1];
+	*type = fwspec->param[2] & IRQ_TYPE_SENSE_MASK;
+
+	return 0;
+}
+
+static int esp32s31_clic_domain_map(struct irq_domain *d, unsigned int irq,
+				   irq_hw_number_t hwirq)
+{
+	struct esp32s31_clic *clic = d->host_data;
+
+	irq_domain_set_info(d, irq, hwirq, &esp32s31_clic_chip, clic,
+			    handle_fasteoi_irq, NULL, NULL);
+
+	return 0;
+}
+
+static int esp32s31_clic_domain_translate(struct irq_domain *domain,
+					 struct irq_fwspec *fwspec,
+					 irq_hw_number_t *hwirq,
+					 unsigned int *type)
+{
+	unsigned int source;
+
+	return esp32s31_clic_parse_fwspec(fwspec, hwirq, &source, type);
+}
+
+static int esp32s31_clic_domain_alloc(struct irq_domain *domain,
+				     unsigned int virq, unsigned int nr_irqs,
+				     void *data)
+{
+	struct esp32s31_clic *clic = domain->host_data;
+	struct irq_fwspec *fwspec = data;
+	irq_hw_number_t hwirq;
+	unsigned int source, type;
+	unsigned long flags;
+
+	if (esp32s31_clic_parse_fwspec(fwspec, &hwirq, &source, &type))
+		return -EINVAL;
+
+	if (hwirq >= CLIC_NR_IRQS)
+		return -EINVAL;
+
+	esp32s31_intmatrix_route(clic, source, hwirq);
+
+	irq_domain_set_info(domain, virq, hwirq, &esp32s31_clic_chip, clic,
+			    handle_fasteoi_irq, NULL, NULL);
+
+	raw_spin_lock_irqsave(this_cpu_ptr(&clic_lock), flags);
+	clic_writeb(clic, hwirq, ESP32S31_CLIC_INT_CTL,
+		    CLICCTL_MAKE(1, ESP32S31_MAX_PRIORITY));
+	raw_spin_unlock_irqrestore(this_cpu_ptr(&clic_lock), flags);
+
+	if (type != IRQ_TYPE_NONE)
+		esp32s31_clic_set_type(irq_get_irq_data(virq), type);
+
+	return 0;
+}
+
+static void esp32s31_clic_domain_free(struct irq_domain *domain,
+				     unsigned int virq, unsigned int nr_irqs)
+{
+	struct irq_data *data = irq_domain_get_irq_data(domain, virq);
+
+	irq_domain_reset_irq_data(data);
+}
+
+static const struct irq_domain_ops esp32s31_clic_domain_ops = {
+	.map = esp32s31_clic_domain_map,
+	.alloc = esp32s31_clic_domain_alloc,
+	.free = esp32s31_clic_domain_free,
+	.translate = esp32s31_clic_domain_translate,
+};
+
+/*
+ * The assembly trampoline calls this.  It already removed the synchronous
+ * exceptions.  regs->cause has the unchanged CLIC cause.
+ */
+static void (*fallback_handle_irq)(struct pt_regs *);
+
+void esp32s31_clic_handle_irq(struct pt_regs *regs)
+{
+	struct esp32s31_clic *clic = this_cpu_read(clic_per_cpu);
+	unsigned long raw_cause;
+	unsigned long irq_id;
+
+	if (WARN_ON(!clic))
+		return;
+
+	raw_cause = regs->cause;
+	irq_id = raw_cause & CLIC_CAUSE_EXCCODE_MASK;
+
+	/*
+	 * Interrupt IDs below the first CLIC external source are standard
+	 * local RISC-V interrupts for the riscv,cpu-intc domain.
+	 */
+	if (irq_id < CLIC_EXT_MIN_ID) {
+		/* Clear pending state for S-mode edge-triggered local interrupts. */
+		u8 attr = clic_readb(clic, irq_id, ESP32S31_CLIC_INT_ATTR);
+
+		if (attr & CLIC_ATTR_TRIG_EDGE)
+			clic_writeb(clic, irq_id, ESP32S31_CLIC_INT_IP, 0);
+		regs->cause = CAUSE_IRQ_FLAG | irq_id;
+		if (fallback_handle_irq)
+			fallback_handle_irq(regs);
+		regs->cause = raw_cause;
+		return;
+	}
+
+	if (irq_id >= CLIC_NR_IRQS) {
+		pr_warn_ratelimited("CLIC: spurious interrupt %lu\n", irq_id);
+		return;
+	}
+
+	generic_handle_domain_irq(clic->domain, irq_id);
+}
+
+/* Initialization */
+
+static void __init esp32s31_clic_init_cpu(struct esp32s31_clic *clic, int cpu)
+{
+	int i;
+
+	csr_write(CSR_SINTTHRESH, 0);
+
+	/*
+	 * OpenSBI controls the local CLIC slots.  Linux sets up only the
+	 * external inputs.  It does not change the machine and supervisor
+	 * timer inputs.
+	 */
+	for (i = CLIC_EXT_MIN_ID; i < CLIC_NR_IRQS; i++) {
+		clic_writeb(clic, i, ESP32S31_CLIC_INT_IP, 0);
+		clic_writeb(clic, i, ESP32S31_CLIC_INT_IE, 0);
+		clic_writeb(clic, i, ESP32S31_CLIC_INT_ATTR,
+			    CLIC_ATTR_MODE_S | CLIC_ATTR_TRIG_LEVEL);
+		clic_writeb(clic, i, ESP32S31_CLIC_INT_CTL,
+			    CLICCTL_MAKE(1, ESP32S31_MAX_PRIORITY));
+	}
+
+	per_cpu(clic_per_cpu, cpu) = clic;
+}
+
+static int __init esp32s31_clic_probe(struct device_node *node,
+				     struct device_node *parent)
+{
+	struct fwnode_handle *intc_fwnode;
+	struct irq_domain *intc_domain;
+	struct esp32s31_clic *clic;
+	struct resource res;
+	unsigned long hart;
+	int ret;
+
+	clic = kzalloc_obj(*clic, GFP_KERNEL);
+	if (!clic)
+		return -ENOMEM;
+
+	/*
+	 * Map the full S-mode window.  It includes the threshold register and
+	 * the registers of the other core at +0x10000.
+	 */
+	ret = of_address_to_resource(node, 0, &res);
+	if (ret)
+		goto err_free;
+
+	clic->regs = ioremap(res.start, resource_size(&res));
+	if (!clic->regs) {
+		pr_err("CLIC: Failed to ioremap 0x%llx\n",
+		       (unsigned long long)res.start);
+		ret = -ENOMEM;
+		goto err_free;
+	}
+
+	ret = of_address_to_resource(node, 1, &res);
+	if (ret) {
+		pr_err("CLIC: missing interrupt matrix resource\n");
+		goto err_unmap;
+	}
+
+	hart = cpuid_to_hartid_map(0);
+	if ((hart + 1) * ESP32S31_INTMATRIX_CORE_STRIDE > resource_size(&res)) {
+		pr_err("CLIC: hart %lu has no interrupt matrix block\n", hart);
+		ret = -EINVAL;
+		goto err_unmap;
+	}
+
+	clic->intmatrix_regs = ioremap(res.start +
+				       hart * ESP32S31_INTMATRIX_CORE_STRIDE,
+				       ESP32S31_INTMATRIX_CORE_STRIDE);
+	if (!clic->intmatrix_regs) {
+		pr_err("CLIC: Failed to ioremap S31 interrupt matrix\n");
+		ret = -ENOMEM;
+		goto err_unmap;
+	}
+
+	clic->domain = irq_domain_create_linear(of_fwnode_handle(node),
+						CLIC_NR_IRQS,
+						&esp32s31_clic_domain_ops, clic);
+	if (!clic->domain) {
+		pr_err("CLIC: Failed to create IRQ domain\n");
+		ret = -ENOMEM;
+		goto err_unmap;
+	}
+
+	esp32s31_clic_init_cpu(clic, 0);
+
+	/* Use riscv_intc_irq() for the local causes (IDs < 16). */
+	fallback_handle_irq = handle_arch_irq;
+	handle_arch_irq = esp32s31_clic_handle_irq;
+
+	intc_fwnode = riscv_get_intc_hwnode();
+	intc_domain = intc_fwnode ?
+		irq_find_matching_fwnode(intc_fwnode, DOMAIN_BUS_ANY) : NULL;
+	if (intc_domain) {
+		intc_domain->host_data = &esp32s31_intc_chip;
+		ret = esp32s31_irq_work_init(clic);
+		if (ret)
+			pr_warn("CLIC: failed to initialize UP irq_work: %d\n",
+				ret);
+	} else {
+		pr_warn("CLIC: no INTC domain - local IRQ masking unavailable\n");
+	}
+
+	pr_info("CLIC: initialized, %u interrupts, S-mode non-vectored\n",
+		CLIC_NR_IRQS);
+
+	return 0;
+
+err_unmap:
+	if (clic->intmatrix_regs)
+		iounmap(clic->intmatrix_regs);
+	iounmap(clic->regs);
+err_free:
+	kfree(clic);
+	return ret;
+}
+
+IRQCHIP_DECLARE(esp32s31_clic, "esp,esp32s31-clic", esp32s31_clic_probe);
diff --git a/drivers/leds/rgb/leds-esp32s31-ws2812.c b/drivers/leds/rgb/leds-esp32s31-ws2812.c
new file mode 100644
--- /dev/null
+++ b/drivers/leds/rgb/leds-esp32s31-ws2812.c
@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Author: Marco Müller <hello@annoyedmilk.ch>
+ *
+ * WS2812 RGB LED on RMT channel 0 of the ESP32-S31.
+ *
+ * The loader sets the RMT clocks, a 50 ns channel tick and the GPIO route
+ * before Linux starts, because hart 0 also writes the clock registers.  This
+ * driver writes only the channel 0 registers and the channel 0 RAM.
+ *
+ * One RMT word holds two pulses: duration and level for each.  A WS2812 bit
+ * is one high pulse and one low pulse, so one word sends one bit.  24 words
+ * send one LED in GRB order, and a word with duration 0 ends the sequence.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/led-class-multicolor.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define RMT_CH0_CONF0			0x20
+#define RMT_CONF0_TX_START		BIT(0)
+#define RMT_CONF0_MEM_RD_RST		BIT(1)
+#define RMT_CONF0_APB_MEM_RST		BIT(2)
+#define RMT_CONF0_CONF_UPDATE		BIT(24)
+#define RMT_INT_RAW			0x70
+#define RMT_INT_CLR			0x7c
+#define RMT_INT_CH0_TX_END		BIT(0)
+#define RMT_CH0_RAM			0x800
+
+/* Pulse lengths in 50 ns ticks, from the WS2812B data sheet. */
+#define WS2812_T0H			8	/* 0.40 us */
+#define WS2812_T0L			17	/* 0.85 us */
+#define WS2812_T1H			16	/* 0.80 us */
+#define WS2812_T1L			9	/* 0.45 us */
+/* Newer WS2812B parts need more than 280 us low to latch. */
+#define WS2812_RESET_US			300
+
+#define RMT_WORD(d0, l0, d1, l1) \
+	((u32)(d0) | ((u32)(l0) << 15) | ((u32)(d1) << 16) | ((u32)(l1) << 31))
+
+struct esp32s31_ws2812 {
+	struct led_classdev_mc mc;
+	struct mc_subled subled[3];
+	void __iomem *base;
+	struct mutex lock;
+};
+
+static void esp32s31_ws2812_conf0(struct esp32s31_ws2812 *priv, u32 set)
+{
+	writel(readl(priv->base + RMT_CH0_CONF0) | set,
+	       priv->base + RMT_CH0_CONF0);
+}
+
+static int esp32s31_ws2812_send(struct esp32s31_ws2812 *priv, u32 grb)
+{
+	u32 conf0, raw;
+	int i, ret;
+
+	for (i = 0; i < 24; i++) {
+		bool one = grb & BIT(23 - i);
+
+		writel(one ? RMT_WORD(WS2812_T1H, 1, WS2812_T1L, 0) :
+			     RMT_WORD(WS2812_T0H, 1, WS2812_T0L, 0),
+		       priv->base + RMT_CH0_RAM + 4 * i);
+	}
+	writel(0, priv->base + RMT_CH0_RAM + 4 * 24);
+
+	/* Set the read pointer back to the start of the channel RAM. */
+	conf0 = readl(priv->base + RMT_CH0_CONF0);
+	writel(conf0 | RMT_CONF0_MEM_RD_RST | RMT_CONF0_APB_MEM_RST,
+	       priv->base + RMT_CH0_CONF0);
+	writel(conf0 & ~(RMT_CONF0_MEM_RD_RST | RMT_CONF0_APB_MEM_RST),
+	       priv->base + RMT_CH0_CONF0);
+
+	writel(RMT_INT_CH0_TX_END, priv->base + RMT_INT_CLR);
+	esp32s31_ws2812_conf0(priv, RMT_CONF0_CONF_UPDATE);
+	esp32s31_ws2812_conf0(priv, RMT_CONF0_TX_START);
+
+	/* 24 bits take 30 us. */
+	ret = readl_poll_timeout(priv->base + RMT_INT_RAW, raw,
+				 raw & RMT_INT_CH0_TX_END, 5, 1000);
+	writel(RMT_INT_CH0_TX_END, priv->base + RMT_INT_CLR);
+	usleep_range(WS2812_RESET_US, WS2812_RESET_US + 50);
+
+	return ret;
+}
+
+static int esp32s31_ws2812_set(struct led_classdev *cdev,
+			       enum led_brightness brightness)
+{
+	struct led_classdev_mc *mc = lcdev_to_mccdev(cdev);
+	struct esp32s31_ws2812 *priv =
+		container_of(mc, struct esp32s31_ws2812, mc);
+	u32 grb;
+	int ret;
+
+	led_mc_calc_color_components(mc, brightness);
+
+	/* subled 0 is red, 1 is green, 2 is blue; the wire order is GRB. */
+	grb = (mc->subled_info[1].brightness << 16) |
+	      (mc->subled_info[0].brightness << 8) |
+	      mc->subled_info[2].brightness;
+
+	mutex_lock(&priv->lock);
+	ret = esp32s31_ws2812_send(priv, grb);
+	mutex_unlock(&priv->lock);
+
+	return ret;
+}
+
+static int esp32s31_ws2812_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct led_init_data init_data = { };
+	struct esp32s31_ws2812 *priv;
+	struct device_node *child;
+	static const int colors[] = {
+		LED_COLOR_ID_RED, LED_COLOR_ID_GREEN, LED_COLOR_ID_BLUE,
+	};
+	int i, ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->base))
+		return PTR_ERR(priv->base);
+
+	ret = devm_mutex_init(dev, &priv->lock);
+	if (ret)
+		return ret;
+
+	child = of_get_next_available_child(dev->of_node, NULL);
+	if (!child)
+		return dev_err_probe(dev, -EINVAL, "no LED node\n");
+
+	for (i = 0; i < ARRAY_SIZE(colors); i++) {
+		priv->subled[i].color_index = colors[i];
+		priv->subled[i].intensity = LED_FULL;
+	}
+
+	priv->mc.subled_info = priv->subled;
+	priv->mc.num_colors = ARRAY_SIZE(colors);
+	priv->mc.led_cdev.max_brightness = LED_FULL;
+	priv->mc.led_cdev.brightness_set_blocking = esp32s31_ws2812_set;
+
+	init_data.fwnode = of_fwnode_handle(child);
+	ret = devm_led_classdev_multicolor_register_ext(dev, &priv->mc,
+							&init_data);
+	of_node_put(child);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot register the LED\n");
+
+	/* The LED can keep a color from before a reset. */
+	return esp32s31_ws2812_send(priv, 0);
+}
+
+static const struct of_device_id esp32s31_ws2812_of_match[] = {
+	{ .compatible = "esp,esp32s31-rmt-ws2812" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, esp32s31_ws2812_of_match);
+
+static struct platform_driver esp32s31_ws2812_driver = {
+	.probe = esp32s31_ws2812_probe,
+	.driver = {
+		.name = "esp32s31-ws2812",
+		.of_match_table = esp32s31_ws2812_of_match,
+	},
+};
+module_platform_driver(esp32s31_ws2812_driver);
+
+MODULE_DESCRIPTION("ESP32-S31 RMT WS2812 RGB LED driver");
+MODULE_AUTHOR("Marco Müller <hello@annoyedmilk.ch>");
+MODULE_LICENSE("GPL");
diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-esp32s31.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-esp32s31.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-esp32s31.c
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Author: Roan Brand <brandroan@gmail.com>
+ *
+ * DWMAC glue of the ESP32-S31: a DesignWare GMAC 3.70a with RGMII.  The
+ * interface mode and the RGMII clock paths are in CNNT_SYS, a syscon.  The
+ * GMAC takes the mode at its reset, so the glue sets it in the init callback,
+ * which stmmac calls before it resets the GMAC and at resume.  The TX clock
+ * comes from the clock framework.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/phy.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#include "stmmac.h"
+#include "stmmac_platform.h"
+
+#define CNNT_EMAC_RMII_PAD_CTRL		0x44
+#define CNNT_EMAC_RMII_CTRL		0x48
+#define CNNT_EMAC_RX_CTRL		0x4c
+#define CNNT_EMAC_TX_CTRL		0x50
+#define CNNT_GMAC_CTRL0			0x60
+
+#define RMII_PAD_CLK_EN			BIT(1)
+#define RMII_PAD_CLK_INV_EN		BIT(2)
+#define RMII_CLK_SEL			BIT(0)
+#define RMII_CLK_EN			BIT(1)
+#define RMII_PAD_OUT_CLK_EN		BIT(2)
+/* RX_CTRL and TX_CTRL */
+#define RXTX_PAD_CLK_EN			BIT(0)
+#define RXTX_PAD_CLK_INV_EN		BIT(1)
+#define RXTX_CLK_SEL			BIT(2)
+#define RXTX_180_CLK_EN			BIT(3)
+#define GMAC_PHY_INTF_SEL		GENMASK(4, 2)
+#define GMAC_PHY_INTF_RGMII		1
+#define CNNT_PAD_GMAC_DED_SEL		BIT(1)
+
+struct esp32s31_reg_update {
+	u32 reg;
+	u32 mask;
+	u32 val;
+};
+
+/* RX clock from the RX_CLK pad, TX clock out on the RMII clock pad */
+static const struct esp32s31_reg_update esp32s31_rgmii[] = {
+	{ CNNT_GMAC_CTRL0, GMAC_PHY_INTF_SEL,
+	  FIELD_PREP_CONST(GMAC_PHY_INTF_SEL, GMAC_PHY_INTF_RGMII) },
+	{ CNNT_EMAC_RMII_PAD_CTRL, RMII_PAD_CLK_EN | RMII_PAD_CLK_INV_EN, 0 },
+	{ CNNT_EMAC_RMII_CTRL, RMII_CLK_SEL | RMII_CLK_EN | RMII_PAD_OUT_CLK_EN,
+	  RMII_PAD_OUT_CLK_EN },
+	{ CNNT_EMAC_RX_CTRL, RXTX_PAD_CLK_EN | RXTX_PAD_CLK_INV_EN |
+	  RXTX_CLK_SEL | RXTX_180_CLK_EN,
+	  RXTX_PAD_CLK_EN | RXTX_CLK_SEL | RXTX_180_CLK_EN },
+	{ CNNT_EMAC_TX_CTRL, RXTX_PAD_CLK_EN | RXTX_CLK_SEL | RXTX_180_CLK_EN,
+	  RXTX_180_CLK_EN },
+};
+
+static int esp32s31_dwmac_init(struct device *dev, void *bsp_priv)
+{
+	struct regmap *regmap = bsp_priv;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(esp32s31_rgmii); i++) {
+		const struct esp32s31_reg_update *u = &esp32s31_rgmii[i];
+
+		ret = regmap_update_bits(regmap, u->reg, u->mask, u->val);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int esp32s31_dwmac_probe(struct platform_device *pdev)
+{
+	struct plat_stmmacenet_data *plat_dat;
+	struct stmmac_resources stmmac_res;
+	struct device *dev = &pdev->dev;
+	struct regmap *regmap;
+	void __iomem *pad;
+	int ret;
+
+	ret = stmmac_get_platform_resources(pdev, &stmmac_res);
+	if (ret)
+		return ret;
+
+	plat_dat = devm_stmmac_probe_config_dt(pdev, stmmac_res.mac);
+	if (IS_ERR(plat_dat))
+		return dev_err_probe(dev, PTR_ERR(plat_dat),
+				     "failed to parse DT parameters\n");
+
+	if (!phy_interface_mode_is_rgmii(plat_dat->phy_interface))
+		return dev_err_probe(dev, -EINVAL, "only RGMII is supported\n");
+
+	/* GPIO13-19 are CNNT pads: the GMAC signals need their own pad control. */
+	pad = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(pad))
+		return PTR_ERR(pad);
+	writel(readl(pad) | CNNT_PAD_GMAC_DED_SEL, pad);
+
+	regmap = syscon_regmap_lookup_by_phandle(dev->of_node, "esp,cnnt-sys");
+	if (IS_ERR(regmap))
+		return dev_err_probe(dev, PTR_ERR(regmap),
+				     "failed to get CNNT_SYS\n");
+
+	plat_dat->clk_tx_i = devm_clk_get_enabled(dev, "ref");
+	if (IS_ERR(plat_dat->clk_tx_i))
+		return dev_err_probe(dev, PTR_ERR(plat_dat->clk_tx_i),
+				     "failed to get the TX clock\n");
+	plat_dat->set_clk_tx_rate = stmmac_set_clk_tx_rate;
+
+	/*
+	 * stmmac selects the descriptor ops before it reads the DMA
+	 * capabilities, so it must know the enhanced descriptors here.
+	 */
+	plat_dat->enh_desc = true;
+	plat_dat->bsp_priv = regmap;
+	plat_dat->init = esp32s31_dwmac_init;
+
+	return devm_stmmac_pltfr_probe(pdev, plat_dat, &stmmac_res);
+}
+
+static const struct of_device_id esp32s31_dwmac_match[] = {
+	{ .compatible = "esp,esp32s31-dwmac" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, esp32s31_dwmac_match);
+
+static struct platform_driver esp32s31_dwmac_driver = {
+	.probe = esp32s31_dwmac_probe,
+	.driver = {
+		.name = "esp32s31-dwmac",
+		.pm = &stmmac_pltfr_pm_ops,
+		.of_match_table = esp32s31_dwmac_match,
+	},
+};
+module_platform_driver(esp32s31_dwmac_driver);
+
+MODULE_DESCRIPTION("ESP32-S31 DWMAC glue driver");
+MODULE_AUTHOR("Roan Brand <brandroan@gmail.com>");
+MODULE_LICENSE("GPL");
diff --git a/drivers/net/wireless/espressif/Kconfig b/drivers/net/wireless/espressif/Kconfig
