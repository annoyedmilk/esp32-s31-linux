+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpio/esp,esp32s31-gpio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 GPIO controller
+
+maintainers:
+  - Marco Mueller <hello@annoyedmilk.ch>
+
+description:
+  Two blocks control each pad. IO MUX selects the peripheral that uses the
+  pad. The GPIO matrix connects a signal to it. Thus a GPIO needs the two
+  register windows. Of the 62 pads, GPIO29 and GPIO41 have no package pin.
+
+properties:
+  compatible:
+    const: esp,esp32s31-gpio
+
+  reg:
+    items:
+      - description: GPIO matrix registers
+      - description: IO MUX registers
+
+  reg-names:
+    items:
+      - const: gpio
+      - const: iomux
+
+  gpio-controller: true
+
+  "#gpio-cells":
+    const: 2
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - gpio-controller
+  - "#gpio-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    gpio@20583000 {
+        compatible = "esp,esp32s31-gpio";
+        reg = <0x20583000 0x1000>, <0x20582000 0x1000>;
+        reg-names = "gpio", "iomux";
+        gpio-controller;
+        #gpio-cells = <2>;
+    };
diff --git a/Documentation/devicetree/bindings/interrupt-controller/esp,esp32s31-clic.yaml b/Documentation/devicetree/bindings/interrupt-controller/esp,esp32s31-clic.yaml
new file mode 100644
