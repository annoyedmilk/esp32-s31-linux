+++ b/drivers/net/wireless/espressif/Kconfig
@@ -0,0 +1,11 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config ESP32S31_HOSTED
+	bool "ESP-Hosted for the ESP32-S31 (shared memory)"
+	depends on SOC_ESP32S31 && CFG80211=y && BT=y
+	help
+	  The ESP-Hosted host driver for the ESP-Hosted firmware on hart 0:
+	  Wi-Fi (cfg80211 full-MAC) and Bluetooth HCI.  The frames go
+	  through rings in internal SRAM.  Buildroot copies the upstream driver into
+	  esp_hosted/ (br2-external/linux).  With MTD, the flash window of
+	  the firmware is the MTD device esp32s31-flash, with the partitions
+	  of the "flash" child node.
