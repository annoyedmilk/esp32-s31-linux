diff --git a/arch/riscv/boot/dts/espressif/esp32s31.dtsi b/arch/riscv/boot/dts/espressif/esp32s31.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/riscv/boot/dts/espressif/esp32s31.dtsi
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Espressif ESP32-S31 minimal Device Tree Source.
+ * Author: Marco Müller <hello@annoyedmilk.ch>
+ */
+
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "esp,esp32s31";
+
+	memory@50000000 {
+		device_type = "memory";
+		/* 16MB RAM */
+		reg = <0x50000000 0x01000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* Scanned out by the loader's DMA across the handoff. */
+		fb_region: framebuffer@50f40000 {
+			reg = <0x50f40000 0xbc000>;
+			no-map;
+		};
+
+		/* M-mode firmware; Linux must never map or allocate it. */
+		opensbi_region: opensbi@50e00000 {
+			reg = <0x50e00000 0x40000>;
+			no-map;
+		};
+
+		/*
+		 * PSRAM has no uncached alias and Sv32 carries no
+		 * cacheability attribute, so coherent allocations come from
+		 * internal SRAM, which bypasses the data cache.
+		 */
+		dma_pool: dma-pool@2f040000 {
+			compatible = "shared-dma-pool";
+			reg = <0x2f040000 0x10000>;
+			linux,dma-default;
+			no-map;
+		};
+	};
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		timebase-frequency = <320000000>;
+
+		/*
+		 * Hart 0 stays in M-mode running the resident ESP-IDF
+		 * firmware that owns the WLAN modem; Linux is given hart 1.
+		 */
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "esp,esp32s31", "riscv";
+			reg = <1>;
+			riscv,isa-base = "rv32i";
+			riscv,isa-extensions = "i", "m", "a", "zba", "zbb",
+					       "zbs", "c", "zicntr", "zicsr",
+					       "zifencei";
+			mmu-type = "riscv,sv32";
+			cpu1_intc: interrupt-controller {
+				#interrupt-cells = <1>;
+				interrupt-controller;
+				compatible = "riscv,cpu-intc";
+			};
+		};
+	};
+
+	xtal: oscillator {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <40000000>;
+	};
+
+	/* The PHY driver gates the generated 12 MHz USB reference clock. */
+	usb_ref_clk: usb-ref-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <12000000>;
+	};
+
+	sdmmc_clk: sdmmc-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <50000000>;
+	};
+
+	soc {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "simple-bus";
+		ranges;
+		/*
+		 * No bus master on this SoC is coherent with the data cache,
+		 * and the hart implements no Zicbom, so every DMA-capable
+		 * device below relies on the cache controller's sync engine.
+		 */
+		dma-noncoherent;
+
+		cache: cache-controller@2c000000 {
+			compatible = "esp,esp32s31-cache";
+			reg = <0x2c000000 0x1000>;
+			cache-line-size = <64>;
+			cache-level = <1>;
+		};
+
+		gpio: gpio@20583000 {
+			compatible = "esp,esp32s31-gpio";
+			reg = <0x20583000 0x1000>, <0x20582000 0x1000>;
+			reg-names = "gpio", "iomux";
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		clic: interrupt-controller@10a00000 {
+			#interrupt-cells = <3>;
+			#address-cells = <0>;
+			compatible = "esp,esp32s31-clic";
+			reg = <0x10a00000 0x20000>, <0x20585000 0x1000>;
+			reg-names = "clic", "intmatrix";
+			interrupt-controller;
+		};
+
+		sdmmc0: mmc@20342000 {
+			compatible = "esp,esp32s31-dw-mshc", "snps,dw-mshc";
+			reg = <0x20342000 0x1000>;
+			interrupt-parent = <&clic>;
+			interrupts = <34 3 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&sdmmc_clk>, <&sdmmc_clk>;
+			clock-names = "biu", "ciu";
+			clock-frequency = <50000000>;
+			fifo-depth = <512>;
+			bus-width = <4>;
+			cap-sd-highspeed;
+			no-1-8-v;
+			disable-wp;
+			status = "disabled";
+		};
+
+		uart0: serial@2038a000 {
+			compatible = "esp,esp32s3-uart";
+			reg = <0x2038a000 0x1000>;
+			interrupt-parent = <&clic>;
+			interrupts = <32 9 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&xtal>;
+		};
+
+		trng: rng@20814000 {
+			compatible = "esp,esp32s31-trng";
+			reg = <0x20814000 0x100>, <0x2071003c 0x4>;
+			reg-names = "trng", "clkrst";
+		};
+
+		/*
+		 * The rings live in internal SRAM and the doorbells are the
+		 * cross-core interrupt registers: FROM_CPU_0 is raised by the
+		 * firmware and acknowledged here, FROM_CPU_1 is raised here.
+		 */
+		wifi: wifi@2f050000 {
+			compatible = "esp,esp32s31-wifi";
+			reg = <0x2f050000 0x10000>, <0x20586010 0x8>;
+			reg-names = "ipc", "doorbell";
+			interrupt-parent = <&clic>;
+			interrupts = <35 65 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		usb_phy: phy@205870ac {
+			compatible = "esp,esp32s31-usb-phy";
+			reg = <0x205870ac 0x4>, <0x20359030 0x4>,
+			      <0x20589024 0x4>, <0x205890b0 0x4>,
+			      <0x20380018 0x4>;
+			reg-names = "clkrst", "cnnt", "usb-ctrl", "otghs-ctrl",
+				    "utmi-fc06";
+			#phy-cells = <0>;
+		};
+
+		usb0: usb@20300000 {
+			compatible = "esp,esp32s31-usb", "snps,dwc2";
+			/*
+			 * Whole aperture up to the PAU block: the per-channel
+			 * FIFO windows sit at 0x1000 * (channel + 1).
+			 */
+			reg = <0x20300000 0x40000>;
+			interrupt-parent = <&clic>;
+			interrupts = <33 99 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&usb_ref_clk>;
+			clock-names = "otg";
+			phys = <&usb_phy>;
+			phy-names = "usb2-phy";
+			dr_mode = "host";
+			disable-over-current;
+		};
+
+	};
+};
diff --git a/arch/riscv/boot/dts/espressif/esp32s31_generic.dts b/arch/riscv/boot/dts/espressif/esp32s31_generic.dts
new file mode 100644
--- /dev/null
+++ b/arch/riscv/boot/dts/espressif/esp32s31_generic.dts
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ESP32-S31 Device Tree Source
+ * Author: Marco Müller <hello@annoyedmilk.ch>
+ */
+/dts-v1/;
+#include "esp32s31.dtsi"
+
+/ {
+	model = "Espressif ESP32-S31 S-mode (generic)";
+	compatible = "esp,esp32s31";
+
+	chosen {
+		linux,initrd-start = <0x50800000>;
+		linux,initrd-end = <0x50A00000>;
+		stdout-path = "serial0:115200n8";
+
+		/*
+		 * The loader brings up the Korvo-1's 800x480 RGB panel and
+		 * leaves the LCD_CAM DMA scanning out an RGB565 buffer at the
+		 * top of PSRAM, so Linux only has to describe it; the memory
+		 * itself is reserved as fb_region.  of_platform creates this
+		 * device explicitly for a simple-framebuffer under /chosen.
+		 * A build whose loader leaves GPIO33/34 to USB Serial/JTAG
+		 * skips display init, and then fb0 exists but drives nothing.
+		 */
+		framebuffer: framebuffer@50f40000 {
+			compatible = "simple-framebuffer";
+			reg = <0x50f40000 (800 * 480 * 2)>;
+			width = <800>;
+			height = <480>;
+			stride = <(800 * 2)>;
+			format = "r5g6b5";
+			memory-region = <&fb_region>;
+		};
+	};
+};
+
+&sdmmc0 { status = "okay"; };
diff --git a/arch/riscv/include/asm/esp32s31-cache.h b/arch/riscv/include/asm/esp32s31-cache.h
new file mode 100644
