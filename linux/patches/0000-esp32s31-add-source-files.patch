+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/esp,esp32s31-dwmac.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 DWMAC glue layer
+
+maintainers:
+  - Roan Brand <brandroan@gmail.com>
+
+description:
+  The DesignWare GMAC 3.70a of the ESP32-S31, with RGMII. The interface mode
+  and the RGMII clock paths are in the CNNT_SYS block, which also makes the
+  TX clock and has the reset of the GMAC.
+
+select:
+  properties:
+    compatible:
+      contains:
+        const: esp,esp32s31-dwmac
+  required:
+    - compatible
+
+properties:
+  compatible:
+    items:
+      - const: esp,esp32s31-dwmac
+      - const: snps,dwmac-3.70a
+
+  reg:
+    items:
+      - description: GMAC registers
+      - description: CNNT pad control register of GPIO13-19
+
+  clocks:
+    items:
+      - description: Bus clock, which also makes the MDC clock
+      - description: RGMII TX clock, 125, 25 or 2.5 MHz for the link speed
+
+  clock-names:
+    items:
+      - const: stmmaceth
+      - const: ref
+
+  resets:
+    maxItems: 1
+
+  reset-names:
+    const: stmmaceth
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-names:
+    const: macirq
+
+  esp,cnnt-sys:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The CNNT_SYS block, with the interface mode registers.
+
+  phy-mode:
+    enum:
+      - rgmii
+      - rgmii-id
+      - rgmii-rxid
+      - rgmii-txid
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - interrupts
+  - interrupt-names
+  - esp,cnnt-sys
+
+allOf:
+  - $ref: snps,dwmac.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/esp32s31-clk.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    ethernet@20350000 {
+      compatible = "esp,esp32s31-dwmac", "snps,dwmac-3.70a";
+      reg = <0x20350000 0x4000>, <0x205883f4 0x4>;
+      interrupt-parent = <&clic>;
+      interrupts = <36 98 IRQ_TYPE_LEVEL_HIGH>;
+      interrupt-names = "macirq";
+      clocks = <&hp_clkrst ESP32S31_CLK_EMAC_SYS>,
+               <&cnnt_sys ESP32S31_CNNT_CLK_EMAC_REF>;
+      clock-names = "stmmaceth", "ref";
+      resets = <&cnnt_sys ESP32S31_CNNT_RST_EMAC>;
+      reset-names = "stmmaceth";
+      esp,cnnt-sys = <&cnnt_sys>;
+      phy-mode = "rgmii-id";
+      snps,pbl = <16>;
+      snps,no-pbl-x8;
+      snps,force_thresh_dma_mode;
+    };
diff --git a/Documentation/devicetree/bindings/net/wireless/esp,esp32s31-hosted-shm.yaml b/Documentation/devicetree/bindings/net/wireless/esp,esp32s31-hosted-shm.yaml
