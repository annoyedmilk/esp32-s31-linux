diff --git a/arch/riscv/boot/dts/espressif/esp32s31.dts b/arch/riscv/boot/dts/espressif/esp32s31.dts
new file mode 100644
--- /dev/null
+++ b/arch/riscv/boot/dts/espressif/esp32s31.dts
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * The ESP32-S31-WROOM-3-N16R16V module alone (16 MB flash, 16 MB PSRAM):
+ * UART0, Wi-Fi and Bluetooth.  The root is in the flash window of the
+ * firmware.
+ */
+/dts-v1/;
+#include "esp32s31.dtsi"
+
+/ {
+	model = "Espressif ESP32-S31-WROOM-3-N16R16V";
+	compatible = "esp,esp32s31-wroom-3", "esp,esp32s31";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+/*
+ * The "rootfs" and "data" partitions of bootloader/partitions-esp32s31.csv,
+ * from the start of "rootfs".
+ */
+&wifi {
+	flash {
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "rootfs";
+				reg = <0x0 0x780000>;
+				read-only;
+			};
+
+			partition@780000 {
+				label = "data";
+				reg = <0x780000 0x270000>;
+			};
+		};
+	};
+};
diff --git a/arch/riscv/boot/dts/espressif/esp32s31.dtsi b/arch/riscv/boot/dts/espressif/esp32s31.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/riscv/boot/dts/espressif/esp32s31.dtsi
@@ -0,0 +1,340 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Espressif ESP32-S31 minimal device tree.
+ * Author: Marco Müller <hello@annoyedmilk.ch>
+ */
+
+#include <dt-bindings/clock/esp32s31-clk.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/esp32s31-pinctrl.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	compatible = "esp,esp32s31";
+
+	memory@50000000 {
+		device_type = "memory";
+		/* 16 MiB PSRAM */
+		reg = <0x50000000 0x01000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* M-mode firmware.  Linux must never map or allocate it. */
+		opensbi_region: opensbi@50f00000 {
+			reg = <0x50f00000 0x40000>;
+			no-map;
+		};
+
+		/*
+		 * Sv32 has no cacheability attribute, and the port does not
+		 * use the uncached alias of PSRAM at 0xc0000000.  Thus coherent
+		 * allocations come from internal SRAM, which the data cache
+		 * does not hold.
+		 */
+		dma_pool: dma-pool@2f040000 {
+			compatible = "shared-dma-pool";
+			reg = <0x2f040000 0x10000>;
+			linux,dma-default;
+			no-map;
+		};
+	};
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		timebase-frequency = <320000000>;
+
+		/*
+		 * Hart 0 stays in M-mode and runs the ESP-IDF firmware for
+		 * the WLAN modem.  Linux uses hart 1.
+		 */
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "esp,esp32s31", "riscv";
+			reg = <1>;
+			riscv,isa-base = "rv32i";
+			riscv,isa-extensions = "i", "m", "a", "zba", "zbb",
+					       "zbs", "c", "zicntr", "zicsr",
+					       "zifencei";
+			mmu-type = "riscv,sv32";
+			cpu1_intc: interrupt-controller {
+				#interrupt-cells = <1>;
+				interrupt-controller;
+				compatible = "riscv,cpu-intc";
+			};
+		};
+	};
+
+	xtal: oscillator {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <40000000>;
+	};
+
+	/* The hardware sets the CPLL to 320 MHz. */
+	cpll: cpll-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <320000000>;
+	};
+
+	/* The PHY driver switches the 12 MHz USB reference clock on and off. */
+	usb_ref_clk: usb-ref-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <12000000>;
+	};
+
+	sdmmc_clk: sdmmc-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <50000000>;
+	};
+
+	soc {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "simple-bus";
+		ranges;
+		/*
+		 * No bus master on this SoC is coherent with the data cache,
+		 * and the hart has no Zicbom.  Thus all DMA devices below use
+		 * the sync engine of the cache controller.
+		 */
+		dma-noncoherent;
+
+		cache: cache-controller@2c000000 {
+			compatible = "esp,esp32s31-cache";
+			reg = <0x2c000000 0x1000>;
+			cache-line-size = <64>;
+			cache-level = <1>;
+		};
+
+		cnnt_sys: clock-controller@20359000 {
+			compatible = "esp,esp32s31-cnnt-sys";
+			reg = <0x20359000 0x1000>;
+			clocks = <&lp_clkrst ESP32S31_LP_CLK_MPLL>, <&cpll>;
+			clock-names = "mpll", "cpll";
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		hp_clkrst: clock-controller@20587000 {
+			compatible = "esp,esp32s31-hp-clkrst";
+			reg = <0x20587000 0x1000>;
+			clocks = <&xtal>, <&cpll>;
+			clock-names = "xtal", "cpll";
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		lp_clkrst: clock-controller@20701000 {
+			compatible = "esp,esp32s31-lp-clkrst";
+			reg = <0x20701000 0x1000>;
+			clocks = <&xtal>;
+			clock-names = "xtal";
+			#clock-cells = <1>;
+		};
+
+		efuse: efuse@20715000 {
+			compatible = "esp,esp32s31-efuse";
+			reg = <0x20715000 0x168>;
+			read-only;
+
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				/* 0 Wi-Fi, 1 Wi-Fi AP, 2 Bluetooth, 3 Ethernet */
+				mac_address: mac-address@50 {
+					reg = <0x50 0x6>;
+					#nvmem-cell-cells = <1>;
+				};
+			};
+		};
+
+		pinctrl: pinctrl@20582000 {
+			compatible = "esp,esp32s31-pinctrl";
+			reg = <0x20582000 0x1000>, <0x20583000 0x1000>;
+			reg-names = "iomux", "gpio";
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl 0 0 62>;
+			/*
+			 * Pins that Linux must not use: the flash (GPIO26-32),
+			 * the USB Serial/JTAG of hart 0 (GPIO33/34), GPIO41,
+			 * which has no package pin, and the UART0 console.
+			 * A board with other pins of the firmware or the loader
+			 * replaces this list.
+			 */
+			gpio-reserved-ranges = <26 9>, <41 1>, <58 2>;
+		};
+
+		clic: interrupt-controller@10a00000 {
+			#interrupt-cells = <3>;
+			#address-cells = <0>;
+			compatible = "esp,esp32s31-clic";
+			reg = <0x10a00000 0x20000>, <0x20585000 0x1000>;
+			reg-names = "clic", "intmatrix";
+			interrupt-controller;
+		};
+
+		sdmmc0: mmc@20342000 {
+			compatible = "esp,esp32s31-dw-mshc", "snps,dw-mshc";
+			reg = <0x20342000 0x1000>;
+			interrupt-parent = <&clic>;
+			interrupts = <34 3 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&sdmmc_clk>, <&sdmmc_clk>;
+			clock-names = "biu", "ciu";
+			clock-frequency = <50000000>;
+			fifo-depth = <512>;
+			bus-width = <4>;
+			cap-sd-highspeed;
+			no-1-8-v;
+			disable-wp;
+			status = "disabled";
+		};
+
+		uart0: serial@2038a000 {
+			compatible = "esp,esp32s3-uart";
+			reg = <0x2038a000 0x1000>;
+			interrupt-parent = <&clic>;
+			interrupts = <32 9 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&xtal>;
+		};
+
+		/*
+		 * RMT channel 0 drives a WS2812 LED.  The loader sets the RMT
+		 * clocks and the GPIO route, so a board sets only the status.
+		 */
+		rgb_led: led-controller@20355000 {
+			compatible = "esp,esp32s31-rmt-ws2812";
+			reg = <0x20355000 0x1000>;
+			status = "disabled";
+
+			led {
+				color = <LED_COLOR_ID_RGB>;
+				function = LED_FUNCTION_STATUS;
+			};
+		};
+
+		/* The data register of the TRNG, which the loader starts. */
+		trng: rng@20814048 {
+			compatible = "timeriomem_rng";
+			reg = <0x20814048 0x4>;
+			period = <1>;
+			quality = <1000>;
+		};
+
+		/*
+		 * The ESP-Hosted firmware on hart 0, through its shared-memory
+		 * transport.  The rings are in internal SRAM.  The doorbells are
+		 * the cross-core interrupt registers.  Linux sets FROM_CPU_1.
+		 * The firmware sets FROM_CPU_2 and Linux clears it.  FROM_CPU_0
+		 * is not usable: ESP-IDF on hart 0 clears it in its own
+		 * cross-core interrupt.
+		 */
+		wifi: wifi@2f050000 {
+			compatible = "esp,esp32s31-hosted-shm";
+			reg = <0x2f050000 0xd000>, <0x20586014 0x8>;
+			reg-names = "shm", "doorbell";
+			interrupt-parent = <&clic>;
+			interrupts = <35 67 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		usb_phy: phy@205870ac {
+			compatible = "esp,esp32s31-usb-phy";
+			reg = <0x205870ac 0x4>, <0x20359030 0x4>,
+			      <0x20589024 0x4>, <0x205890b0 0x4>,
+			      <0x20380018 0x4>;
+			reg-names = "clkrst", "cnnt", "usb-ctrl", "otghs-ctrl",
+				    "utmi-fc06";
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
+		usb0: usb@20300000 {
+			compatible = "esp,esp32s31-usb", "snps,dwc2";
+			/*
+			 * The full aperture up to the PAU block.  The FIFO
+			 * window of each channel is at 0x1000 * (channel + 1).
+			 */
+			reg = <0x20300000 0x40000>;
+			interrupt-parent = <&clic>;
+			interrupts = <33 99 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&usb_ref_clk>;
+			clock-names = "otg";
+			phys = <&usb_phy>;
+			phy-names = "usb2-phy";
+			status = "disabled";
+		};
+
+		i2c0: i2c@20385000 {
+			compatible = "esp,esp32s31-i2c";
+			reg = <0x20385000 0x1000>;
+			interrupt-parent = <&clic>;
+			interrupts = <37 23 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&hp_clkrst ESP32S31_CLK_I2C0_APB>,
+				 <&hp_clkrst ESP32S31_CLK_I2C0>;
+			clock-names = "apb", "core";
+			resets = <&hp_clkrst ESP32S31_RST_I2C0>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		i2c1: i2c@20386000 {
+			compatible = "esp,esp32s31-i2c";
+			reg = <0x20386000 0x1000>;
+			interrupt-parent = <&clic>;
+			interrupts = <38 24 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&hp_clkrst ESP32S31_CLK_I2C1_APB>,
+				 <&hp_clkrst ESP32S31_CLK_I2C1>;
+			clock-names = "apb", "core";
+			resets = <&hp_clkrst ESP32S31_RST_I2C1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		/*
+		 * The RX FIFO has only 256 bytes, so the DMA uses thresholds.  A
+		 * burst of more than 16 beats to PSRAM stops hart 0 with an
+		 * MSPI error, so the PBL must not be multiplied by 8.
+		 */
+		emac: ethernet@20350000 {
+			compatible = "esp,esp32s31-dwmac", "snps,dwmac-3.70a";
+			reg = <0x20350000 0x4000>, <0x205883f4 0x4>;
+			interrupt-parent = <&clic>;
+			interrupts = <36 98 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "macirq";
+			clocks = <&hp_clkrst ESP32S31_CLK_EMAC_SYS>,
+				 <&cnnt_sys ESP32S31_CNNT_CLK_EMAC_REF>;
+			clock-names = "stmmaceth", "ref";
+			/* The TX clock starts at the 1000 Mbit/s rate, not at MPLL/1. */
+			assigned-clocks = <&cnnt_sys ESP32S31_CNNT_CLK_EMAC_REF>;
+			assigned-clock-rates = <125000000>;
+			resets = <&cnnt_sys ESP32S31_CNNT_RST_EMAC>;
+			reset-names = "stmmaceth";
+			esp,cnnt-sys = <&cnnt_sys>;
+			nvmem-cells = <&mac_address 3>;
+			nvmem-cell-names = "mac-address";
+			snps,pbl = <16>;
+			snps,no-pbl-x8;
+			snps,aal;
+			snps,force_thresh_dma_mode;
+			status = "disabled";
+		};
+	};
+};
diff --git a/arch/riscv/boot/dts/espressif/esp32s31_coreboard1.dts b/arch/riscv/boot/dts/espressif/esp32s31_coreboard1.dts
new file mode 100644
--- /dev/null
+++ b/arch/riscv/boot/dts/espressif/esp32s31_coreboard1.dts
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ESP32-S31-Function-CoreBoard-1, with the ESP32-S31-WROOM-3-N16R16V module:
+ * UART0 on the USB-UART bridge, Gigabit Ethernet, a USB 2.0 host port and a
+ * WS2812 RGB LED.
+ * The root is on a USB stick.
+ * Author: Roan Brand <brandroan@gmail.com>
+ */
+/dts-v1/;
+#include "esp32s31.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	model = "Espressif ESP32-S31-Function-CoreBoard-1";
+	compatible = "esp,esp32s31-function-coreboard-1", "esp,esp32s31";
+
+	aliases {
+		ethernet0 = &emac;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&pinctrl {
+	/*
+	 * The pins of the SoC list, ETH_INTN of the PHY (GPIO4, also on J2), and
+	 * the LED of the loader (GPIO60)
+	 */
+	gpio-reserved-ranges = <4 1>, <26 9>, <41 1>, <58 2>, <60 1>;
+
+	/* The RGMII pins of the IO MUX, function 2 */
+	rgmii_cfg: rgmii-cfg {
+		rgmii-tx-pins {
+			pinmux = <ESP32S31_IOMUX(8, 2)>,	/* TXD0 */
+				 <ESP32S31_IOMUX(9, 2)>,	/* TXD1 */
+				 <ESP32S31_IOMUX(10, 2)>,	/* TXD2 */
+				 <ESP32S31_IOMUX(11, 2)>,	/* TXD3 */
+				 <ESP32S31_IOMUX(12, 2)>,	/* TX_CTL */
+				 <ESP32S31_IOMUX(13, 2)>;	/* TX_CLK */
+			bias-disable;
+		};
+
+		rgmii-rx-pins {
+			pinmux = <ESP32S31_IOMUX_IN(14, 2, ESP32S31_SIG_GMAC_RX_CLK)>,
+				 <ESP32S31_IOMUX_IN(15, 2, ESP32S31_SIG_GMAC_RXDV)>,
+				 <ESP32S31_IOMUX_IN(16, 2, ESP32S31_SIG_GMAC_RXD3)>,
+				 <ESP32S31_IOMUX_IN(17, 2, ESP32S31_SIG_GMAC_RXD2)>,
+				 <ESP32S31_IOMUX_IN(18, 2, ESP32S31_SIG_GMAC_RXD1)>,
+				 <ESP32S31_IOMUX_IN(19, 2, ESP32S31_SIG_GMAC_RXD0)>;
+			bias-disable;
+		};
+	};
+
+	mdio_cfg: mdio-cfg {
+		mdio-pins {
+			pinmux = <ESP32S31_MATRIX_OUT(5, ESP32S31_SIG_GMII_MDC)>,
+				 <ESP32S31_MATRIX_OUT(6, ESP32S31_SIG_GMII_MDO)>,
+				 <ESP32S31_MATRIX_IN(6, ESP32S31_SIG_GMII_MDI)>;
+			bias-disable;
+		};
+	};
+};
+
+/*
+ * A Motorcomm YT8531DC-CA on RGMII, with its own crystal and its reset on
+ * GPIO7.  The PHY adds the RX and TX clock delays.  After a chip reset alone
+ * its link comes up but passes no frames, so the MDIO bus resets it before
+ * the first access.
+ */
+&emac {
+	pinctrl-names = "default";
+	pinctrl-0 = <&rgmii_cfg>, <&mdio_cfg>;
+	phy-mode = "rgmii-id";
+	phy-handle = <&phy0>;
+	status = "okay";
+
+	mdio {
+		compatible = "snps,dwmac-mdio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reset-gpios = <&pinctrl 7 GPIO_ACTIVE_LOW>;
+		reset-delay-us = <10000>;
+		reset-post-delay-us = <50000>;
+
+		phy0: ethernet-phy@0 {
+			reg = <0>;
+		};
+	};
+};
+
+/* The Type-A port: host only, with a TPS2051C switch for VBUS. */
+&usb_phy { status = "okay"; };
+
+&usb0 {
+	dr_mode = "host";
+	disable-over-current;
+	status = "okay";
+};
+
+/* WS2812 RGB LED on GPIO60. */
+&rgb_led { status = "okay"; };
diff --git a/arch/riscv/boot/dts/espressif/esp32s31_korvo1.dts b/arch/riscv/boot/dts/espressif/esp32s31_korvo1.dts
new file mode 100644
--- /dev/null
+++ b/arch/riscv/boot/dts/espressif/esp32s31_korvo1.dts
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ESP32-S31-Korvo-1: 800x480 RGB panel, microSD slot, USB 2.0 host port
+ * and a WS2812 RGB LED.
+ * Author: Marco Müller <hello@annoyedmilk.ch>
+ */
+/dts-v1/;
+#include "esp32s31.dtsi"
+
+/ {
+	model = "Espressif ESP32-S31-Korvo-1";
+	compatible = "esp,esp32s31-korvo-1", "esp,esp32s31";
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * The loader DMA reads this buffer also after the handoff.
+		 * OpenSBI makes this range uncached with two PMA entries, so
+		 * it goes to the end of PSRAM.
+		 */
+		fb_region: framebuffer@50f40000 {
+			reg = <0x50f40000 0xc0000>;
+			no-map;
+		};
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+
+		/*
+		 * The loader starts the 800x480 RGB panel of the Korvo-1.  The
+		 * LCD_CAM DMA then reads an RGB565 buffer at the top of PSRAM,
+		 * so Linux only describes it.  fb_region reserves the memory.
+		 * of_platform makes this device for a simple-framebuffer under
+		 * /chosen.  If the loader gives GPIO33/34 to USB Serial/JTAG,
+		 * it does not start the display: fb0 exists but shows nothing.
+		 */
+		framebuffer {
+			compatible = "simple-framebuffer";
+			width = <800>;
+			height = <480>;
+			stride = <(800 * 2)>;
+			format = "r5g6b5";
+			memory-region = <&fb_region>;
+		};
+	};
+};
+
+&sdmmc0 { status = "okay"; };
+
+/* The Type-A port: host only, with a TPS2051C switch for VBUS. */
+&usb_phy { status = "okay"; };
+
+&usb0 {
+	dr_mode = "host";
+	disable-over-current;
+	status = "okay";
+};
+
+/* WS2812 RGB LED on GPIO37. */
+&rgb_led { status = "okay"; };
+
+/*
+ * The loader drives the LCD (GPIO8-19, 33-36, 38, 40, 43-45), the card power
+ * and its pins (GPIO20-25, 39) and the LED (GPIO37).  With the flash, GPIO41
+ * and UART0, Linux must not use them as GPIOs.
+ */
+&pinctrl {
+	gpio-reserved-ranges = <8 33>, <41 1>, <43 3>, <58 2>;
+
+	i2c0_cfg: i2c0-cfg {
+		i2c0-pins {
+			pinmux = <ESP32S31_MATRIX_INOUT(0, ESP32S31_SIG_I2C0_SDA)>,
+				 <ESP32S31_MATRIX_INOUT(1, ESP32S31_SIG_I2C0_SCL)>;
+			bias-pull-up;
+			drive-open-drain;
+		};
+	};
+};
+
+/*
+ * The board I2C bus: the ES8389 codec at 0x10 and the GT1151 touch
+ * controller of the LCD at 0x14.  The touch INT and reset lines are not
+ * connected, so the driver polls the controller.
+ */
+&i2c0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c0_cfg>;
+	clock-frequency = <400000>;
+	status = "okay";
+
+	touchscreen@14 {
+		compatible = "goodix,gt1151";
+		reg = <0x14>;
+		touchscreen-size-x = <800>;
+		touchscreen-size-y = <480>;
+	};
+};
diff --git a/arch/riscv/include/asm/esp32s31-cache.h b/arch/riscv/include/asm/esp32s31-cache.h
new file mode 100644
--- /dev/null
+++ b/arch/riscv/include/asm/esp32s31-cache.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_RISCV_ESP32S31_CACHE_H
+#define _ASM_RISCV_ESP32S31_CACHE_H
+
+/* The two L1 caches have 64-byte lines, the same as RISC-V L1_CACHE_BYTES. */
+#define ESP32S31_CACHE_LINE_SIZE	64
+
+/*
+ * The cache controller handles only the external memory aperture.  The CPU
+ * accesses internal SRAM and MMIO without the data cache.  A range outside
+ * this window does not need a sync operation, and must not get one.
+ */
+#define ESP32S31_CACHE_EXTRAM_BASE	0x50000000UL
+#define ESP32S31_CACHE_EXTRAM_SIZE	0x04000000UL
+
+#endif /* _ASM_RISCV_ESP32S31_CACHE_H */
