ESP32-S31: add the kernel source files of the SoC

Generated by scripts/mkkernelpatches.py.  Do not edit.  Change the files
under linux/, then run "make kernel-patches".

Signed-off-by: Marco Mueller <hello@annoyedmilk.ch>
---
diff --git a/Documentation/devicetree/bindings/cache/esp,esp32s31-cache.yaml b/Documentation/devicetree/bindings/cache/esp,esp32s31-cache.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/cache/esp,esp32s31-cache.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/cache/esp,esp32s31-cache.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 cache controller
+
+maintainers:
+  - Marco Müller <hello@annoyedmilk.ch>
+
+description:
+  The ESP32-S31 cache controller is in front of the external PSRAM aperture.
+  Its sync engine does invalidate, writeback and writeback-invalidate
+  operations on an address range. The kernel uses them for DMA cache
+  maintenance, because the hart has no Zicbom and the kernel does not use
+  the uncached alias of that aperture. The engine registers are global, so
+  the M-mode firmware programs them and the kernel asks it for each
+  operation.
+
+properties:
+  compatible:
+    const: esp,esp32s31-cache
+
+  reg:
+    maxItems: 1
+
+  cache-line-size:
+    const: 64
+
+  cache-level:
+    const: 1
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    cache-controller@2c000000 {
+        compatible = "esp,esp32s31-cache";
+        reg = <0x2c000000 0x1000>;
+        cache-line-size = <64>;
+        cache-level = <1>;
+    };
diff --git a/Documentation/devicetree/bindings/interrupt-controller/esp,esp32s31-clic.yaml b/Documentation/devicetree/bindings/interrupt-controller/esp,esp32s31-clic.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/interrupt-controller/esp,esp32s31-clic.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interrupt-controller/esp,esp32s31-clic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Espressif ESP32-S31 Core-Local Interrupt Controller
+
+maintainers:
+  - Marco Müller <hello@annoyedmilk.ch>
+
+description: >
+  Each ESP32-S31 core has a CLIC with 48 inputs: 16 architectural local
+  causes, then 32 inputs from the Interrupt Matrix of that core. The matrix
+  connects SoC interrupt sources to these inputs. All cores use the same
+  physical address for the register window, and each core sees its own
+  registers. The supervisor window shows an input only after the
+  machine-mode firmware gives it to S-mode. Thus this binding describes only
+  the supervisor view.
+
+  A peripheral interrupt is only a SoC source number until the matrix
+  connects it. Thus an interrupt specifier has three cells: the CLIC input,
+  the SoC interrupt source for that input, and the trigger type.
+
+properties:
+  compatible:
+    const: esp,esp32s31-clic
+
+  reg:
+    items:
+      - description: supervisor CLIC register window
+      - description: Interrupt Matrix routing blocks for both cores
+
+  reg-names:
+    items:
+      - const: clic
+      - const: intmatrix
+
+  interrupt-controller: true
+
+  "#interrupt-cells":
+    const: 3
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupt-controller
+  - "#interrupt-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    interrupt-controller@10a00000 {
+        compatible = "esp,esp32s31-clic";
+        reg = <0x10a00000 0x20000>, <0x20585000 0x1000>;
+        reg-names = "clic", "intmatrix";
+        interrupt-controller;
+        #interrupt-cells = <3>;
+    };
