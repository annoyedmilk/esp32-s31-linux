diff --git a/drivers/phy/Kconfig b/drivers/phy/Kconfig
--- a/drivers/phy/Kconfig
+++ b/drivers/phy/Kconfig
@@ -61,6 +61,18 @@ config PHY_CAN_TRANSCEIVER
 	  driver provides function for putting the transceivers in various
 	  functional modes using gpios and sets the attribute max link
 	  rate, for CAN drivers.
+
+config PHY_ESP32S31_USB
+	bool "Espressif ESP32-S31 USB PHY driver"
+	depends on OF && SOC_ESP32S31
+	select GENERIC_PHY
+	help
+	  Enable support for the integrated high-speed UTMI PHY used by the
+	  ESP32-S31 Synopsys DWC2 USB controller.  The driver programs the SoC
+	  clock/reset controls and configures the data-line pull-downs for host
+	  mode.
+
+	  If unsure, say N.
 
 config PHY_GOOGLE_USB
 	tristate "Google Tensor SoC USB PHY driver"
