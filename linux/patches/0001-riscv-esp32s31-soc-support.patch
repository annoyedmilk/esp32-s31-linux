diff --git a/arch/riscv/kernel/entry.S b/arch/riscv/kernel/entry.S
index 6c14ed7a5..cd281a99d 100644
--- a/arch/riscv/kernel/entry.S
+++ b/arch/riscv/kernel/entry.S
@@ -122,6 +122,14 @@
 		CONFIG_RISCV_USER_CFI)
 .endm
 
+#ifdef CONFIG_SOC_ESP32S31
+	/*
+	 * ESP32-S31 runs with stvec forced to CLIC mode, whose BASE field is
+	 * 64-byte aligned.  Keep the common Linux exception entry on that
+	 * boundary so synchronous traps do not land before handle_exception.
+	 */
+	.balign 64
+#endif
 SYM_CODE_START(handle_exception)
 	/*
 	 * If coming from userspace, preserve the user thread pointer and load
@@ -224,6 +232,12 @@ SYM_CODE_START(handle_exception)
 	j ret_from_exception
 1:
 	/* Handle other exceptions */
+#ifdef CONFIG_SOC_ESP32S31
+	/* Mask CLIC state bits so handlers see the architectural code */
+	li t0, 0xfff
+	and s4, s4, t0
+	REG_S s4, PT_CAUSE(sp)
+#endif
 	slli t0, s4, RISCV_LGPTR
 	la t1, excp_vect_table
 	la t2, excp_vect_table_end
diff --git a/arch/riscv/kernel/head.S b/arch/riscv/kernel/head.S
index f6a8ca49e..9eb2d43a2 100644
--- a/arch/riscv/kernel/head.S
+++ b/arch/riscv/kernel/head.S
@@ -196,6 +196,14 @@ secondary_start_sbi:
 .Lsetup_trap_vector:
 	/* Set trap vector to exception handler */
+#ifdef CONFIG_SOC_ESP32S31
+	la a0, esp32s31_clic_trampoline
+#else
 	la a0, handle_exception
+#endif
+#ifdef CONFIG_SOC_ESP32S31
+	/* ESP32-S31 stvec is hardwired to CLIC mode (low bits 0b11). */
+	ori a0, a0, 3
+#endif
 	csrw CSR_TVEC, a0
 
 	/*
@@ -208,9 +216,19 @@ secondary_start_sbi:
 SYM_CODE_END(_start)
 
 SYM_CODE_START(_start_kernel)
+#ifdef CONFIG_SOC_ESP32S31
+	/*
+	 * The sie/sip CSRs are not implemented; interrupt routing is owned
+	 * by the firmware-configured CLIC.  Keep S-mode interrupts globally
+	 * off until the CLIC driver takes over.
+	 */
+	li t0, 2
+	csrc sstatus, t0
+#else
 	/* Mask all interrupts */
 	csrw CSR_IE, zero
 	csrw CSR_IP, zero
+#endif
 
 #ifdef CONFIG_RISCV_M_MODE
 	/* flush the instruction cache */
