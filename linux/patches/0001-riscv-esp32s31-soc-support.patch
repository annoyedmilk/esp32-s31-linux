diff --git a/arch/riscv/Kconfig.socs b/arch/riscv/Kconfig.socs
--- a/arch/riscv/Kconfig.socs
+++ b/arch/riscv/Kconfig.socs
@@ -117,4 +117,16 @@
 	help
 	  This enables support for Canaan Kendryte K210 SoC platform hardware.
 
+config ARCH_ESPRESSIF
+	def_bool SOC_ESP32S31
+
+config SOC_ESP32S31
+	bool "Espressif ESP32-S31 SoC"
+	select ESP32S31_CLIC
+	help
+	  This enables support for the Espressif ESP32-S31 SoC.  The kernel
+	  runs in Supervisor mode on OpenSBI, with the Sv32 MMU.  It gets
+	  all interrupts through the ESP32-S31 CLIC, not through the
+	  standard RISC-V local interrupt CSRs.
+
 endmenu # "SoC selection"
diff --git a/arch/riscv/boot/dts/Makefile b/arch/riscv/boot/dts/Makefile
--- a/arch/riscv/boot/dts/Makefile
+++ b/arch/riscv/boot/dts/Makefile
@@ -3,6 +3,7 @@
 subdir-y += andes
 subdir-y += anlogic
 subdir-y += canaan
+subdir-y += espressif
 subdir-y += eswin
 subdir-y += microchip
 subdir-y += renesas
diff --git a/arch/riscv/kernel/Makefile b/arch/riscv/kernel/Makefile
--- a/arch/riscv/kernel/Makefile
+++ b/arch/riscv/kernel/Makefile
@@ -118,6 +118,7 @@
 obj-$(CONFIG_CFI)		+= cfi.o
 
 obj-$(CONFIG_EFI)		+= efi.o
+obj-$(CONFIG_ESP32S31_CLIC)	+= esp32s31-clic-trampoline.o
 obj-$(CONFIG_COMPAT)		+= compat_syscall_table.o
 obj-$(CONFIG_COMPAT)		+= compat_signal.o
 obj-$(CONFIG_COMPAT)		+= compat_vdso/
diff --git a/arch/riscv/kernel/entry.S b/arch/riscv/kernel/entry.S
--- a/arch/riscv/kernel/entry.S
+++ b/arch/riscv/kernel/entry.S
@@ -125,6 +125,14 @@
 		CONFIG_RISCV_USER_CFI)
 .endm
 
+#ifdef CONFIG_SOC_ESP32S31
+	/*
+	 * On the ESP32-S31, stvec is always in CLIC mode, and its BASE field
+	 * is 64-byte aligned.  Align the exception entry to 64 bytes, so a
+	 * synchronous trap does not go to an address before it.
+	 */
+	.balign 64
+#endif
 SYM_CODE_START(handle_exception)
 	/*
 	 * If coming from userspace, preserve the user thread pointer and load
@@ -227,6 +235,12 @@
 	j ret_from_exception
 1:
 	/* Handle other exceptions */
+#ifdef CONFIG_SOC_ESP32S31
+	/* Remove the CLIC state bits, so handlers get the standard code */
+	li t0, 0xfff
+	and s4, s4, t0
+	REG_S s4, PT_CAUSE(sp)
+#endif
 	slli t0, s4, RISCV_LGPTR
 	la t1, excp_vect_table
 	la t2, excp_vect_table_end
diff --git a/arch/riscv/kernel/head.S b/arch/riscv/kernel/head.S
--- a/arch/riscv/kernel/head.S
+++ b/arch/riscv/kernel/head.S
@@ -195,7 +195,15 @@
 .align 2
 .Lsetup_trap_vector:
 	/* Set trap vector to exception handler */
+#ifdef CONFIG_SOC_ESP32S31
+	la a0, esp32s31_clic_trampoline
+#else
 	la a0, handle_exception
+#endif
+#ifdef CONFIG_SOC_ESP32S31
+	/* The ESP32-S31 stvec is always in CLIC mode (low bits 0b11). */
+	ori a0, a0, 3
+#endif
 	csrw CSR_TVEC, a0
 
 	/*
@@ -208,9 +216,19 @@
 SYM_CODE_END(_start)
 
 SYM_CODE_START(_start_kernel)
+#ifdef CONFIG_SOC_ESP32S31
+	/*
+	 * The sie and sip CSRs do not exist.  The CLIC, which the firmware
+	 * sets up, sends the interrupts.  Keep all S-mode interrupts off
+	 * until the CLIC driver starts.
+	 */
+	li t0, 2
+	csrc sstatus, t0
+#else
 	/* Mask all interrupts */
 	csrw CSR_IE, zero
 	csrw CSR_IP, zero
+#endif
 
 #ifdef CONFIG_RISCV_M_MODE
 	/* flush the instruction cache */
diff --git a/drivers/irqchip/Kconfig b/drivers/irqchip/Kconfig
--- a/drivers/irqchip/Kconfig
+++ b/drivers/irqchip/Kconfig
@@ -701,6 +701,17 @@
 	bool
 	select ACLINT_SSWI
 
+config ESP32S31_CLIC
+	bool "ESP32-S31 CLIC (Core-Local Interrupt Controller)"
+	depends on RISCV && 32BIT
+	select IRQ_DOMAIN
+	select IRQ_DOMAIN_HIERARCHY
+	help
+	  Support for the RISC-V Core-Local Interrupt Controller on the
+	  Espressif ESP32-S31.  Linux gets all supervisor interrupts
+	  through the S-mode CLIC window.  The SoC interrupt matrix
+	  connects the peripheral interrupts to it.
+
 config EXYNOS_IRQ_COMBINER
 	bool "Samsung Exynos IRQ combiner support" if COMPILE_TEST
 	depends on (ARCH_EXYNOS && ARM) || COMPILE_TEST
