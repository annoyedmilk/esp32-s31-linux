From: Marco Müller <hello@annoyedmilk.ch>
Subject: [PATCH] host: clear "BR/EDR Not Supported" of the ESP32-S31

The controller sets "BR/EDR Not Supported" from its LE part, so the core
used LE only.  Clear the bit when the firmware has BR/EDR.

Upstream: not sent
---
--- a/host/main.c
+++ b/host/main.c
@@ -973,6 +973,24 @@
 		adapter->if_ops->commit_fw_recovery(adapter);
 }
 
+/*
+ * The ESP32-S31 dual-mode controller sets "BR/EDR Not Supported" in byte 4
+ * of its LMP features, which come from its LE part.  Then the Bluetooth core
+ * uses only LE.  When the firmware has BR/EDR, clear the bit.
+ */
+static void esp_bt_fix_features(struct sk_buff *skb)
+{
+	struct hci_event_hdr *hdr = (void *)skb->data;
+	struct hci_ev_cmd_complete *cc = (void *)(hdr + 1);
+	struct hci_rp_read_local_features *rp = (void *)(cc + 1);
+
+	if (skb->len < sizeof(*hdr) + sizeof(*cc) + sizeof(*rp) ||
+	    hdr->evt != HCI_EV_CMD_COMPLETE ||
+	    le16_to_cpu(cc->opcode) != HCI_OP_READ_LOCAL_FEATURES || rp->status)
+		return;
+	rp->features[4] &= ~LMP_NO_BREDR;
+}
+
 static int process_event_esp_bootup(struct esp_adapter *adapter, u8 *evt_buf, u8 len)
 {
 	int len_left = len, tag_len, ret = 0;
@@ -2167,6 +2185,9 @@
 		payload_len = skb->len - 1;
 		hci_skb_pkt_type(skb) = pkt_type;
 		skb_pull(skb, 1);
+		if (pkt_type == HCI_EVENT_PKT &&
+		    (adapter->capabilities & ESP_BR_EDR_ONLY_SUPPORT))
+			esp_bt_fix_features(skb);
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 13, 0))
 		if (hci_recv_frame(hdev, skb))
 #else
