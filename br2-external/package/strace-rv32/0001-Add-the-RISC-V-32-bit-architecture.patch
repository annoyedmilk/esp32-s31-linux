From: Marco Müller <hello@annoyedmilk.ch>
Subject: [PATCH] configure: add the RISC-V 32-bit architecture

strace knows only RV64.  Add the RV32 target.  The RV32 files include
the RV64 files where the two are the same.

Upstream: not sent
---
diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -173,6 +173,11 @@ riscv64*)
 	karch=riscv
 	AC_DEFINE([RISCV64], 1, [Define for the RISC-V 64-bit architecture])
 	;;
+riscv32*)
+	arch=riscv32
+	karch=riscv
+	AC_DEFINE([RISCV32], 1, [Define for the RISC-V 32-bit architecture])
+	;;
 s390)
 	arch=s390
 	AC_DEFINE([S390], 1, [Define for the S390 architecture.])
diff --git a/src/Makefile.am b/src/Makefile.am
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -865,6 +865,19 @@ EXTRA_DIST =				\
 	linux/riscv64/set_error.c		\
 	linux/riscv64/set_scno.c		\
 	linux/riscv64/syscallent.h	\
+	linux/riscv32/arch_defs_.h		\
+	linux/riscv32/arch_prstatus_regset.c \
+	linux/riscv32/arch_prstatus_regset.h \
+	linux/riscv32/arch_regs.c		\
+	linux/riscv32/get_error.c		\
+	linux/riscv32/get_scno.c		\
+	linux/riscv32/get_syscall_args.c	\
+	linux/riscv32/ioctls_arch0.h	\
+	linux/riscv32/ioctls_inc0.h	\
+	linux/riscv32/raw_syscall.h	\
+	linux/riscv32/set_error.c		\
+	linux/riscv32/set_scno.c		\
+	linux/riscv32/syscallent.h	\
 	linux/s390/arch_defs_.h		\
 	linux/s390/arch_prstatus_regset.c \
 	linux/s390/arch_prstatus_regset.h \
diff --git a/src/linux/riscv32/arch_defs_.h b/src/linux/riscv32/arch_defs_.h
new file mode 100644
--- /dev/null
+++ b/src/linux/riscv32/arch_defs_.h
@@ -0,0 +1,17 @@
+/*
+ * Copyright (c) 2021-2024 The strace developers.
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/*
+ * Linux kernel commit v6.5-rc7~13^2~5 introduced a regression:
+ * when tracer changes syscall number to -1, the kernel fails
+ * to initialize a0 with -ENOSYS and subsequently fails
+ * to return the error code of the failed syscall to userspace.
+ * Workaround this by initializing a0 ourselves.
+ */
+#define ARCH_NEEDS_SET_ERROR_FOR_SCNO_TAMPERING 1
+
+#define PERSONALITY0_AUDIT_ARCH { AUDIT_ARCH_RISCV32, 0 }
