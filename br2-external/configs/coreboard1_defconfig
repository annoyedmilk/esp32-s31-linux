# Generated by scripts/mkdefconfigs.sh.  Do not edit: change
# common.fragment, diskroot.fragment and coreboard1.fragment in br2-external/board/esp32s31/defconfig/.
# The common base of the three builds: toolchain, kernel, system, and the
# userspace that all three have.  scripts/mkdefconfigs.sh merges it with the
# root fragment and the fragment of each board into
# br2-external/configs/<board>_defconfig.
#
# RV32 IMAC with Zba, Zbb and Zbs, Sv32, soft-float ilp32.  The hart has F
# but no D, and Linux supports an FPU only with D.
BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_32=y
BR2_RISCV_USE_MMU=y
BR2_RISCV_ISA_RVI=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVC=y
# BR2_RISCV_ISA_RVF is not set
# BR2_RISCV_ISA_RVD is not set
BR2_RISCV_ISA_EXTRA="zba_zbb_zbs"
BR2_RISCV_ABI_ILP32=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
# A kernel config or patch change extracts and builds the kernel again.  The
# cache in $(HOME) (the build volume) makes such a rebuild take minutes.
BR2_CCACHE=y

# A stock release with linux/patches/ applied to the Buildroot download.  To
# change the version, change this value and update the series.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.3"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_ESP32S31_PATH)/../linux/patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/linux.config"
# CONFIG_BUILTIN_DTB, so the loader copies only one file.
BR2_LINUX_KERNEL_IMAGE=y
# Headers from the same kernel.  Also set the header series.  The default is
# "really old", which tells all packages that the headers are 2.6.  7.1 is
# the newest series that this Buildroot knows, and it also covers 7.3.
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_7_1=y
# The ESP-Hosted host driver for the radio firmware on hart 0, built in.
BR2_LINUX_KERNEL_EXT_ESP_HOSTED_LINUX=y

BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_GENERIC_HOSTNAME="esp32s31"
BR2_TARGET_GENERIC_ISSUE="ESP32-S31 Linux"
BR2_TARGET_GENERIC_ROOT_PASSWD="korvo-bringup"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/busybox.fragment"
# /bin/sh is BusyBox ash.  post-build.sh makes bash the login shell of root
# where the image has bash.
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_TARGET_GENERIC_GETTY_OPTIONS="-n -l /sbin/serial-autologin"
# Patches for Buildroot packages, in patches/<package>/.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_ESP32S31_PATH)/patches"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/post-image.sh"
# BR2_TARGET_ROOTFS_TAR is not set

BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
# The kernel has only version 2 of the GPIO character device ABI.
BR2_PACKAGE_LIBGPIOD2=y
BR2_PACKAGE_LIBGPIOD2_TOOLS=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
# HTTP, HTTPS and FTP only: no DICT, Gopher, IMAP, POP3, RTSP, SMB, SMTP,
# Telnet or TFTP.
# BR2_PACKAGE_LIBCURL_EXTRA_PROTOCOLS_FEATURES is not set
# This release installs a small set of necessary terminfo files.
BR2_PACKAGE_NCURSES_ADDITIONAL_TERMINFO=""
BR2_PACKAGE_OPENSSL=y
# OpenSSL for WPA2/WPA3 Personal and Enterprise (eduroam) and HTTPS.
# MSCHAPv2 needs MD4 and DES, and WPA/TKIP group keys need RC4: with
# OpenSSL 3, wpa_supplicant loads them from the legacy module.  No other
# old ciphers, SSLv3, QUIC or engines.
# BR2_PACKAGE_LIBOPENSSL_ENABLE_RC2 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_MD2 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_MDC2 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_BLAKE2 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_IDEA is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SEED is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_RMD160 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_WHIRLPOOL is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_BLOWFISH is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SSL is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SSL3 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_WEAK_SSL is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_PSK is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_CAST is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_COMP is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_ARGON2 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_CMP is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_THREAD_POOL is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_PADLOCK_ENGINE is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_QUIC is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SIV is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SM2_PRECOMP_TABLE is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SSL_TRACE is not set
# BR2_PACKAGE_LIBOPENSSL_UNSECURE is not set
# BR2_PACKAGE_LIBOPENSSL_DYNAMIC_ENGINE is not set
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
# S40wifi starts it with -s: its notes go to syslog, not to the console.
BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y
BR2_PACKAGE_WPA_SUPPLICANT_EAP=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
# Access point mode without hostapd.
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
# BlueZ for hci0, the Bluetooth controller of the ESP-Hosted firmware:
# bluetoothd and bluetoothctl, which also has the mgmt commands of btmgmt.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
# Lua, a script language small enough for the flash root of the module.
BR2_PACKAGE_LUA=y
# The root on a disk, for the boards with one: the microSD card of korvo1
# and the USB stick of coreboard1.  The disk has room, so these builds have
# the full set of workstation and debugging tools.
#
# gdbserver needs the C++ runtime.  The full debugger stays in the container.
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_HOST_GDB=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_PACKAGE_HOST_GENIMAGE=y

# The root is on a removable disk, and a clean shutdown is not certain.
BR2_PACKAGE_E2FSPROGS=y
# fsck.fat clears the dirty flag of p1 after a reset.  S10sdcard.sh runs it
# when the cluster count of p1 fits in the free memory.
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
# Dropbear has no SFTP server.  scp of OpenSSH 9 and sftp need one.
BR2_PACKAGE_GESFTPSERVER=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_VIM=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_FASTFETCH=y
# Buildroot and strace 7.1 do not support RV32, so br2-external has a port.
BR2_PACKAGE_STRACE_RV32=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
# BR2_PACKAGE_GDB_DEBUGGER is not set
BR2_PACKAGE_TCPDUMP=y
# Links needs OpenSSL and the CA certificates for HTTPS after the board
# clock is set.
BR2_PACKAGE_LINKS=y
BR2_PACKAGE_MICROPYTHON=y
# Terminal tools, on the console and over SSH: windows, an easy editor, files,
# disk use, a calculator and SQLite.
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_NNN=y
BR2_PACKAGE_NCDU=y
BR2_PACKAGE_TREE=y
BR2_PACKAGE_BC=y
BR2_PACKAGE_SQLITE=y
# The time zone database.  /etc/localtime is UTC; ln -sf
# /usr/share/zoneinfo/<zone> /etc/localtime sets the local zone.
BR2_TARGET_TZ_INFO=y
# An access point with all features, next to the AP mode of wpa_supplicant.
BR2_PACKAGE_HOSTAPD=y
# The BlueZ tools and the deprecated ones (hciconfig, hcitool, hcidump).
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
# ESP32-S31-Function-CoreBoard-1: root on a USB stick (diskroot.fragment),
# and in the kernel Ethernet and no panel.
#
# The motd and the examples.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/rootfs-overlay $(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/rootfs-overlay-coreboard1 $(BR2_EXTERNAL_ESP32S31_PATH)/../local-overlay"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/linux-coreboard1.fragment"
# ethtool sets the ring size of stmmac before eth0 goes up (S41ethernet.sh).
BR2_PACKAGE_ETHTOOL=y
# BR2_PACKAGE_ETHTOOL_PRETTY_PRINT is not set
