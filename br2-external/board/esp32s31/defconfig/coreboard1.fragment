# ESP32-S31-Function-CoreBoard-1: the module alone (flashroot.fragment), and
# in the kernel the parts of the board.
# The flash root files (overlay-init), the USB stick mount, then the motd
# and the examples.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/rootfs-overlay $(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/rootfs-overlay-flashroot $(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/rootfs-overlay-usb $(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/rootfs-overlay-coreboard1 $(BR2_EXTERNAL_ESP32S31_PATH)/../local-overlay"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/linux-esp32s31.fragment $(BR2_EXTERNAL_ESP32S31_PATH)/board/esp32s31/linux-coreboard1.fragment"
# ethtool sets the ring size of stmmac before eth0 goes up (S41ethernet).
BR2_PACKAGE_ETHTOOL=y
# BR2_PACKAGE_ETHTOOL_PRETTY_PRINT is not set
