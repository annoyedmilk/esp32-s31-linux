#!/bin/sh
# SPDX-License-Identifier: MIT
# CGI script: /cgi-bin/gpio?PIN reads a pin, /cgi-bin/gpio?PIN=0|1 sets it.

echo "Content-Type: text/plain"
echo
case "$QUERY_STRING" in
[0-9]|[0-9][0-9])
	gpioget -a --numeric -c gpiochip0 "$QUERY_STRING" ;;
[0-9]=[01]|[0-9][0-9]=[01])
	gpioset -t0 -c gpiochip0 "$QUERY_STRING" && echo "$QUERY_STRING" ;;
*)
	echo "use ?PIN or ?PIN=0 or ?PIN=1" ;;
esac
