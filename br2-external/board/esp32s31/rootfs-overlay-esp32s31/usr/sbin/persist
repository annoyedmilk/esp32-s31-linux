#!/bin/sh
# SPDX-License-Identifier: MIT
# Keep files across a reboot: the root is in RAM, so save them in the
# persist flash partition.  The loader puts the partition after the
# initramfs, and the kernel unpacks it over the files of the image.
#
#   persist save    save the files in /etc/persist.list
#   persist list    show the saved files
#   persist clear   delete the saved files at the next boot

NV=/sys/bus/nvmem/devices/esp32s31-persist/nvmem
LIST=/etc/persist.list
TMP=/tmp/persist.cpio.gz
BS=2048		# one write of the firmware mailbox

die()
{
	echo "persist: $*" >&2
	exit 1
}

# Write blocks of the partition.  It is a regular file that dd cannot truncate.
nvdd()
{
	dd of="$NV" bs=$BS conv=notrunc "$@" 2>/dev/null
}

save()
{
	size=$(wc -c < "$NV") || die "no persist partition"
	cd / || exit 1
	for path in $(grep -v '^#' "$LIST") "$LIST"; do
		[ -e "$path" ] && find "${path#/}"
	done | cpio -o -H newc 2>/dev/null | gzip -9 > "$TMP"
	used=$(wc -c < "$TMP")
	[ "$used" -le "$size" ] || die "$used bytes do not fit in $size"
	# The kernel must find zeros after the archive, not an old archive.
	head -c $((size - used)) /dev/zero >> "$TMP"
	# Write the start with the gzip magic last.  Until then the loader sees
	# no archive, so a save that stops half way gives the image defaults.
	nvdd if=/dev/zero count=1 &&
		nvdd if="$TMP" skip=1 seek=1 &&
		nvdd if="$TMP" count=1 ||
		die "write failed"
	rm -f "$TMP"
	echo "persist: saved $used bytes"
}

case "$1" in
save)
	save
	;;
list)
	gzip -dc < "$NV" 2>/dev/null | cpio -t 2>/dev/null
	;;
clear)
	nvdd if=/dev/zero count=1 || die "write failed"
	echo "persist: cleared"
	;;
*)
	echo "usage: persist save|list|clear" >&2
	exit 1
	;;
esac
