# ESP-Mosaico CoreBoard V1.2: serial console, NOR root and NAND overlay.
CONFIG_BUILTIN_DTB_NAME="espressif/esp32s31_esp_mosaico"
# The UART is the only console.  The root is the squashfs partition of the
# NOR window. All writable files live in the NAND UBIFS upper layer.
CONFIG_CMDLINE="earlycon=sbi console=tty0 console=ttyS0,115200 esp32_shm.radio_service=bt+154 root=/dev/mtdblock0 rootfstype=squashfs ro rootwait init=/sbin/nand-overlay-init"

# No panel, VTs or input devices.
CONFIG_FB=y
CONFIG_VT=y
CONFIG_INPUT=y
# CONFIG_HID is not set

# No card, USB, LED or I2C device.  zram stays.
# CONFIG_MMC is not set
CONFIG_I2C=y
# CONFIG_USB_SUPPORT is not set
# CONFIG_PHY_ESP32S31_USB is not set
# CONFIG_SCSI is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_UEVENT_HELPER is not set
# Keep the common firewall available without adding it to the kernel image.
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NFT_CT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_REJECT=m
CONFIG_NF_LOG_SYSLOG=m
CONFIG_NF_NAT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
# No Thread host daemon in the flash image.
# CONFIG_TUN is not set

# Keep sparse zram size classes from consuming large multi-page chains.
# Peripheral drivers and capture buffers leave little physical RAM to spare.
CONFIG_ZSMALLOC_CHAIN_SIZE=4

# The flash window of the firmware: a read-only squashfs root, and UBIFS on
# the data partition as the writable overlay over it.  jffs2 cannot be the
# upper layer: it has no RENAME_WHITEOUT, so overlayfs cannot make a
# directory where a lower one was deleted.
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_UBI=y
# squashfs and UBIFS are in this menu, which linux.config turns off.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
# The root is squashfs with zstd.
CONFIG_SQUASHFS_ZSTD=y
# CONFIG_SQUASHFS_ZLIB is not set
CONFIG_UBIFS_FS=y
# Each compressor keeps a workspace for all time.  LZO is the default.
CONFIG_UBIFS_FS_ADVANCED_COMPR=y
# CONFIG_UBIFS_FS_ZLIB is not set
# CONFIG_UBIFS_FS_ZSTD is not set
CONFIG_OVERLAY_FS=y

# GPSPI3 NAND supplies persistent files and low-priority swap.
CONFIG_SPI=y
CONFIG_SPI_ESP32S31=y
CONFIG_MTD_SPI_NAND=y
CONFIG_MODULES=y
CONFIG_MTD_SWAP=m

CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_ESP32S31_MODE=y

# The CO5300 uses GPSPI2 and shares I2C0 peripheral power with touch.
CONFIG_FB_CO5300=y
# CONFIG_FB_SIMPLE is not set
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_HYNITRON_CST9220=y
# CONFIG_TOUCHSCREEN_GOODIX is not set
CONFIG_I2C_CHARDEV=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Shared-bus IIO sensors, interrupt-driven AI key and force-feedback motor.
CONFIG_IIO=m
CONFIG_BMI270_I2C=m
CONFIG_BMC150_MAGN_I2C=m
CONFIG_INPUT_MISC=y
CONFIG_INPUT_GPIO_VIBRA=m
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=m
# CONFIG_KEYBOARD_GPIO_POLLED is not set

# Left CameraBoard V1.4; rootfs firmware is available before module loading.
CONFIG_DMADEVICES=y
CONFIG_ESP32S31_AXI_DMA=m
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEO_SC101IOT=m
CONFIG_VIDEO_ESP32S31_CAMERA=m
CONFIG_VIDEO_ESP_MOSAICO_CAMERA_MODULE=m
