# ESP32-S31 minimal config: MMU (Sv32), S-mode, no XIP.
# The loader copies the Image to the cached PSRAM aperture at 0x50000000.
# OpenSBI fw_jump starts it there in S-mode.  The built-in DTB describes the
# SoC.  Buildroot reads this file directly, so it is not in the kernel tree or
# the patch series.  Edit with "make kernel-menuconfig" and save with
# "make kernel-saveconfig".
CONFIG_MMU=y
# CONFIG_RISCV_M_MODE is not set
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x50000000
CONFIG_NONPORTABLE=y
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
# CONFIG_CLINT_TIMER is not set

# CONFIG_CPU_ISOLATION is not set
CONFIG_LOG_BUF_SHIFT=14
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Disable large syscalls and features.  Keep FUTEX, EPOLL, TIMERFD and
# EVENTFD: threads and event loops need them, and they are small.
# CONFIG_SYSFS_SYSCALL is not set
# CONFIG_FHANDLE is not set
# CONFIG_BASE_FULL is not set
# CONFIG_SIGNALFD is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_KALLSYMS is not set
# CONFIG_VM_EVENT_COUNTERS is not set
# CONFIG_COMPAT_BRK is not set

CONFIG_SLUB_TINY=y

# Userspace needs terminals, locks and IPC.  Dropbear, screen and network
# logins open a pty.  sqlite, vim and lease files use fcntl locks.  Inotify
# tells programs about file changes.  SysV IPC gives shared memory, message
# queues and semaphores.  With memory advice, allocators can give unused
# pages back to the kernel on this 16 MiB board.
CONFIG_UNIX98_PTYS=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_SYSVIPC=y
CONFIG_ADVISE_SYSCALLS=y

# /run and /tmp use tmpfs.  musl shared memory and named semaphores use it
# at /dev/shm.
CONFIG_TMPFS=y

# RISC-V 32-bit
CONFIG_ARCH_RV32I=y
CONFIG_SOC_ESP32S31=y

# CONFIG_SMP is not set
CONFIG_THREAD_SIZE_ORDER=2
CONFIG_RISCV_SLOW_UNALIGNED_ACCESS=y
# CONFIG_FPU is not set

# Linux and userspace use UART0 through the USB-to-UART bridge.  tty0 shows a
# copy of the kernel log on the LCD.  OpenSBI keeps its UART console for
# firmware messages.
CONFIG_CMDLINE="earlycon=sbi console=tty0 console=ttyS0,115200 rdinit=/init"
CONFIG_CMDLINE_FORCE=y

# Fewer timer calls to OpenSBI, and no periodic ticks when idle.
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_100=y

# Built-in DTB, so the loader does not copy a separate DTB.
CONFIG_BUILTIN_DTB=y
CONFIG_BUILTIN_DTB_NAME="espressif/esp32s31_generic"

# This board has no EFI firmware and no DMI.  riscv enables both by default,
# and they only log that they are absent.
# CONFIG_EFI is not set
# CONFIG_DMI is not set

# 2^16 source-port perturbation entries use 256 KiB of the 16 MiB.
CONFIG_INET_TABLE_PERTURB_ORDER=8

# Security (minimal)
# CONFIG_SECCOMP is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_GCC_PLUGINS is not set
CONFIG_LSM="[]"

# Block layer.  One card with one queue: mq-deadline is sufficient.
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_IOSCHED_BFQ is not set

# Executable format
CONFIG_BINFMT_ELF=y
# CONFIG_COREDUMP is not set

# Devtmpfs, so the kernel makes the /dev nodes.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Networking.  wlan0 is a full-MAC device: the firmware on hart 0 runs
# 802.11 and its supplicant.  Thus cfg80211 is on and mac80211 is off.
# udhcpc needs PACKET raw sockets.  INET carries the data.
CONFIG_NET=y
CONFIG_CFG80211=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y

# cfg80211 loads regulatory.db.  wireless-regdb puts it on the card.
# CONFIG_ALLOW_DEV_COREDUMP is not set

# USB HID input devices
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
CONFIG_HID=y
CONFIG_HID_GENERIC=y

# GPIO, so userspace can control pins with libgpiod.
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_ESP32S31=y

# I2C and SPI are off.  Enable them when necessary.
# CONFIG_I2C is not set
# CONFIG_SPI is not set

# USB mass storage
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y

# USB host
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_USB_HID=y
CONFIG_PHY_ESP32S31_USB=y

# Cache maintenance for DMA.  The hart has no Zicbom, so its ISA support is
# off.  It only adds DMA_DIRECT_REMAP, which cannot make an uncached mapping
# on RV32.
CONFIG_ESP32S31_CACHE=y
# CONFIG_RISCV_ISA_ZICBOM is not set

# MMC/SD card support
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y

# Network devices: only the wireless vendor class, for wlan0.
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ESPRESSIF=y
CONFIG_ESP32S31_WIFI=y
# CONFIG_ETHERNET is not set

# Frame buffer for the 800x480 RGB565 panel of the loader, with fbcon on the
# VTs.  The VT is a printk console, and the command line has console=tty0, so
# the panel shows the boot log.  Scrolling in PSRAM adds approximately one
# second to the boot.  Without the panel, remove CONFIG_VT_CONSOLE and
# console=tty0 to get that second back.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Serial / TTY
# CONFIG_SERIO is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LDISC_AUTOLOAD is not set
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_ESP32=y

# The TRNG of the SoC seeds the CRNG at boot.  Without it, getrandom() blocks
# for approximately 20 seconds while the kernel collects interrupt timing.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_ESP32S31=y
# CONFIG_DEVMEM is not set

# Virtualization I/O is off.
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VHOST_MENU is not set

# Filesystems
# CONFIG_DNOTIFY is not set
# CONFIG_MISC_FILESYSTEMS is not set
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Debug / printk
CONFIG_PRINTK_TIME=y
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_SECTION_MISMATCH_WARN_ONLY is not set
# CONFIG_FRAME_POINTER is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_MISC is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_RCU_TRACE is not set
# CONFIG_FTRACE is not set
# CONFIG_RUNTIME_TESTING_MENU is not set

CONFIG_INITRAMFS_SOURCE=""
CONFIG_DECOMPRESS_GZIP=y

# Keep the image small: no 4 MB PMD section padding.
# CONFIG_STRICT_KERNEL_RWX is not set
