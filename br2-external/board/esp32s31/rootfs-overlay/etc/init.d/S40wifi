#!/bin/sh
# SPDX-License-Identifier: MIT
# Connect to the network that "wifi <ssid> [passphrase]" saved.  Then the
# board is on the network without a console.

case "$1" in
start)
	[ -r /etc/wifi.conf ] || [ -r /mnt/sd/wifi.conf ] || exit 0
	# The association and the lease take seconds.  Nothing waits for them.
	/usr/bin/wifi --saved >/dev/null 2>&1 &
	echo "wifi: joining the saved network in the background"
	;;
stop)
	/usr/bin/wifi off >/dev/null 2>&1
	;;
esac

exit 0
