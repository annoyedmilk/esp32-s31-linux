#!/bin/sh
# SPDX-License-Identifier: MIT
# Start wpa_supplicant on wlan0.  wpa_cli runs /usr/sbin/wpa-dhcp-action
# at each connection, which starts or renews the DHCP lease.  watch_cli
# keeps wpa_cli running.
# The config is /etc/wpa_supplicant.conf, or wpa_supplicant.conf on p1 of
# the disk when it exists: that file stays after "make sdroot", which
# replaces the root.

IFACE=wlan0
CONF=/etc/wpa_supplicant.conf
. /etc/default/disk
[ -r "${DISK_MNT:+$DISK_MNT/wpa_supplicant.conf}" ] &&
	CONF=$DISK_MNT/wpa_supplicant.conf

# wpa_cli -a ends when wpa_supplicant does not answer a PING in 10 s, for
# example while the firmware restarts.  Start it again, and give it the
# connection that it did not see.
watch_cli()
{
	sup=/var/run/wpa_supplicant.$IFACE.pid
	cli=/var/run/wpa_cli.$IFACE.pid
	# wpa_supplicant -B returns before the daemon writes its pidfile.
	for _ in $(seq 1 10); do
		[ -s $sup ] && break
		sleep 1
	done
	# BusyBox kill -0 "" succeeds: test the pidfile first.
	while [ -s $sup ] && kill -0 "$(cat $sup)" 2>/dev/null; do
		if ! { [ -s $cli ] && kill -0 "$(cat $cli)" 2>/dev/null; }; then
			wpa_cli -B -i $IFACE -a /usr/sbin/wpa-dhcp-action -P $cli
			wpa_cli -i $IFACE status 2>/dev/null |
				grep -q '^wpa_state=COMPLETED' &&
				/usr/sbin/wpa-dhcp-action $IFACE CONNECTED
		fi
		sleep 5
	done
}

start_wifi()
{
	[ -d /sys/class/net/$IFACE ] || return 0
	# -s: the notes about unregistered frame types go to syslog.
	if ! wpa_supplicant -B -s -D nl80211 -i $IFACE -c "$CONF" \
		-P /var/run/wpa_supplicant.$IFACE.pid; then
		echo "wifi: wpa_supplicant did not start, see /var/log/messages"
		return 1
	fi
	watch_cli </dev/null >/dev/null 2>&1 &
	echo $! > /var/run/wpa_watch.$IFACE.pid
	echo "wifi: wpa_supplicant on $IFACE with $CONF"
}

case "$1" in
start)
	# In the background: OpenSSL loads slowly from the flash root.
	start_wifi &
	;;
stop)
	# udhcpd and the firewall entries are from ap.sh.
	for p in wpa_watch wpa_cli wpa_supplicant udhcpc udhcpd; do
		f=/var/run/$p.$IFACE.pid
		[ -r $f ] && kill "$(cat $f)" 2>/dev/null
		rm -f $f
	done
	nft flush set inet filter ap_dhcp 2>/dev/null
	nft flush set inet filter ap_route 2>/dev/null
	nft delete table ip ap-nat 2>/dev/null
	ip addr flush dev $IFACE 2>/dev/null
	;;
restart)
	"$0" stop
	sleep 1
	start_wifi
	;;
esac

exit 0
