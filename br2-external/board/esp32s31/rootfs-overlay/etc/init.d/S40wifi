#!/bin/sh
# SPDX-License-Identifier: MIT
# Rejoin the network "wifi <ssid> [passphrase]" saved, so the board comes up
# reachable without a console.

case "$1" in
start)
	[ -r /etc/wifi.conf ] || exit 0
	# Association and the lease take seconds and nothing waits on them.
	/usr/bin/wifi --saved >/dev/null 2>&1 &
	echo "wifi: joining the saved network in the background"
	;;
stop)
	/usr/bin/wifi off >/dev/null 2>&1
	;;
esac

exit 0
