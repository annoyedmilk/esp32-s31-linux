#!/bin/sh
# SPDX-License-Identifier: MIT
# p2 on the card is the root.  The initramfs mounts it.  p1 is the FAT area
# that the Mac also writes.  It is optional: never stop the boot for it.

case "$1" in
start)
	[ -b /dev/mmcblk0p1 ] || exit 0
	mkdir -p /mnt/sd
	if mount -t vfat -o rw,noatime /dev/mmcblk0p1 /mnt/sd 2>/dev/null; then
		echo "sdcard: /dev/mmcblk0p1 on /mnt/sd"
	else
		echo "sdcard: /dev/mmcblk0p1 will not mount"
	fi
	;;
stop)
	mountpoint -q /mnt/sd && umount /mnt/sd
	;;
esac

exit 0
