#!/bin/sh
# SPDX-License-Identifier: MIT
# The board has only 16 MiB of PSRAM.  Use a file, not a partition, so all
# card layouts work.  After "make sdroot", this script makes the file again.

SWAPFILE=/swapfile
WANT=65536	# KiB
KEEP=32768	# KiB left free on /
MIN=16384	# KiB, a smaller swap file is not worth the SD wear

case "$1" in
start)
	if [ -f "$SWAPFILE" ]; then
		swapon "$SWAPFILE" 2>/dev/null && echo "swap: $SWAPFILE active"
		exit 0
	fi

	size=$(($(df -k / | awk 'NR == 2 { print $4 }') - KEEP))
	[ "$size" -gt "$WANT" ] && size=$WANT
	if [ "$size" -lt "$MIN" ]; then
		echo "swap: too little space on / for a swap file"
		exit 0
	fi

	# dd takes approximately 30 seconds.  The system does not wait for it.
	echo "swap: creating $SWAPFILE ($((size / 1024))M) in the background"
	(
		# swapon does not accept holes, so the file cannot be sparse.
		if dd if=/dev/zero of="$SWAPFILE" bs=1024 count="$size" 2>/dev/null; then
			chmod 600 "$SWAPFILE"
			mkswap "$SWAPFILE" >/dev/null
			swapon "$SWAPFILE" && echo "swap: $SWAPFILE active"
		else
			rm -f "$SWAPFILE"
			echo "swap: cannot create $SWAPFILE" >&2
		fi
	) &
	;;
stop)
	swapoff "$SWAPFILE" 2>/dev/null
	;;
esac

exit 0
