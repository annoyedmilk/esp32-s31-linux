#!/bin/sh
# SPDX-License-Identifier: MIT
# Swap to LZ4-compressed RAM.  zram needs its size in sysfs, so fstab cannot
# start it.  A swap file in /etc/fstab starts earlier, from "swapon -a" in
# inittab, and the higher priority of zram puts it first.

ZRAM=/sys/block/zram0
ZRAM_SIZE=6M	# uncompressed

case "$1" in
start)
	echo lz4 > $ZRAM/comp_algorithm &&
		echo $ZRAM_SIZE > $ZRAM/disksize &&
		mkswap /dev/zram0 >/dev/null &&
		swapon -p 100 /dev/zram0 &&
		echo "swap: /dev/zram0 ($ZRAM_SIZE, lz4) active"
	;;
esac

exit 0
