#!/bin/sh
# SPDX-License-Identifier: MIT
# udhcpc hook.  There is no RTC, and S01clock.sh sets only the last known time,
# which is late.  Thus set the clock at each new lease and renewal, with the
# servers of DHCP option 42 first, then those of /etc/default/ntp.  ntpd -q
# stops after 10 s without a reply.  Instead, one ntpd without -q tries
# again by itself (at most 512 s apart), and ntp-set stops it at the first
# sync: no shell waits next to it.

case "$1" in
bound|renew) ;;
*) exit 0 ;;
esac

. /etc/default/ntp
[ "$NTP" = no ] && exit 0
# udhcpc passes the servers of option 42 in the environment.
: "${ntpsrv:=}"

pid=/var/run/ntp-sync.pid
[ -s $pid ] && kill -0 "$(cat $pid)" 2>/dev/null && exit 0

peers=
for s in $ntpsrv $NTP_SERVERS; do
	peers="$peers -p $s"
done

ntpd -n $peers -S /usr/share/udhcpc/ntp-set </dev/null >/dev/null 2>&1 &
echo $! >$pid
