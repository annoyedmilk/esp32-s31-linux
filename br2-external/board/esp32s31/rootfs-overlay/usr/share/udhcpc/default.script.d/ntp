#!/bin/sh
# SPDX-License-Identifier: MIT
# udhcpc hook.  There is no RTC, and S01clock.sh sets only the last known time,
# which is late.  Thus set the clock at each new lease.  Not at a renewal, so
# that a running board does not ask again and again.

[ "$1" = bound ] || exit 0
(
	ntpd -q -n -p pool.ntp.org >/dev/null 2>&1 &&
		date -u +'%Y-%m-%d %H:%M:%S' >/etc/timestamp
) &
