#!/bin/sh
# SPDX-License-Identifier: MIT
# udhcpc hook: BusyBox gives the lease state in $1 and the lease data in the
# environment.

case "$1" in
deconfig)
	ip addr flush dev "$interface"
	ip link set "$interface" up
	;;
bound | renew)
	# A renewal can give a different address.  Remove the old address
	# only then, so the connections stay open on a usual renewal.
	if ! ip -4 addr show dev "$interface" | grep -q "inet $ip/$mask "; then
		ip -4 addr flush dev "$interface"
		ip addr add "$ip/$mask" dev "$interface"
	fi
	ip link set "$interface" up

	for gateway in $router; do
		ip route add default via "$gateway" dev "$interface" 2>/dev/null
	done

	: >/etc/resolv.conf
	for server in $dns; do
		echo "nameserver $server" >>/etc/resolv.conf
	done

	# There is no RTC.  S01clock sets only the last known time, which is
	# late.  Thus set the clock at each new lease.  Do not do it at a
	# renewal, so a running board does not ask again and again.
	if [ "$1" = bound ]; then
		(
			ntpd -q -n -p pool.ntp.org >/dev/null 2>&1 &&
				date -u +'%Y-%m-%d %H:%M:%S' >/etc/timestamp
		) &
	fi
	;;
esac
