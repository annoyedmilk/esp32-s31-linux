#!/bin/sh
# SPDX-License-Identifier: MIT
# udhcpc hook: BusyBox calls this with the lease state in $1 and the lease
# itself in the environment.

case "$1" in
deconfig)
	ip addr flush dev "$interface"
	ip link set "$interface" up
	;;
bound | renew)
	ip addr add "$ip/$mask" dev "$interface"
	ip link set "$interface" up

	for gateway in $router; do
		ip route add default via "$gateway" dev "$interface" 2>/dev/null
	done

	: >/etc/resolv.conf
	for server in $dns; do
		echo "nameserver $server" >>/etc/resolv.conf
	done

	# One shot, and only while the clock is still implausible, so a renew
	# on a running system costs nothing.
	if [ "$(date -u +%Y)" -lt 2020 ]; then
		(
			ntpd -q -n -p pool.ntp.org >/dev/null 2>&1 &&
				date -u +'%Y-%m-%d %H:%M:%S' >/etc/timestamp
		) &
	fi
	;;
esac
