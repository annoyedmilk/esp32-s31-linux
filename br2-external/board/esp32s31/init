#!/bin/sh
# SPDX-License-Identifier: MIT
# Find the rootfs on the card and switch to it.  If there is no card, start
# a shell for recovery.

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

root=/dev/mmcblk0p2

# The dw_mmc probe, the card identification and the partition scan come later.
for _ in 1 2 3 4 5; do
	[ -b "$root" ] && break
	sleep 1
done

# There is no fsck here.  A damaged root becomes read-only and does not get
# worse.  Use e2fsprogs on the card to repair it.
if [ -b "$root" ] && mount -t ext4 -o rw,errors=remount-ro "$root" /mnt; then
	echo "initramfs: root on $root"
	# switch_root does not move mounts, and the kernel mounts devtmpfs only
	# on the first root.  Without the move, the new /dev is empty.
	for fs in dev proc sys; do
		mount -o move "/$fs" "/mnt/$fs" || echo "initramfs: cannot move /$fs"
	done
	exec switch_root /mnt /sbin/init
fi

if [ -b "$root" ]; then
	echo "initramfs: $root will not mount as ext4"
else
	echo "initramfs: no $root -- is the card inserted and partitioned?"
fi

exec /bin/sh -i
