#!/bin/sh
# SPDX-License-Identifier: MIT
# udhcpc hook: the default route of wlan0 gets metric 10, so Ethernet wins.

# udhcpc passes these in the environment.
: "${interface:=}" "${router:=}"
[ "$interface" = wlan0 ] || exit 0
case "$1" in
bound|renew)
	for gw in $router; do
		ip route del default via "$gw" dev wlan0 metric 0 2>/dev/null
		ip route replace default via "$gw" dev wlan0 metric 10
	done
	;;
esac
