# No RTC: the udhcpc hook sets the clock with a one-shot ntpd client.
CONFIG_NTPD=y
# CONFIG_FEATURE_NTPD_SERVER is not set
# CONFIG_FEATURE_NTPD_CONF is not set

# Buildroot gives no pidfile directory, so crond puts crond.reboot into /.
# There the file stays, on the disk or in the flash, and @reboot jobs run
# only at the first boot.  /var/run is tmpfs.
CONFIG_PID_FILE_PATH="/var/run"

# S05swap.sh gives zram a higher priority than the swap on the disk.
CONFIG_FEATURE_SWAPON_PRI=y

# nc to test sockets.
CONFIG_NC=y
CONFIG_NC_SERVER=y
CONFIG_NC_EXTRA=y

# A web server to start by hand, with CGI for the example.  With CGI and
# without BASIC_AUTH, BusyBox 1.38 gives 404 for a directory URL: it cuts
# index.html from the path and does not put it back.
CONFIG_HTTPD=y
CONFIG_FEATURE_HTTPD_CGI=y
CONFIG_FEATURE_HTTPD_BASIC_AUTH=y
